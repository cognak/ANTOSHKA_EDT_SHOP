&НаКлиентеНаСервереБезКонтекста
Процедура Оп_CALLLOC(ВМВызоваЛок, СтекВызоваЛок, КомандаВызоваЛок )

	ДанныеПодпрограммы = ВМВызоваЛок.Подпрограммы[КомандаВызоваЛок.Аргумент];
	ТипПодпрограммы = ДанныеПодпрограммы.Флаг;
	Если ТипПодпрограммы = 33 Тогда

		ВызватьПодпрограмму(ВМВызоваЛок, СтекВызоваЛок, КомандаВызоваЛок, Истина);
		ВМВызоваЛок.ТекущаяКоманда = ВМВызоваЛок.ТекущаяКоманда + 1;
	ИначеЕсли ТипПодпрограммы = 32 Тогда

		ВызватьПодпрограмму(ВМВызоваЛок, СтекВызоваЛок, КомандаВызоваЛок, Ложь);
		ВМВызоваЛок.ТекущаяКоманда = ВМВызоваЛок.ТекущаяКоманда + 1;
	Иначе

		УникальныйИдентВызова = Новый УникальныйИдентификатор;
		Структура = Новый Структура("Имя,Переменные,ЭтоФункция,ТочкаВызова,ИдентификаторВызова", ДанныеПодпрограммы.Имя, Новый Массив, ?(ТипПодпрограммы = 1 ИЛИ ТипПодпрограммы = 17, Истина, Ложь), ВМВызоваЛок.ТекущаяКоманда, УникальныйИдентВызова);
		ЧислоПараметровПодпрогр = ДанныеПодпрограммы.ЧислоАргументов;
		КоличествоАргументов = ВМВызоваЛок.КоличествоАргументов;
		МассивЛокальныхПеременных = Структура.Переменные;
		МассивПеременныхПодпрогр = ДанныеПодпрограммы.Переменные;
		ВсегоПеременныхПодпрогр = МассивПеременныхПодпрогр.Количество();
		Индекс = 0;
		ЕстьРодительскаяВМ = ВМВызоваЛок.ИсходнаяВМ <> Неопределено;
		ЦелеваяВМ = ?(ЕстьРодительскаяВМ, КонтекстВложенного(ВМВызоваЛок.ОсновнаяВМ, ВМВызоваЛок), ВМВызоваЛок);
		Пока Индекс < ЧислоПараметровПодпрогр Цикл
			ТекОпрПеременной = МассивПеременныхПодпрогр[Индекс];
			Структура2 = Новый Структура("ВМ,Имя,Флаг,Значение,Адрес,ИдентификаторВызова,ЗначениеПредСвойства,ИмяСвойства");
			ЗаполнитьЗначенияСвойств(Структура2, ТекОпрПеременной);
			Структура2.Вставить("Инициализирована", Истина);
			Если Индекс < КоличествоАргументов Тогда

				ЗначениеАргумента = СтекВызоваЛок[КоличествоАргументов - Индекс - 1];
				Если ЗначениеАргумента.Свойство("ЭтоПустоеЗначение") Тогда

					Структура2.Значение = ТекОпрПеременной.ЗначениеПоУмолчанию;
					Структура2.ИдентификаторВызова = УникальныйИдентВызова;
					Структура2.Адрес = Индекс;
				Иначе
					Если Структура2.Флаг = 13 Тогда

						Структура2.Значение = ЗначениеАргумента.Значение;
						Структура2.ИдентификаторВызова = УникальныйИдентВызова;
						Структура2.Адрес = Индекс ;
					Иначе
						Если ЗначениеАргумента.Свойство("Адрес") Тогда

							Структура2.ИдентификаторВызова = ЗначениеАргумента.ИсходныйИдентификаторВызова;
							Структура2.Адрес = ЗначениеАргумента.Адрес;
							Структура2.ЗначениеПредСвойства = ЗначениеАргумента.ЗначениеПредСвойства;
							Структура2.ИмяСвойства = ЗначениеАргумента.ИмяСвойства;
							ЗначениеИзКонтекста = ВМВызоваЛок.ТекущийКонтекст[ВРег(ЗначениеАргумента.Имя)];
							Структура2.ВМ = ?(ЗначениеИзКонтекста = Неопределено, Неопределено, ЗначениеИзКонтекста.ВМ);
						Иначе

							Структура2.Значение = ЗначениеАргумента.Значение;
							Структура2.ИдентификаторВызова = УникальныйИдентВызова;
							Структура2.Адрес = Индекс;
						КонецЕсли;

					КонецЕсли;

				КонецЕсли ;

			Иначе
				Если ТекОпрПеременной.ЗначениеПоУмолчаниюСуществует Тогда

					Структура2.Значение = ТекОпрПеременной.ЗначениеПоУмолчанию;
					Структура2.ИдентификаторВызова = УникальныйИдентВызова ;
					Структура2.Адрес = Индекс;
				Иначе
					ВызватьИсключение НСтр("ru='Недостаточно фактических параметров (';en='Not enough actual parameters ('", ТекущийЯзыкСистемы()) + ДанныеПодпрограммы.Имя + ")";
				КонецЕсли;

			КонецЕсли;

			МассивЛокальныхПеременных.Добавить(Структура2);
			Индекс = Индекс + 1;
		КонецЦикла;

		Пока Индекс < ВсегоПеременныхПодпрогр Цикл
			ТекОпрПеременной = МассивПеременныхПодпрогр[Индекс];
			Структура2 = Новый Структура("ВМ,Инициализирована,Имя,Флаг,Значение,Адрес,ИдентификаторВызова,ЗначениеПредСвойства,ИмяСвойства" );
			ЗаполнитьЗначенияСвойств(Структура2, ТекОпрПеременной);
			ФлагТипаПеременной = Структура2.Флаг;
			Если ФлагТипаПеременной = 1 Тогда

				Структура2.Адрес = Индекс;
				Структура2.ИдентификаторВызова = УникальныйИдентВызова;
			ИначеЕсли ФлагТипаПеременной = 0 ИЛИ ФлагТипаПеременной = 16 Тогда

				Структура2.Адрес = ВМВызоваЛок.КлючиПеременныхМодуля[ВРег(Структура2.Имя)];
				Структура2.ИдентификаторВызова = Неопределено;
				Структура2.ВМ = ?(ЕстьРодительскаяВМ , ВМВызоваЛок.ОсновнаяВМ, Неопределено);
			КонецЕсли;

			МассивЛокальныхПеременных.Добавить(Структура2);
			Индекс = Индекс + 1;
		КонецЦикла;

		Индекс = 0;
		Пока Индекс < КоличествоАргументов Цикл
			СтекВызоваЛок.Удалить(0);
			Индекс = Индекс + 1;
		КонецЦикла;

		ЦелеваяВМ.СтекВызовов.Вставить(0, Структура);
		ЦелеваяВМ.КлючиПеременных.Вставить(УникальныйИдентВызова, Структура.Переменные);
		ЦелеваяВМ.ТекущаяКоманда = ДанныеПодпрограммы.ТочкаВхода;
		ЦелеваяВМ.РезультатФункции.Значение = Неопределено;
		ЦелеваяВМ.ИдентификаторВызова = УникальныйИдентВызова;
		Если ЕстьРодительскаяВМ Тогда

			ВМВызоваЛок.РезультатФункции.Значение = Неопределено;
			ЦелеваяВМ.РезультатФункции = ВМВызоваЛок.РезультатФункции;
			ПродолжитьИсполнение(ЦелеваяВМ, Неопределено , ВМВызоваЛок.ОстановкаПоОшибке, Новый Соответствие);
			ВМВызоваЛок.ТекущаяКоманда = ВМВызоваЛок.ТекущаяКоманда + 1;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

