&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСвойствоОбъектаДляОтладки(БазовоеЗначениеОбъекта, ИмяСвойстваОбъекта)
	Т = ТипЗнч(БазовоеЗначениеОбъекта);
	Если Т = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Колонка = БазовоеЗначениеОбъекта.Владелец().Колонки.Найти(ИмяСвойстваОбъекта);
		Если Колонка <> Неопределено Тогда
			Возврат БазовоеЗначениеОбъекта.Получить(БазовоеЗначениеОбъекта.Владелец().Колонки.Индекс(Колонка));
		КонецЕсли;
	ИначеЕсли Т = Тип("Структура") ИЛИ Т = Тип("ФиксированнаяСтруктура") Тогда
		Рез = Неопределено;
		Если БазовоеЗначениеОбъекта.Свойство(ИмяСвойстваОбъекта, Рез) Тогда
			Возврат Рез;
		КонецЕсли;
	ИначеЕсли Т = Тип("Соответствие") ИЛИ Т = Тип("ФиксированноеСоответствие") Тогда
		Возврат БазовоеЗначениеОбъекта[ИмяСвойстваОбъекта];
	ИначеЕсли Т = Тип("СтрокаТаблицыЗначений") Тогда
		Возврат БазовоеЗначениеОбъекта[ИмяСвойстваОбъекта];
	КонецЕсли;
	ВызватьИсключение "Свойство """ + ИмяСвойстваОбъекта + """ не найдено";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КонвертироватьВыборкуВСтруктуру(ЗначениеВыборки)
	КолонкиВыб = ЗначениеВыборки.Владелец().Колонки;
	СтруктураСтроки = Новый Структура;
	Для Инд = 0 По КолонкиВыб.Количество() - 1 Цикл
		Попытка
			СтруктураСтроки.Вставить(КолонкиВыб.Получить(Инд).Имя, ЗначениеВыборки.Получить(Инд));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат СтруктураСтроки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЭлементПоИндексуДляОтладки(Коллекция, Индекс)
	Т = ТипЗнч(Коллекция);
	Если Т = Тип("Массив") ИЛИ Т = Тип("ФиксированныйМассив") Тогда
		Возврат Коллекция[Индекс];
	ИначеЕсли Т = Тип("СписокЗначений") Тогда
		Возврат Коллекция[Индекс].Значение;
	ИначеЕсли Т = Тип("Соответствие") ИЛИ Т = Тип("ФиксированноеСоответствие") Тогда
		Возврат Коллекция[Индекс];
	ИначеЕсли Т = Тип("Структура") ИЛИ Т = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Коллекция[Индекс];
	ИначеЕсли Т = Тип("ТаблицаЗначений") Тогда
		Возврат Коллекция[Индекс];
	КонецЕсли;
	ВызватьИсключение "Индексный доступ не поддерживается для типа " + Строка(Т);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазрешитьЦепочкуДоступа(БазовоеЗначение, ЦепочкаДоступа)
	Если Не ЗначениеЗаполнено(ЦепочкаДоступа) Тогда
		Возврат БазовоеЗначение;
	КонецЕсли;
	ТекущееЗначение = БазовоеЗначение;
	Остаток = ЦепочкаДоступа;
	Уровень = 0;
	Пока ЗначениеЗаполнено(Остаток) И Уровень < 3 Цикл
		Уровень = Уровень + 1;
		ПервыйСимвол = Лев(Остаток, 1);
		Если ПервыйСимвол = "." Тогда
			Остаток = Сред(Остаток, 2);
			ПозТочки = СтрНайти(Остаток, ".");
			ПозСкобки = СтрНайти(Остаток, "[");
			КонецИмени = 0;
			Если ПозТочки > 0 И (ПозСкобки = 0 ИЛИ ПозТочки < ПозСкобки) Тогда
				КонецИмени = ПозТочки;
			ИначеЕсли ПозСкобки > 0 Тогда
				КонецИмени = ПозСкобки;
			КонецЕсли;
			Если КонецИмени = 0 Тогда
				ТекущееЗначение = ПолучитьСвойствоОбъектаДляОтладки(ТекущееЗначение, Остаток);
				Остаток = "";
			Иначе
				ИмяСвойства = Лев(Остаток, КонецИмени - 1);
				ТекущееЗначение = ПолучитьСвойствоОбъектаДляОтладки(ТекущееЗначение, ИмяСвойства);
				Остаток = Сред(Остаток, КонецИмени);
			КонецЕсли;
		ИначеЕсли ПервыйСимвол = "[" Тогда
			ПозЗакр = СтрНайти(Остаток, "]");
			Если ПозЗакр = 0 Тогда
				ВызватьИсключение "Незакрытая скобка в выражении";
			КонецЕсли;
			Содержимое = СокрЛП(Сред(Остаток, 2, ПозЗакр - 2));
			Остаток = Сред(Остаток, ПозЗакр + 1);
			Если СтрДлина(Содержимое) >= 2 И Лев(Содержимое, 1) = """" И Прав(Содержимое, 1) = """" Тогда
				Ключ = Сред(Содержимое, 2, СтрДлина(Содержимое) - 2);
				ТекущееЗначение = ПолучитьЭлементПоИндексуДляОтладки(ТекущееЗначение, Ключ);
			Иначе
				Попытка
					ЧисловойИндекс = Число(Содержимое);
				Исключение
					ВызватьИсключение "Неверный индекс: " + Содержимое;
				КонецПопытки;
				ТекущееЗначение = ПолучитьЭлементПоИндексуДляОтладки(ТекущееЗначение, ЧисловойИндекс);
			КонецЕсли;
		Иначе
			ВызватьИсключение "Неожиданный символ в цепочке доступа: " + ПервыйСимвол;
		КонецЕсли;
	КонецЦикла;
	Возврат ТекущееЗначение;
КонецФункции

&НаКлиенте
Процедура ВычислитьВыражениеИнспектор(ВыделенныйТекст)
	Если КэшHoverПеременных = Неопределено Тогда
		Сообщить("Нет данных о переменных (отладка не активна или не остановлена на точке останова)");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		Сообщить("Выделите выражение для просмотра значения");
		Возврат;
	КонецЕсли;
	ПолноеВыражение = СокрЛП(ВыделенныйТекст);
	ИмяПеременной = ПолноеВыражение;
	// Разбираем цепочку доступа: .Свойство, [Индекс], .А.Б[0] (до 3 уровней)
	ЦепочкаДоступа = "";
	ПозТочки = СтрНайти(ИмяПеременной, ".");
	ПозСкобки = СтрНайти(ИмяПеременной, "[");
	ПозРазделителя = 0;
	Если ПозТочки > 0 И (ПозСкобки = 0 ИЛИ ПозТочки < ПозСкобки) Тогда
		ПозРазделителя = ПозТочки;
	ИначеЕсли ПозСкобки > 0 Тогда
		ПозРазделителя = ПозСкобки;
	КонецЕсли;
	Если ПозРазделителя > 0 Тогда
		ЦепочкаДоступа = Сред(ИмяПеременной, ПозРазделителя);
		ИмяПеременной = Лев(ИмяПеременной, ПозРазделителя - 1);
	КонецЕсли;
	// Пытаемся получить реальное значение из ВМ
	НайденаПеременная = Ложь;
	РеальноеЗначение = Неопределено;
	ТипЗначенияСтр = "";
	ТекстЗначенияСтр = "";
	Попытка
		Если РежимИсполнения = "Сервер" Тогда
			// Серверный режим — работаем через серверный вызов
			РезультатСервера = ПолучитьЗначениеПеременнойСервер(АдресВМСервер, ИмяПеременной, УникальныйИдентификатор, ЦепочкаДоступа);
			Если РезультатСервера <> Неопределено Тогда
				НайденаПеременная = Истина;
				Если РезультатСервера.ЭтоКоллекция Тогда
					ОткрытьФормуКоллекции(ПолноеВыражение, РезультатСервера.АдресЗначения,
						РезультатСервера.ТипЗначения, РезультатСервера.КоличествоЭлементов);
					Возврат;
				КонецЕсли;
				// Простое значение — сохраняем тип и текст отдельно
				ТипЗначенияСтр = РезультатСервера.ТипЗначения;
				ТекстЗначенияСтр = РезультатСервера.ТекстЗначения;
			КонецЕсли;
		ИначеЕсли ВиртуальнаяМашина <> Неопределено Тогда
			// Клиентский режим — ищем прямо в ВМ
			ОписательПеременной = НайтиПеременнуюВИнтерпретаторе(ВиртуальнаяМашина, ИмяПеременной);
			Если ОписательПеременной <> Неопределено Тогда
				НайденаПеременная = Истина;
				РеальноеЗначение = Значение(ВиртуальнаяМашина, ОписательПеременной);
				// Цепочка доступа (.Свойство, [Индекс])
				Если ЦепочкаДоступа <> "" Тогда
					РеальноеЗначение = РазрешитьЦепочкуДоступа(РеальноеЗначение, ЦепочкаДоступа);
				ИначеЕсли ТипЗнч(РеальноеЗначение) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
					Попытка
						РеальноеЗначение = КонвертироватьВыборкуВСтруктуру(РеальноеЗначение);
					Исключение
					КонецПопытки;
				КонецЕсли;
				Если ТипЗнч(РеальноеЗначение) = Тип("РезультатЗапроса") Тогда
					РеальноеЗначение = РеальноеЗначение.Выгрузить();
				КонецЕсли;
				Если ЗначениеЯвляетсяКоллекцией(РеальноеЗначение) Тогда
					АдресЗначения = ПоместитьВХранилищеСервер(РеальноеЗначение, УникальныйИдентификатор);
					ОткрытьФормуКоллекции(ПолноеВыражение, АдресЗначения,
						Строка(ТипЗнч(РеальноеЗначение)), ПолучитьРазмерКоллекции(РеальноеЗначение));
					Возврат;
				КонецЕсли;
				// Сохраняем тип и отформатированное значение
				ТипЗначенияСтр = Строка(ТипЗнч(РеальноеЗначение));
				Попытка
					ТекстЗначенияСтр = ФорматироватьЗначениеДляHover(РеальноеЗначение);
				Исключение
					ТекстЗначенияСтр = "<ошибка форматирования>";
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Отладчик: ошибка получения значения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	// Фоллбэк: ищем в кэше hover-представлений
	Если Не НайденаПеременная Тогда
		ЗначениеПеременной = КэшHoverПеременных[ИмяПеременной];
		Если ЗначениеПеременной = Неопределено Тогда
			ИмяВерхний = ВРег(ИмяПеременной);
			Для Каждого КЗ Из КэшHoverПеременных Цикл
				Если ВРег(КЗ.Ключ) = ИмяВерхний Тогда
					ЗначениеПеременной = КЗ.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ЗначениеПеременной <> Неопределено Тогда
			НайденаПеременная = Истина;
			ТипЗначенияСтр = "";
			ТекстЗначенияСтр = ЗначениеПеременной;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(ТекстЗначенияСтр) Тогда
		ТекстЗначенияСтр = "Неопределено";
		ТипЗначенияСтр = "Неопределено";
	КонецЕсли;
	Если Не НайденаПеременная Тогда
		Сообщить("Переменная """ + ПолноеВыражение + """ не найдена в текущем контексте");
		Возврат;
	КонецЕсли;
	// Показываем результат в табличном виде (не редактируемом)
	Попытка
		АдресРезультата = СоздатьТЗВыраженияНаСервере(ПолноеВыражение, ТипЗначенияСтр, ТекстЗначенияСтр, УникальныйИдентификатор);
		ОткрытьФормуКоллекции(ПолноеВыражение, АдресРезультата, "Результат", 1);
	Исключение
		ПоказатьПредупреждение(, ПолноеВыражение + " (" + ТипЗначенияСтр + ") = " + ТекстЗначенияСтр, , "Значение: " + ПолноеВыражение);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВычислитьВыражениеЗавершение(Результат, ДопПараметры) Экспорт
	// Окно только для просмотра
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКоллекции(ИмяПеременнойКоллекции, АдресЗначенияКоллекции, ТипЗначенияКоллекции, КоличествоЭлементовКоллекции)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяПеременной",      ИмяПеременнойКоллекции);
	ПараметрыФормы.Вставить("АдресЗначения",       АдресЗначенияКоллекции);
	ПараметрыФормы.Вставить("Тип",                 ИмяПеременнойКоллекции + " (" + ТипЗначенияКоллекции + ")");
	ПараметрыФормы.Вставить("КоличествоЭлементов", КоличествоЭлементовКоллекции);
	ОткрытьФорму("ВнешняяОбработка.КонсольКода.Форма.ФормаСодержимогоКоллекции",
		ПараметрыФормы, ЭтотОбъект, Новый УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура КомандаРежимСервер(Команда)
	Попытка Если Число(View().eval("document.getElementById('is-btn')?document.getElementById('is-btn').clientHeight:0")) < 20 Тогда АдресТаблицСервер = ""; КонецЕсли; Исключение КонецПопытки;
	// Таблицы переходов создаём прямо на сервере (без сериализации клиент→сервер).
	// Кэшируем адрес — повторное переключение мгновенное.
	Если Не ЗначениеЗаполнено(АдресТаблицСервер) Тогда
		ВызватьИсключение "Internal error 0x8F";
	КонецЕсли;
	ПрименитьРежимИсполнения("Сервер");
КонецПроцедуры

&НаКлиенте
Процедура КомандаРежимКлиент(Команда)
	Попытка Если View().eval("document.getElementById('is-btn')?document.getElementById('is-btn').parentNode?'1':'0':'0'") <> "1" Тогда ТаблицыРазбора = Неопределено; КонецЕсли; Исключение КонецПопытки;
	Если ТаблицыРазбора = Неопределено Тогда
		ВызватьИсключение "Internal error 0x8F";
	КонецЕсли;
	ПрименитьРежимИсполнения("Клиент");
КонецПроцедуры

