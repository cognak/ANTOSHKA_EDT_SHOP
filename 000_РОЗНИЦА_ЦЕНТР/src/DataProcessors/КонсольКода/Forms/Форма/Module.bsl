					ПоместитьВоВременноеХранилище(ВМСброса, АдресВМСброса );
				Иначе

					ДанныеКонтекстаСброса = АдресКонтекстаСброса;
					ДанныеКонтекстаСброса.Вставить("Переменные", Новый Соответствие);
				КонецЕсли;

			КонецПроцедуры

