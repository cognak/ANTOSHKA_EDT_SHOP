&НаКлиентеНаСервереБезКонтекста
Процедура Оп_ASSIGN(ВМПрисваивания, СтекПрисваивания, КомандаПрисваивания)

	ЦельПрисваивания = СтекПрисваивания[1];
	ФлагЦелиПрисвоения = ЦельПрисваивания.Флаг;
	Если ФлагЦелиПрисвоения <> 99 Тогда
		ЗаписатьПеременную(ВМПрисваивания, СтекПрисваивания , ЦельПрисваивания, ФлагЦелиПрисвоения, СтекПрисваивания[0].Значение)
	Иначе

		СтекВременныхПеременных = ВМПрисваивания.СтекВременныхПеременных[0];
		СтекВременныхПеременных.Значение = СтекПрисваивания[0].Значение;
	КонецЕсли;

	СтекПрисваивания.Удалить(0);
	СтекПрисваивания.Удалить(0);
	ВМПрисваивания.ТекущаяКоманда = ВМПрисваивания.ТекущаяКоманда + 1;

