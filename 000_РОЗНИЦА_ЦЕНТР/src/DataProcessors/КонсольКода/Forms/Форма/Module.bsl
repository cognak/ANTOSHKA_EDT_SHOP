				ВМСброса.ОсновнаяВМ = Неопределено;
				ВМСброса. ОстановленоПоОшибке = Ложь;
				ВМСброса.ОписаниеОшибки = Неопределено;
				Если ТипЗнч(АдресВМСброса) = Тип("Строка") Тогда

					ДанныеКонтекстаСброса = ПолучитьИзВременногоХранилища(АдресКонтекстаСброса );
					ДанныеКонтекстаСброса.Вставить("Переменные", Новый Соответствие);
