Функция ПредставлениеЗначения(ВМДляФорматирования, ПеременнаяДляОтображения)

	ВычисленноеЗначение = Значение(ВМДляФорматирования, ПеременнаяДляОтображения);
	СтроковоеПредставлениеЗначения = "";
	МаксДлинаОтображения = 50;
	Если ТипЗнч(ВычисленноеЗначение) = Тип("Булево") Тогда
		Если ВМДляФорматирования.ВариантВстроенногоЯзыка = "ru" Тогда
			СтроковоеПредставлениеЗначения = Формат(ВычисленноеЗначение , "БЛ=Ложь; БИ=Истина");
		Иначе
			СтроковоеПредставлениеЗначения = Формат(ВычисленноеЗначение, "BF=False; BT=True");
		КонецЕсли;

	ИначеЕсли ТипЗнч(ВычисленноеЗначение) = Тип("Строка") Тогда
		СтроковоеПредставлениеЗначения = """" + ОбрезатьСтроку(ВычисленноеЗначение, МаксДлинаОтображения) + """";
	Иначе
		СтроковоеПредставлениеЗначения = ОбрезатьСтроку(БезопасноеПредставление(ВычисленноеЗначение ), МаксДлинаОтображения);
	КонецЕсли;

	Возврат СтроковоеПредставлениеЗначения;

КонецФункции

