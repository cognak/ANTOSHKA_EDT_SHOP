КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСостояниеИнтерпретатора(АдресВМСостояния)

	Если ТипЗнч(АдресВМСостояния) = Тип("Строка") Тогда
		ОтладкаЗавершена = ПолучитьИзВременногоХранилища(АдресВМСостояния);
	Иначе
		ОтладкаЗавершена = АдресВМСостояния;
	КонецЕсли;

	ПредставлениеОтладки = Новый Структура;
	ПредставлениеОтладки.Вставить("ОтладкаЗавершена", ОтладкаЗавершена.ОтладкаЗавершена);
	ПредставлениеОтладки.Вставить("СтрокаТочкиОстанова", ОтладкаЗавершена.НомерСтрокиОстанова);
	ПредставлениеОтладки.Вставить("ТекущаяКоманда", ОтладкаЗавершена.ТекущаяКоманда);
	ПредставлениеОтладки.Вставить("КоличествоАргументов" , ОтладкаЗавершена.КоличествоАргументов);
	ПредставлениеОтладки.Вставить("Ошибки", ОтладкаЗавершена.Ошибки);
	ПредставлениеСтека = Новый Массив;
	Для Каждого ТекЭлемент Из ОтладкаЗавершена.Стек Цикл
		ПредставлениеСтека.Добавить(БезопасноеПредставление(ТекЭлемент.Значение));
	КонецЦикла;

	ПредставлениеОтладки.Вставить("ПредставлениеСтека", ПредставлениеСтека );
	ПредставлениеПеременных = Новый Соответствие;
	Для Каждого ТекПеременнаяОтладки Из ОтладкаЗавершена.Переменные Цикл
		Если ТекПеременнаяОтладки.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяОтладки.Имя, "0") Тогда
			Попытка
				ПредставлениеПеременных.Вставить(ТекПеременнаяОтладки.Имя, РасширенноеПредставление(ОтладкаЗавершена, ТекПеременнаяОтладки, 0));
			Исключение
				ПредставлениеПеременных.Вставить(ТекПеременнаяОтладки.Имя, Строка(ТипЗнч(Значение(ОтладкаЗавершена, ТекПеременнаяОтладки))));
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	// Локальные переменные текущего фрейма стека вызовов
	Если ОтладкаЗавершена.СтекВызовов.Количество() > 0 Тогда
		Для Каждого ТекПеременнаяОтладки Из ОтладкаЗавершена.СтекВызовов[0].Переменные Цикл
			Если ТекПеременнаяОтладки.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяОтладки.Имя, "0") Тогда
				Попытка
					ПредставлениеПеременных.Вставить(ТекПеременнаяОтладки.Имя, РасширенноеПредставление(ОтладкаЗавершена, ТекПеременнаяОтладки, 0));
				Исключение
					ПредставлениеПеременных.Вставить(ТекПеременнаяОтладки.Имя, Строка(ТипЗнч(Значение(ОтладкаЗавершена, ТекПеременнаяОтладки))));
				КонецПопытки;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	// Расширяем hover: добавляем свойства/колонки переменных для точечной навигации
	РасширениеHover = Новый Соответствие;
	Для Каждого ТекПерем Из ОтладкаЗавершена.Переменные Цикл
		Если НЕ ТекПерем.Инициализирована ИЛИ СтрНачинаетсяС(ТекПерем.Имя, "0") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначПерем = Значение(ОтладкаЗавершена, ТекПерем);
			РаскрытьСвойстваДляHover(ЗначПерем, ТекПерем.Имя, РасширениеHover, ОтладкаЗавершена.ВариантВстроенногоЯзыка);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если ОтладкаЗавершена.СтекВызовов.Количество() > 0 Тогда
		Для Каждого ТекПерем Из ОтладкаЗавершена.СтекВызовов[0].Переменные Цикл
			Если НЕ ТекПерем.Инициализирована ИЛИ СтрНачинаетсяС(ТекПерем.Имя, "0") Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ЗначПерем = Значение(ОтладкаЗавершена, ТекПерем);
				РаскрытьСвойстваДляHover(ЗначПерем, ТекПерем.Имя, РасширениеHover, ОтладкаЗавершена.ВариантВстроенногоЯзыка);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Для Каждого КЗРасш Из РасширениеHover Цикл
		ТекстHover = СтрСоединить(КЗРасш.Значение, Символы.ПС);
		Существующее = ПредставлениеПеременных[КЗРасш.Ключ];
		Если Существующее <> Неопределено Тогда
			ПредставлениеПеременных.Вставить(КЗРасш.Ключ, Существующее + Символы.ПС + "---" + Символы.ПС + ТекстHover);
		Иначе
			ПредставлениеПеременных.Вставить(КЗРасш.Ключ, ТекстHover);
		КонецЕсли;
	КонецЦикла;

	ПредставлениеОтладки.Вставить("ПредставлениеПеременных", ПредставлениеПеременных);
	ПредставлениеСтека(ОтладкаЗавершена, ПредставлениеОтладки);
	Возврат ПредставлениеОтладки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РаскрытьСвойстваДляHover(ЗначПерем, ИмяПерем, РасширениеHover, ВариантЯзыка)
	Если ЗначПерем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Т = ТипЗнч(ЗначПерем);
	Если Т = Тип("Структура") ИЛИ Т = Тип("ФиксированнаяСтруктура") Тогда
		Для Каждого КЗ Из ЗначПерем Цикл
			Попытка
				ТекстЗнач = ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, 0, 5);
				ДобавитьВРасширениеHover(РасширениеHover, КЗ.Ключ, ИмяПерем + "." + КЗ.Ключ + " = " + ТекстЗнач);
				// Вложенный уровень: если значение — тоже структура
				Если ТипЗнч(КЗ.Значение) = Тип("Структура") Тогда
					Для Каждого КЗ2 Из КЗ.Значение Цикл
						Попытка
							ТекстЗнач2 = ФорматироватьЗначениеРекурсивно(КЗ2.Значение, ВариантЯзыка, 0, 5);
							ДобавитьВРасширениеHover(РасширениеHover, КЗ2.Ключ, ИмяПерем + "." + КЗ.Ключ + "." + КЗ2.Ключ + " = " + ТекстЗнач2);
						Исключение
						КонецПопытки;
					КонецЦикла;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	ИначеЕсли Т = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Попытка
			КолонкиВыб = ЗначПерем.Владелец().Колонки;
			КолКол = КолонкиВыб.Количество();
			Для Инд = 0 По КолКол - 1 Цикл
				Попытка
					ИмяКол = КолонкиВыб.Получить(Инд).Имя;
					ЗначКол = ЗначПерем.Получить(Инд);
					ТекстЗнач = ФорматироватьЗначениеРекурсивно(ЗначКол, ВариантЯзыка, 0, 5);
					ДобавитьВРасширениеHover(РасширениеHover, ИмяКол, ИмяПерем + "." + ИмяКол + " = " + ТекстЗнач);
				Исключение
				КонецПопытки;
			КонецЦикла;
		Исключение
		КонецПопытки;
	ИначеЕсли Т = Тип("Соответствие") ИЛИ Т = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из ЗначПерем Цикл
			Если ТипЗнч(КЗ.Ключ) = Тип("Строка") Тогда
				Попытка
					ТекстЗнач = ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, 0, 5);
					ДобавитьВРасширениеHover(РасширениеHover, КЗ.Ключ, ИмяПерем + "[""" + КЗ.Ключ + """] = " + ТекстЗнач);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВРасширениеHover(РасширениеHover, ИмяСвойства, Описание)
	Существующие = РасширениеHover[ИмяСвойства];
	Если Существующие = Неопределено Тогда
		Существующие = Новый Массив;
		РасширениеHover.Вставить(ИмяСвойства, Существующие);
	КонецЕсли;
	Существующие.Добавить(Описание);
КонецПроцедуры


