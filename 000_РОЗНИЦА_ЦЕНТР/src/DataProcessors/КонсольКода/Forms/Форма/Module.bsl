Функция ТокеныДирективы(Знач ТекСимвол2 )

	МассивТокеновДирективы = Новый Массив;
	Индекс6 = 1;
	НакопленныйТокен = "";
	ТекСимвол2 = Сред(СокрЛП(ТекСимвол2), 2);
	Пока Индекс6 <= СтрДлина(ТекСимвол2) Цикл
		ТекСимвол3 = Сред(ТекСимвол2, Индекс6, 1);
		Если ТекСимвол3 = " " Тогда
			Если ЗначениеЗаполнено(НакопленныйТокен ) Тогда

				МассивТокеновДирективы.Добавить(ВРег(НакопленныйТокен));
				НакопленныйТокен = "";
			КонецЕсли;

		ИначеЕсли ТекСимвол3 = "(" ИЛИ ТекСимвол3 = ")" Тогда

			Если ЗначениеЗаполнено(НакопленныйТокен) Тогда

				МассивТокеновДирективы.Добавить(ВРег(НакопленныйТокен));
				НакопленныйТокен = "";
			КонецЕсли;

			МассивТокеновДирективы.Добавить(ТекСимвол3 );
		Иначе
			НакопленныйТокен = НакопленныйТокен + ТекСимвол3;
		КонецЕсли;

		Индекс6 = Индекс6 + 1;
	КонецЦикла;

	Если ЗначениеЗаполнено(НакопленныйТокен ) Тогда
		МассивТокеновДирективы.Добавить(ВРег(НакопленныйТокен));
	КонецЕсли;

	Возврат МассивТокеновДирективы;

