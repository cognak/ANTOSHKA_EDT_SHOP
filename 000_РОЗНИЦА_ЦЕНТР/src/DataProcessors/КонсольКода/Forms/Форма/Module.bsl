Функция Оп_LINENUM(ВМНомерСтроки, СтекНомерСтроки, КомандаНомерСтроки, КартаТочекОстанова, ОбработчикОстановаНС, АдресОтладкиНС)

	ВМНомерСтроки.НомерСтрокиОстанова = КомандаНомерСтроки.Аргумент;

	// Step Over (F10): пропустить остановку если мы внутри вызванной подпрограммы
	// или на исходной строке (компилятор генерирует дубликат LINENUM после CALLLOC+LDRET)
	Если ВМНомерСтроки.ГлубинаШагаЧерез <> Неопределено Тогда
		Если ВМНомерСтроки.СтекВызовов.Количество() > ВМНомерСтроки.ГлубинаШагаЧерез Тогда
			Возврат Ложь;
		КонецЕсли;
		Если КомандаНомерСтроки.Аргумент = ВМНомерСтроки.СтрокаШагаЧерез Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Если КартаТочекОстанова[КомандаНомерСтроки.Аргумент] <> Неопределено Тогда
		Результат = ОбновитьПеременныеКонтекста(ВМНомерСтроки, АдресОтладкиНС, ОбработчикОстановаНС );
		Если Результат Тогда
			ВМНомерСтроки.ГлубинаШагаЧерез = Неопределено;
			ВМНомерСтроки.СтрокаШагаЧерез = Неопределено;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Возврат Ложь;

