Процедура ОбработатьДирективу(ТокенДирективы, РежимЧтения, Стек, ПеременныеПрепроцессора, МассивОшибокДирективы , ФлагОшибкиДирективы, СоответствиеУсловийПрепроцессора)

	Если ФлагОшибкиДирективы Тогда
		Возврат;
	КонецЕсли;

	ТокеныДирективы = ТокеныДирективы(ТокенДирективы.Значение);
	ТекстУсловияНакопленный = "";
	Для Каждого ТекЭлемент5 Из ТокеныДирективы Цикл
		ВерхнийЭлементСтека = ?(Стек.Количество() > 0, Стек [0], Неопределено);
		Если ТекЭлемент5 = "ОБЛАСТЬ" ИЛИ ТекЭлемент5 = "КОНЕЦОБЛАСТИ" ИЛИ ТекЭлемент5 = "REGION" ИЛИ ТекЭлемент5 = "ENDREGION" Тогда
			Возврат;
		КонецЕсли ;

		Если ТокеныДирективы.Количество() > 1 И(ТекЭлемент5 = "ИНАЧЕ" ИЛИ ТекЭлемент5 = "ELSE" ИЛИ ТекЭлемент5 = "КОНЕЦЕСЛИ" ИЛИ ТекЭлемент5 = "ENDIF" ) Тогда
			ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
		КонецЕсли;

		Если ВерхнийЭлементСтека = Неопределено Тогда
			Если ТекЭлемент5 = "ЕСЛИ" ИЛИ ТекЭлемент5 = "IF" Тогда
				Стек.Вставить(0, Новый Структура("Имя,Директива", ТекЭлемент5, ТокенДирективы));
			Иначе
				ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
			КонецЕсли;

		ИначеЕсли ВерхнийЭлементСтека.Имя = "ОПЕРАТОР" Тогда
			Если ТекЭлемент5 = "ЕСЛИ" ИЛИ ТекЭлемент5 = "ИНАЧЕЕСЛИ" ИЛИ ТекЭлемент5 = "IF" ИЛИ ТекЭлемент5 = "ELSIF" Тогда
				Стек.Вставить(0, Новый Структура("Имя,Директива", ТекЭлемент5, ТокенДирективы ));
			ИначеЕсли ТекЭлемент5 = "КОНЕЦЕСЛИ" ИЛИ ТекЭлемент5 = "ENDIF" Тогда
				ОбработатьКонецУсловия(Стек, МассивОшибокДирективы, ТокенДирективы , ФлагОшибкиДирективы, РежимЧтения);
			ИначеЕсли ТекЭлемент5 = "ИНАЧЕ" ИЛИ ТекЭлемент5 = "ELSE" Тогда

				РезультатПоискаУсловия = НайтиАктивнуюВетку(Стек );
				РежимЧтения = ?(Не РезультатПоискаУсловия.НайденоДействующееУсловие И РезультатПоискаУсловия.РежимЧтения, Истина, Ложь);
				Стек.Вставить(0, Новый Структура("Имя,Директива", ТекЭлемент5 , ТокенДирективы));
			Иначе
				ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
			КонецЕсли;

		ИначеЕсли ВерхнийЭлементСтека.Имя = "ЕСЛИ" ИЛИ ВерхнийЭлементСтека.Имя = "IF" ИЛИ ВерхнийЭлементСтека.Имя = "ИНАЧЕЕСЛИ" ИЛИ ВерхнийЭлементСтека.Имя = "ELSIF" Тогда
			Если ТекЭлемент5 = "ТОГДА" ИЛИ ТекЭлемент5 = "THEN" Тогда
				Если ЗначениеЗаполнено(ТекстУсловияНакопленный) Тогда

					Стек.Удалить(0);
					РезультатВычисленияУсловия = ВычислитьУсловиеДирективы(ТекстУсловияНакопленный, ПеременныеПрепроцессора , ФлагОшибкиДирективы, МассивОшибокДирективы, ТокенДирективы);
					ТекстУсловияНакопленный = "";
					СтруктураУсловияДирективы = Новый Структура("Директива,Результат", ТокенДирективы , РезультатВычисленияУсловия);
					Если Не ФлагОшибкиДирективы Тогда

						Если ВерхнийЭлементСтека.Имя = "ИНАЧЕЕСЛИ" ИЛИ ВерхнийЭлементСтека.Имя = "ELSIF" Тогда

							Имя = "ПОСТ_УСЛОВИЕ" ;
							РезультатПоискаУсловия = НайтиАктивнуюВетку(Стек);
							РежимЧтения = ?(Не РезультатПоискаУсловия.НайденоДействующееУсловие И РезультатПоискаУсловия.РежимЧтения , РезультатВычисленияУсловия, Ложь);
						Иначе

							Имя = "УСЛОВИЕ";
							СтруктураУсловияДирективы.Вставить("РежимЧтения", РежимЧтения);
							РежимЧтения = ?(РежимЧтения = Ложь, Ложь, РезультатВычисленияУсловия);
						КонецЕсли;

						СтруктураУсловияДирективы.Вставить("Имя", Имя);
						Стек.Вставить(0, СтруктураУсловияДирективы);
					КонецЕсли;

				Иначе
					ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
				КонецЕсли;

			Иначе
				Если СоответствиеУсловийПрепроцессора[ТекЭлемент5] <> Неопределено Тогда
					ТекстУсловияНакопленный = ТекстУсловияНакопленный + " " + ТекЭлемент5;
				Иначе
					ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
				КонецЕсли;

			КонецЕсли;

		ИначеЕсли ВерхнийЭлементСтека.Имя = "УСЛОВИЕ" ИЛИ ВерхнийЭлементСтека.Имя = "ПОСТ_УСЛОВИЕ" Тогда
			Если ТекЭлемент5 = "ИНАЧЕЕСЛИ" ИЛИ ТекЭлемент5 = "ELSIF" ИЛИ ТекЭлемент5 = "ИНАЧЕ" ИЛИ ТекЭлемент5 = "ELSE" ИЛИ ТекЭлемент5 = "ЕСЛИ" ИЛИ ТекЭлемент5 = "IF" Тогда

				Если ТекЭлемент5 = "ИНАЧЕ" ИЛИ ТекЭлемент5 = "ELSE" Тогда

					РезультатПоискаУсловия = НайтиАктивнуюВетку(Стек);
					РежимЧтения = ?(Не РезультатПоискаУсловия.НайденоДействующееУсловие И РезультатПоискаУсловия.РежимЧтения , Истина, Ложь);
				КонецЕсли;

				Стек.Вставить(0, Новый Структура("Имя,Директива", ТекЭлемент5, ТокенДирективы));
			ИначеЕсли ТекЭлемент5 = "КОНЕЦЕСЛИ" ИЛИ ТекЭлемент5 = "ENDIF" Тогда
				ОбработатьКонецУсловия(Стек, МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы, РежимЧтения);
			Иначе
				ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
			КонецЕсли;

		ИначеЕсли ВерхнийЭлементСтека.Имя = "ИНАЧЕ" ИЛИ ВерхнийЭлементСтека.Имя = "ELSE" Тогда

			Если ТекЭлемент5 = "ЕСЛИ" ИЛИ ТекЭлемент5 = "IF" Тогда
				Стек.Вставить(0, Новый Структура("Имя,Директива", ТекЭлемент5, ТокенДирективы));
			ИначеЕсли ТекЭлемент5 = "КОНЕЦЕСЛИ" ИЛИ ТекЭлемент5 = "ENDIF" Тогда
				ОбработатьКонецУсловия(Стек, МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы, РежимЧтения );
			Иначе
				ДобавитьОшибкуДирективы(МассивОшибокДирективы, ТокенДирективы, ФлагОшибкиДирективы);
			КонецЕсли;

		КонецЕсли;

		Если ФлагОшибкиДирективы Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

