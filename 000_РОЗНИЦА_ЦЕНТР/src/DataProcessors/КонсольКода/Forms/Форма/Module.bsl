#Область РазборКода

// Возвращает коллекцию имен используемых в коде переменных
//
// Параметры:
//  Код	 - Строка - Текст кода, в котором необходимо найти переменные
// 
// Возвращаемое значение:
//  Массив из Строка - Имена переменных
//
Функция ИспользуемыеПеременные(Код) Экспорт
	
	Результат = Новый СписокЗначений;
	
	КодБезСтровыхЛитералов = БезСтроковыхЛитералов(Код);
	Для НомерСтроки = 1 По СтрЧислоСтрок(КодБезСтровыхЛитералов) Цикл 
		
		СтрокаКода = СтрПолучитьСтроку(КодБезСтровыхЛитералов, НомерСтроки);
		НайтиИспользуемыеПеременныеВСтрокеКода(Результат, СтрокаКода);
		
	КонецЦикла;
	
	Результат.СортироватьПоЗначению();
	
	Возврат Результат.ВыгрузитьЗначения();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция БезСтроковыхЛитералов(Код)
	
	СимволДвойныеКовычки = """";
	Результат = СтрЗаменить(Код, СимволДвойныеКовычки + СимволДвойныеКовычки, "");
	
	СостояниеСтроковойЛитерал = Ложь;
	Для Сч = 1 По СтрДлина(Код) Цикл 
		
		Символ = Сред(Код, Сч, 1);
		Если Символ = СимволДвойныеКовычки Тогда
			
			Если Сч = СтрДлина(Код) Тогда
				СледующийСимвол = Неопределено;
			Иначе
				СледующийСимвол = Сред(Код, Сч + 1, 1);
			КонецЕсли;
			
			Если СледующийСимвол = СимволДвойныеКовычки Тогда
				
				СостояниеСтроковойЛитерал = Истина;
				Сч = Сч + 1;
				
			Иначе
				
				СостояниеСтроковойЛитерал = НЕ СостояниеСтроковойЛитерал;
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СостояниеСтроковойЛитерал Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + Символ;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НайтиИспользуемыеПеременныеВСтрокеКода(Результат, СтрокаКода)
	
	ПоискИспользуемыхПеременныхВозврат(Результат, СтрокаКода);
	ПоискИспользуемыхПеременныхВПрисвоениях(Результат, СтрокаКода);
	ПоискИспользуемыхПеременныхВСчетчикахЦикла(Результат, СтрокаКода);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоискИспользуемыхПеременныхВозврат(Результат, СтрокаКода)
	
	НомерСимвола = 1;
	РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
	Идентификатор = РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
	Если НРег(Идентификатор) = НРег("Возврат")
			ИЛИ НРег(Идентификатор) = НРег("Return") Тогда
		ДобавитьИспользуемуюПеременнуюВРезультат(Результат, "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоискИспользуемыхПеременныхВСчетчикахЦикла(Результат, СтрокаКода)
	
	НомерСимвола = 1;
	РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
	Идентификатор = РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
	Если НРег(Идентификатор) = НРег("Для")
			ИЛИ НРег(Идентификатор) = НРег("For") Тогда
			
		РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
		
		СледующийИдентификатор = РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
		Если НРег(СледующийИдентификатор) = НРег("Каждого")
				ИЛИ НРег(СледующийИдентификатор) = НРег("Each") Тогда
				
			РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
			
			ИмяСчетчика = РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
			ДобавитьИспользуемуюПеременнуюВРезультат(Результат, ИмяСчетчика);
			
		Иначе
			ДобавитьИспользуемуюПеременнуюВРезультат(Результат, СледующийИдентификатор);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоискИспользуемыхПеременныхВПрисвоениях(Результат, СтрокаКода)
	
	НомерСимвола = 1;
	РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
	Идентификатор = РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
	Если НРег(Идентификатор) = НРег("Если")
			ИЛИ НРег(Идентификатор) = НРег("If")
			ИЛИ НРег(Идентификатор) = НРег("ИначеЕсли")
			ИЛИ НРег(Идентификатор) = НРег("ElseIf") Тогда
		Возврат;
	КонецЕсли;
	
	РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
	СледующийСимвол = РазборПрочитатьСимвол(СтрокаКода, НомерСимвола);
	
	Если СледующийСимвол = "=" Тогда
		ДобавитьИспользуемуюПеременнуюВРезультат(Результат, Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьИспользуемуюПеременнуюВРезультат(Результат, Имя)
	
	Для Каждого Элемент Из Результат Цикл 
		
		Если НРег(Элемент.Значение) = НРег(Имя) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Добавить(Имя);
	
КонецПроцедуры

// Чтение незначащих символов (пробел, табуляция, перенос строки)
//
// Параметры:
//   Строка - Строка - Разбираемая строка
//   НачальныйИндекс - Число - Начальный индекс
//   Направление - НаправлениеПоиска - Направление поиска (по умолчанию: НаправлениеПоиска.СНачала)
//   СмещатьИндекс - Булево - Смещать индекс (по умолчанию: Истина)
//
// Возвращаемое значение:
//   Строка	- Прочитанные незначимые символы
//
&НаКлиентеНаСервереБезКонтекста
Функция РазборПрочитатьНезначимые(Строка, НачальныйИндекс = Неопределено, Направление = Неопределено, СмещатьИндекс = Истина) Экспорт
	
	Если Направление = НаправлениеПоиска.СКонца Тогда
		
		Если НачальныйИндекс = Неопределено Тогда
			НачальныйИндекс = СтрДлина(Строка);
		КонецЕсли;
		
		Индекс = НачальныйИндекс;
		Пока Индекс > 0 Цикл 
			
			Если Не СтрНайти(НаборСимволовЦифры(), Сред(Строка, Индекс, 1)) Тогда 
				Прервать;
			КонецЕсли;
			
			Индекс = Индекс - 1;
		КонецЦикла;
		
		Результат = Сред(Строка, Индекс + 1, НачальныйИндекс - Индекс); 
		
	Иначе
		
		Если НачальныйИндекс = Неопределено Тогда
			НачальныйИндекс = 1;
		КонецЕсли;
		
		Для Индекс = НачальныйИндекс По СтрДлина(Строка) Цикл 
			
			Если Не СтрНайти(НаборНезначащихСимволов(), Сред(Строка, Индекс, 1)) Тогда 
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Результат = Сред(Строка, НачальныйИндекс, Индекс - НачальныйИндекс); 
		
	КонецЕсли;
	
	Если СмещатьИндекс Тогда
		НачальныйИндекс = Индекс;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Чтение идентификатора строки
//
// Параметры:
//   Строка - Строка - Разбираемая строка
//   НачальныйИндекс - Число - Начальный индекс
//   СмещатьИндекс - Булево - Смещать индекс (по умолчанию: Истина)
//
// Возвращаемое значение:
//   Строка	- Прочитанный идентификатор
//
&НаКлиентеНаСервереБезКонтекста
Функция РазборПрочитатьИдентификатор(Строка, НачальныйИндекс = 1, СмещатьИндекс = Истина) Экспорт
	
	НаборСимволовИдентификатор = НаборСимволовРусскиеЛатинскиеБуквы() + НаборСимволовЦифры() + "_";
	НаборСимволовИдентификаторПервыйСимвол = НаборСимволовРусскиеЛатинскиеБуквы() + "_";
	
	Для Индекс = НачальныйИндекс По СтрДлина(Строка) Цикл 
		
		Символ = Сред(Строка, Индекс, 1);
		Если Индекс = НачальныйИндекс Тогда
			НаборСимволов = НаборСимволовИдентификаторПервыйСимвол;
		Иначе
			НаборСимволов = НаборСимволовИдентификатор;
		КонецЕсли;
		
		Если Не СтрНайти(НаборСимволов, Символ) Тогда 
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Сред(Строка, НачальныйИндекс, Индекс - НачальныйИндекс); 
	
	Если СмещатьИндекс Тогда
		НачальныйИндекс = Индекс;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Чтение символа
//
// Параметры:
//   Строка - Строка - Разбираемая строка
//   НачальныйИндекс - Число - Начальный индекс
//   СмещатьИндекс - Булево - Смещать индекс (по умолчанию: Истина)
//
// Возвращаемое значение:
//   Строка	- Прочитанный символ
//
&НаКлиентеНаСервереБезКонтекста
Функция РазборПрочитатьСимвол(Строка, НачальныйИндекс = 1, СмещатьИндекс = Истина) Экспорт
	
	Результат = Сред(Строка, НачальныйИндекс, 1);
	
	Если СмещатьИндекс Тогда
		НачальныйИндекс = НачальныйИндекс + 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

