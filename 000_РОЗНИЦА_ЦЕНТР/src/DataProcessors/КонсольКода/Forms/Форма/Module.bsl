		ВМНовый51.КоличествоАргументов = ВМНовый51.КоличествоАргументов - 1;
	КонецЦикла;

	СтекНовый51.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", Новый(Тип(ВМНовый51.Константы[КмдНовый51.Аргумент].Значение), МассивАргументовКонструктора ), ВМНовый51.ИдентификаторВызова));
