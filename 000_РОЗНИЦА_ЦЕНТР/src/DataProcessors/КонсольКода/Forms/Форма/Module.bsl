Процедура Оп_END(ВМЗавершение, СтекЗавершение, КомандаЗавершение)

	СтекВызовов = ВМЗавершение.СтекВызовов;
	Если СтекВызовов.Количество() > 0 Тогда

		ФреймИзСтекаВызовов = СтекВызовов[0];
		ВМЗавершение.ТекущаяКоманда = ФреймИзСтекаВызовов.ТочкаВызова + 1;
		ВМЗавершение.КлючиПеременных.Удалить(ВМЗавершение.ИдентификаторВызова);
		СтекВызовов.Удалить(0);
		Если ВМЗавершение.ИсходнаяВМ <> Неопределено И СтекВызовов.Количество() = 0 Тогда

			ВМЗавершение.ТекущаяКоманда = ВМЗавершение.Команды.Количество();
			Возврат;
		КонецЕсли;

		ФильтрВызовов = Новый Соответствие;
		ФильтрВызовов.Вставить(ВМЗавершение.ИдентификаторВызова, Истина );
		ОчиститьСтекВызова(ВМЗавершение.Стек, ФильтрВызовов);
		ОчиститьСтекВызова(ВМЗавершение.СтекВременныхПеременных, ФильтрВызовов);
		ВМЗавершение.ИдентификаторВызова = ?(СтекВызовов.Количество() > 0, СтекВызовов[0].ИдентификаторВызова, Неопределено);
	Иначе
		ВМЗавершение.ТекущаяКоманда = ВМЗавершение.ТекущаяКоманда + 1;
	КонецЕсли;

