		КонецЕсли;

	Иначе

		АдресВМВХранилище = СостояниеВМ;
		АдресПеременныхВХранилище = Соответствие;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПродолжитьИсполнение(АдресВМОтладки, ОбработчикОстановки, ФлагОстановкиПоОшибке, СоответствиеТочекОстанова = Неопределено)

	Если ТипЗнч(АдресВМОтладки) = Тип("Строка") Тогда
		ВМ = ПолучитьИзВременногоХранилища(АдресВМОтладки);
	Иначе
		ВМ = АдресВМОтладки;
	КонецЕсли;

	Если ВМ.ОстановленоПоОшибке Тогда
		Если ВМ.СтекПопыток.Количество() = 0 Тогда
			ВызватьИсключение ВМ.ОписаниеОшибки;
		Иначе
			ВМ.ОстановленоПоОшибке = Ложь;
		КонецЕсли;

	КонецЕсли;

	ВМ.ОстановкаПоОшибке = ФлагОстановкиПоОшибке;
	Если ВМ.ОтладкаЗавершена Тогда
		ВМ.ОтладкаЗавершена = Ложь;
	КонецЕсли;

	МассивКомандВМ = ВМ.Команды;
	КоличествоКоманд = МассивКомандВМ.Количество();
	Стек = ВМ.Стек;
	СтекПопыток = ВМ.СтекПопыток;
	ВМ.Вставить("СоответствиеТочекОстанова", СоответствиеТочекОстанова);
	Пока ВМ.ТекущаяКоманда < КоличествоКоманд Цикл
		Команда = МассивКомандВМ[ВМ.ТекущаяКоманда];
		Если Команда.ОпКод = "LINENUM" Тогда

			Если Команда.Аргумент <> ВМ.НомерСтрокиОстанова И СоответствиеТочекОстанова <> Неопределено Тогда
				Если Оп_LINENUM(ВМ, Стек, Команда, СоответствиеТочекОстанова, ОбработчикОстановки, АдресВМОтладки) Тогда
					Если ВМ.ЭтоСервер И ПроверитьТранзакцию() Тогда
						ОшибкаТранзакции(ВМ, ВМ.НомерСтрокиОстанова);
					Иначе

						ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
						Возврат;
					КонецЕсли;

				КонецЕсли;

			КонецЕсли;

			ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
		Иначе
			Попытка

				Если СтекПопыток.Количество() > 0 Тогда

					АдресПереходаИсключения = СтекПопыток[0].АдресПерехода;
					ТекстИсключения = СтекПопыток[0].ТекстИсключения;
					ИдентификаторВызоваИсключения = СтекПопыток[0].ИдентификаторВызова;
					КоличествоВременныхИсключения = СтекПопыток[0].КоличествоВременныхПеременных;
					СтекПопыток.Удалить(0);
					ОбработатьИсключениеВМ(ВМ, Стек, АдресПереходаИсключения, ИдентификаторВызоваИсключения, ТекстИсключения , КоличествоВременныхИсключения);
				Иначе
					Выполнить "Оп_" + Команда.ОпКод + "(ВМ, Стек, Команда)";
				КонецЕсли;

				Если ВМ.ОстановленоПоОшибке Тогда
					Возврат;
				КонецЕсли;

			Исключение Если ФлагОстановкиПоОшибке Тогда
				Если ВМ.ЭтоСервер И ПроверитьТранзакцию() Тогда

					ОшибкаТранзакции(ВМ, ВМ.НомерСтрокиОстанова);
					ВызватьИсключение;
				Иначе
					Если ОбновитьПеременныеКонтекста(ВМ, АдресВМОтладки, ОбработчикОстановки) Тогда

						ВМ.ОписаниеОшибки = ИнформацияОбОшибке().Описание;
						ВМ.ОстановленоПоОшибке = Истина;
						ВМ.Ошибки.Добавить(Новый Структура("Тип,Название,Строка", 2, ВМ.ОписаниеОшибки, ВМ.НомерСтрокиОстанова));
						Возврат;
					КонецЕсли;

				КонецЕсли;

			Иначе
				ВызватьИсключение;
			КонецЕсли;

		КонецПопытки ;

	КонецЕсли;

	Если ВМ.ТекущаяКоманда = КоличествоКоманд Тогда

		Если ОбработчикОстановки <> Неопределено Тогда
			СброситьОтладку(ВМ, АдресВМОтладки, ОбработчикОстановки);
		КонецЕсли ;

		Возврат;
	КонецЕсли;

	Если СоответствиеТочекОстанова = Неопределено И ОбновитьПеременныеКонтекста(ВМ, АдресВМОтладки, ОбработчикОстановки) Тогда
		Возврат;
	КонецЕсли;

КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗавершитьИсполнение(АдресВМЗавершения, ОбратныйВызовОтладки)

