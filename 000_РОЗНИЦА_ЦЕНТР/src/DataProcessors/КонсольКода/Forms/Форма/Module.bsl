					Для Каждого ТекПеременнаяСброса Из ТекПеременнаяПодпр.Переменные Цикл
						ТекПеременнаяСброса.Инициализирована = Ложь;
						ТекПеременнаяСброса.Значение = Неопределено;
					КонецЦикла;

				КонецЦикла;

				ВМСброса.Стек = Новый Массив;
				ВМСброса.СтекВременныхПеременных = Новый Массив;
				ВМСброса.СтекПопыток = Новый Массив;
