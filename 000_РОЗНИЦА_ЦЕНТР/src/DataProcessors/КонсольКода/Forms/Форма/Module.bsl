Функция ПолучитьПодпрограмму(ИмяПодпрограммы, ДанныеСемантикиПодпрограммы, ТипПодпрограммы = Неопределено, КоличествоАргументовПодпрограммы = Неопределено)

	Подпрограммы = ДанныеСемантикиПодпрограммы.Подпрограммы[ВРег(ИмяПодпрограммы)];
	Если Подпрограммы = Неопределено Тогда

		Подпрограммы = Новый Структура("Имя,Переменные,ЗначенияПоУмолчанию,Флаг,ЧислоАргументов,ТочкаВхода,Адрес" , ИмяПодпрограммы, Новый Соответствие, Новый Массив, ТипПодпрограммы, КоличествоАргументовПодпрограммы, Неопределено, ДанныеСемантикиПодпрограммы.Подпрограммы.Количество());
		ДанныеСемантикиПодпрограммы. Подпрограммы.Вставить(ВРег(Подпрограммы.Имя), Подпрограммы);
	Иначе
		Если ТипПодпрограммы <> Неопределено И(Подпрограммы.Флаг = Неопределено ИЛИ Подпрограммы.Флаг = 33 ИЛИ Подпрограммы.Флаг = 32) Тогда

			Подпрограммы.Флаг = ТипПодпрограммы;
			Подпрограммы.ЧислоАргументов = КоличествоАргументовПодпрограммы;
		КонецЕсли;

	КонецЕсли;

	Возврат Подпрограммы;

