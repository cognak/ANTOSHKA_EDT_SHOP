		Исключение
			Инфо = ИнформацияОбОшибке();
			ПоказатьПредупреждение(, "Ошибка в тексте запроса:" + Символы.ПС + Инфо.Причина.Описание);
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииКонструктораЗапросовСОбработкой", ЭтотОбъект, ДопПараметры);
	Конструктор.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктораЗапросовСОбработкой(Текст, ДопПараметры) Экспорт

	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(Текст, Символы.ПС, Символы.ПС + "|    ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", """""");

	Шаблон = "Запрос = Новый Запрос;" + Символы.ПС
		+ "Запрос.Текст = """ + ТекстЗапроса + """;" + Символы.ПС
		+ "" + Символы.ПС
		+ "Результат = Запрос.Выполнить();" + Символы.ПС
		+ "Выборка = Результат.Выбрать();" + Символы.ПС
		+ "Пока Выборка.Следующий() Цикл" + Символы.ПС
		+ "	" + Символы.ПС
		+ "КонецЦикла;";

	УстановитьТекст(Шаблон, ДопПараметры, Истина);

КонецПроцедуры

#КонецОбласти

#Область СинтаксПомощник

// Точка входа: вызывается при нажатии Ctrl+F1 или открытии панели справки
&НаКлиенте
Процедура ЗагрузитьДанныеСинтаксПомощника()

	Если СинтаксПомощникЗагружен ИЛИ СинтаксПомощникЗагружается Тогда
		Возврат;
	КонецЕсли;

	СинтаксПомощникЗагружается = Истина;

	// Оверлей ставится здесь — снимается ТОЛЬКО когда оба iframe загрузят индексы (onHelperReady)
	View().showTextOverlay("Подготовка индексов справки...");
	View().expectHelpers(2);

	// Проверяем наличие syntax_helper.html — если уже распакован, сразу показываем
	ФайлПроверки = Новый Файл(КаталогИсходников + "syntax_helper.html");
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиСуществованияСинтаксПомощника", ЭтотОбъект);
	ФайлПроверки.НачатьПроверкуСуществования(Оповещение);

КонецПроцедуры

// Шаг 1: проверили существование — если есть, показываем; если нет, распаковываем
&НаКлиенте
Процедура ПослеПроверкиСуществованияСинтаксПомощника(Существует, ДопПараметры) Экспорт

	Если Существует Тогда
		ИнициализироватьПанельСинтаксПомощника();
	Иначе
		View().showProgressOverlay("Первоначальная настройка", 0, 1, "Выполняется только при первом запуске", "");
		ДанныеМакета = ПолучитьИзВременногоХранилища(АдресМакетаСинтакс);
		ИмяАрхива = КаталогИсходников + "syntax_help.zip";
		Оповещение = Новый ОписаниеОповещения("ПослеЗаписиАрхиваСинтаксПомощника", ЭтотОбъект);
		ДанныеМакета.НачатьЗапись(Оповещение, ИмяАрхива);
	КонецЕсли;

КонецПроцедуры

// Шаг 2: архив записан на диск — даём браузеру отрисовать оверлей
&НаКлиенте
Процедура ПослеЗаписиАрхиваСинтаксПомощника(ДопПараметры) Экспорт

	ПодключитьОбработчикОжидания("РаспаковатьАрхивСинтаксПомощника", 1, Истина);

КонецПроцедуры

// Шаг 3: собственно распаковка (вызывается через обработчик ожидания, чтобы UI успел отрисоваться)
&НаКлиенте
Процедура РаспаковатьАрхивСинтаксПомощника() Экспорт

	ИмяАрхива = КаталогИсходников + "syntax_help.zip";

	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(КаталогИсходников);
		Архив.Закрыть();
	Исключение
		View().hideProgressOverlay();
		ВывестиОшибку("Не удалось извлечь файлы синтакс-помощника" + Символы.ПС + ОписаниеОшибки(), Истина);
		Возврат;
	КонецПопытки;

	// Удаляем временный архив
	Попытка
		УдалитьФайлы(ИмяАрхива);
	Исключение
	КонецПопытки;

	// Прогресс-бар остаётся — БСП распакуется под тем же оверлеем
	ИнициализироватьПанельСинтаксПомощника();

КонецПроцедуры

// Финальный шаг: показываем панель синтакс-помощника
&НаКлиенте
Процедура ИнициализироватьПанельСинтаксПомощника()

	View().initSyntaxHelpPanel("");
	СинтаксПомощникЗагружен = Истина;
	СинтаксПомощникЗагружается = Ложь;

	// Цепочка: после синтакса загружаем БСП
	ЗагрузитьДанныеБСПСправки();

КонецПроцедуры

#КонецОбласти

#Область СправкаБСП

&НаКлиенте
Процедура ЗагрузитьДанныеБСПСправки()

	Если БСПСправкаЗагружена ИЛИ БСПСправкаЗагружается Тогда
		Возврат;
	КонецЕсли;

	БСПСправкаЗагружается = Истина;

	// Проверяем наличие bsp_helper.html — если уже распакован, сразу показываем
	ФайлПроверки = Новый Файл(КаталогИсходников + "bsp_helper.html");
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиСуществованияБСПСправки", ЭтотОбъект);
	ФайлПроверки.НачатьПроверкуСуществования(Оповещение);

КонецПроцедуры

// Шаг 1: проверили существование
&НаКлиенте
Процедура ПослеПроверкиСуществованияБСПСправки(Существует, ДопПараметры) Экспорт

	Если Существует Тогда
		ИнициализироватьПанельБСПСправки();
	Иначе
		// Не показываем новый прогресс — продолжаем под тем же оверлеем что и синтакс
		ДанныеМакета = ПолучитьИзВременногоХранилища(АдресМакетаБСП);
		ИмяАрхива = КаталогИсходников + "bsp_help.zip";
		Оповещение = Новый ОписаниеОповещения("ПослеЗаписиАрхиваБСПСправки", ЭтотОбъект);
		ДанныеМакета.НачатьЗапись(Оповещение, ИмяАрхива);
	КонецЕсли;

КонецПроцедуры

// Шаг 2: архив записан
&НаКлиенте
Процедура ПослеЗаписиАрхиваБСПСправки(ДопПараметры) Экспорт

	// Прогресс-бар уже на экране от синтакса — не перезапускаем
	ПодключитьОбработчикОжидания("РаспаковатьАрхивБСПСправки", 1, Истина);

КонецПроцедуры

// Шаг 3: распаковка
&НаКлиенте
Процедура РаспаковатьАрхивБСПСправки() Экспорт

	ИмяАрхива = КаталогИсходников + "bsp_help.zip";

	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(КаталогИсходников);
		Архив.Закрыть();
	Исключение
		View().hideProgressOverlay();
		ВывестиОшибку("Не удалось извлечь файлы справки БСП" + Символы.ПС + ОписаниеОшибки(), Истина);
		Возврат;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяАрхива);
	Исключение
	КонецПопытки;

	// Оверлей (прогресс-бар или текст) остаётся — скроется через onHelperReady
	ИнициализироватьПанельБСПСправки();

КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьПанельБСПСправки()

	View().initBspHelpPanel();
	БСПСправкаЗагружена = Истина;
	БСПСправкаЗагружается = Ложь;
	// Оверлей "Подготовка индексов справки..." остаётся на экране.
	// Он скроется ТОЛЬКО когда оба iframe (syntax + BSP) вызовут onHelperReady()
	// после загрузки своих JSON-индексов → JS пошлёт EVENT_HELPERS_READY → СправкиГотовы = Истина.

КонецПроцедуры

&НаКлиенте
Процедура КомандаСправкаБСП(Команда)

	Если СправкиГотовы Тогда
		View().toggleBspHelp();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КонструкторФорматнойСтроки

&НаКлиенте
Процедура ПриЗакрытииКонструктораФорматнойСтроки(ФорматнаяСтрока, ДопПараметры) Экспорт
	
	Если ФорматнаяСтрока <> Неопределено Тогда	
		ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
		ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
		УстановитьТекст(ФорматнаяСтрока, ДопПараметры, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, ДопПараметры)
	
	Конструктор = Новый КонструкторФорматнойСтроки();
	Попытка			
		Конструктор.Текст = ФорматнаяСтрока;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ПоказатьПредупреждение(, "Ошибка в тексте форматной строки:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииКонструктораФорматнойСтроки", ЭтотОбъект, ДопПараметры);
	Конструктор.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздатьНовуюФорматнуюСтроку(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьКонструкторФорматнойСтроки("", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьКонструкторФорматнойСтроки(ПараметрыСтроки)
	
	Если ПараметрыСтроки = Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовуюФорматнуюСтроку", ЭтотОбъект);
		ТекстВопроса = "Форматная строка не найдена." + Символы.ПС + "Создать новую форматную строку?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
		ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, ПараметрыСтроки.range);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РежимРаботы

&НаКлиенте
Процедура ПриПереключенииРежимаЗапроса()
	
	Если РежимЗапроса Тогда
		Элементы.ПереключениеРежимаЗапроса.Заголовок = "Переключить в режим редактирования кода";
	Иначе
		Элементы.ПереключениеРежимаЗапроса.Заголовок = "Переключить в режим редактирования запроса";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежимЗапроса()
	
	ПриПереключенииРежимаЗапроса();
	
	ИдентификаторРежима = ?(РежимЗапроса, "bsl_query", "bsl");
	
	View().setLanguageMode(ИдентификаторРежима);
	
	Если РежимЗапроса Тогда
		ТекстЗапроса = ПолучитьТекстМакета("МакетЗапроса", Ложь);
		View().updateText(ТекстЗапроса, Ложь, Ложь);
	Иначе
		View().updateText("", Ложь, Ложь);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаменыКодаЗапросом(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПереключитьРежимЗапроса();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СохранениеВосстановление

&НаСервереБезКонтекста
Функция КлючОбъекта()
	
	Возврат "bsl_console";
	
КонецФункции

&НаСервереБезКонтекста
Функция КлючНастроекКонсоли()
	
	Возврат КлючОбъекта() + " (console settings)";
	
КонецФункции

&НаКлиенте
Функция ИмяСобытияНастройкиИзменены()
	
	Возврат КлючОбъекта() + "_settings_changed";
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИмяПоследнегоФайла()
	
	Возврат ХранилищеОбщихНастроек.Загрузить(КлючОбъекта(), "ИмяСохраненногоФайла");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовокФормы()

	Если ЗначениеЗаполнено(ИмяСохраненногоФайла) Тогда
		Заголовок = "Консоль кода — " + ИмяСохраненногоФайла;
	Иначе
		Заголовок = "Консоль кода";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьИмяПоследнегоФайла(ИмяФайла)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта(), "ИмяСохраненногоФайла", ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьКодВФайл()
	
	Если ЗначениеЗаполнено(ИмяСохраненногоФайла) Тогда
		ЗаписатьКодВФайл(ИмяСохраненногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКодВФайл(ИмяФайла)
	
	МассивДанных = ПолучитьИзВременногоХранилища(АдресДанныхСохраняемогоФайла());
	
	ЗаписьJSON 			= Новый ЗаписьJSON; 
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	
	ЗаписьJSON.ОткрытьФайл(ИмяФайла,,, ПараметрыЗаписиJSON);
	
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);	
	
	ЗаписьJSON.Закрыть();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция АдресДанныхСохраняемогоФайла()
	
	Дерево = РеквизитФормыВЗначение("ДеревоДанных");
	
	МассивДанных = Новый Массив;
	
	ЗаполнитьМассивДаннымиДереваДляСохраненияВФайл(Дерево.Строки, МассивДанных);
	
	Возврат ПоместитьВоВременноеХранилище(МассивДанных, УникальныйИдентификатор);
			
КонецФункции

&НаСервере
Процедура ЗаполнитьМассивДаннымиДереваДляСохраненияВФайл(СтрокиДерева, МассивДанных)

    Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		ДобавляемоеСоответствие = Новый Соответствие;
		ДобавляемоеСоответствие.Вставить("name", СтрокаДерева.Имя);
		ДобавляемоеСоответствие.Вставить("type", СтрокаДерева.Тип);
		
		МассивПодчиненныхДанных = Неопределено;
		
		Если СтрокаДерева.Тип = ТипЭлементДанныхГруппа() Тогда
			
			МассивПодчиненныхДанных = Новый Массив;
			ДобавляемоеСоответствие.Вставить("value", МассивПодчиненныхДанных);
			
		ИначеЕсли СтрокаДерева.Тип = ТипЭлементДанныхКод() Тогда	
			
			ДобавляемоеСоответствие.Вставить("value", СтрокаДерева.Данные.Текст);			
			
		КонецЕсли;
		
		МассивДанных.Добавить(ДобавляемоеСоответствие);
		
        ЗаполнитьМассивДаннымиДереваДляСохраненияВФайл(СтрокаДерева.Строки, 
			?(МассивПодчиненныхДанных = Неопределено, МассивДанных, МассивПодчиненныхДанных));

    КонецЦикла;

КонецПроцедуры 

&НаКлиенте
Процедура ПриВыбореФайлаДляСохранения(ВыбранныеФайлы, ДопПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ИмяСохраненногоФайла = ВыбранныеФайлы[0];
		ЗаписатьКодВФайл(ИмяСохраненногоФайла);
		ОбновитьЗаголовокФормы();

		Если ДопПараметры.ЗавершениеРаботы Тогда
			Закрыть();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииЧтенияФайлаСКодом(МассивДанных, ДополнительныеПараметры) Экспорт
	
	ОчиститьТекст();
	
	ДеревоДанных.ПолучитьЭлементы().Очистить();
	
	ТекущаяСтрока = Неопределено;
	
	ЗаполнитьДеревоДанныхДаннымиФайла(МассивДанных);
	
	КоллекцияСтрокДерева = ДеревоДанных.ПолучитьЭлементы();
	
	Для каждого СтрокаДерева Из КоллекцияСтрокДерева Цикл
		Элементы.ДеревоДанных.Развернуть(СтрокаДерева.ПолучитьИдентификатор());	
	КонецЦикла;
	
	Если КоллекцияСтрокДерева.Количество() > 0 Тогда
		Элементы.ДеревоДанных.ТекущаяСтрока = КоллекцияСтрокДерева[0].ПолучитьИдентификатор();
		ТекущаяСтрока = КоллекцияСтрокДерева[0];
	КонецЕсли;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		ОригинальныйКод = ПолучитьТекст();
	Иначе
		ОригинальныйКод = "";	
	КонецЕсли;
	
	View().setOriginalText(ОригинальныйКод);
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьСОригиналомЧтениеЗавершение(ДопПараметры) Экспорт
	
	Элементы.КоманднаяПанельСравнения.Видимость = Истина;
	ЭтаФорма.КоманднаяПанель.Видимость = Ложь;
	View().compare(ДопПараметры.ПолучитьТекст(), Истина, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьКодИзСохраненногоФайла(ИмяФайла, ИмяОбработчика = "ПриЗавершенииЧтенияФайлаСКодом")
		
	ЧтениеJSON = Новый ЧтениеJSON;
	
	Попытка
		ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();	
		
		ДобавитьСтрокуВДеревоДанных(ТипЭлементДанныхКод(),, Новый Структура("УстанавливатьМодифицированность", Ложь));
		
		Возврат;
	КонецПопытки;
	
	МассивДанных = ПрочитатьJSON(ЧтениеJSON, Истина);
	
	ЧтениеJSON.Закрыть();
	
	Для каждого ЭлементДанных Из МассивДанных Цикл
		ЭлементДанных.Вставить("ЭтоВерхнийУровень", Истина);	
	КонецЦикла;
	
	ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект), МассивДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоДанныхДаннымиФайла(МассивДанных)
	
    Для Каждого ЭлементДанных Из МассивДанных Цикл
		
		Если ЭлементДанных.Получить("ЭтоВерхнийУровень") <> Неопределено Тогда
			ТекущаяСтрока = Неопределено;
		КонецЕсли;
		
		ИмяСтроки = ЭлементДанных.Получить("name");
		ТипДанных = ЭлементДанных.Получить("type");
		ЗначениеДанных = ЭлементДанных.Получить("value");
		
		Если ТипЗнч(ЗначениеДанных) = Тип("Строка") Тогда
			НачальныеДанные = НовыйЭлементДанных(ТипЭлементДанныхКод(), Истина);
			НачальныеДанные.Текст = ЗначениеДанных;
		Иначе
			НачальныеДанные = Неопределено;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("НачальныеДанные", НачальныеДанные);
		ДополнительныеПараметры.Вставить("Активизировать", Ложь);
		ДополнительныеПараметры.Вставить("УстанавливатьМодифицированность", Ложь);
		
		ТекущаяСтрока = ДобавитьСтрокуВДеревоДанных(ТипДанных, ИмяСтроки, ДополнительныеПараметры); 
		
		Если ТипЗнч(ЗначениеДанных) = Тип("Массив") Тогда
			ЗаполнитьДеревоДанныхДаннымиФайла(ЗначениеДанных);	
		КонецЕсли;

    КонецЦикла;

КонецПроцедуры 

&НаКлиенте
Процедура ПриВыбореФайлаДляЗагрузки(ВыбранныеФайлы, ДопПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		ИмяСохраненногоФайла = ВыбранныеФайлы[0];
		ПрочитатьКодИзСохраненногоФайла(ИмяСохраненногоФайла);
		УправлениеВидимостьюСравнения();
		ОбновитьЗаголовокФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьКод()
	
	Возврат ЗначениеЗаполнено(СтрЗаменить(СокрЛП(ПолучитьТекст()), Символы.ПС, ""));
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьКодИзФайла()
	
	Оповещение = Новый ОписаниеОповещения("ПриВыбореФайлаДляЗагрузки", ЭтотОбъект);
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "json|*.json";
	ДиалогВыбора.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаменыКодомИзФайла(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗагрузитьКодИзФайла();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОбновленияСохраненияЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьКодВФайл();
	КонецЕсли;
	
	Модифицированность = Ложь;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохраненияЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьВыборФайлаИСохранение(Истина);
	Иначе
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановленияДанныхИзФайлаЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПрочитатьКодИзСохраненногоФайла(ИмяСохраненногоФайла);
		УправлениеВидимостьюСравнения();
		ОбновитьЗаголовокФормы();
	Иначе
		ИмяСохраненногоФайла = "";
		СохранитьИмяПоследнегоФайла(ИмяСохраненногоФайла);
		ДобавитьСтрокуВДеревоДанных(ТипЭлементДанныхКод(),, Новый Структура("УстанавливатьМодифицированность", Ложь));
		ОбновитьЗаголовокФормы();
	КонецЕсли;

	// Запускаем подготовку синтакс-помощника после закрытия диалога восстановления
	ЗагрузитьДанныеСинтаксПомощника();

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСохраненныеДанные()

	Если ЗначениеЗаполнено(ИмяСохраненногоФайла) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросВосстановленияДанныхИзФайлаЗавершение", ЭтотОбъект);
		ТекстВопроса = "Восстановить код из последнего сохраненного файла?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ДобавитьСтрокуВДеревоДанных(ТипЭлементДанныхКод(),, Новый Структура("УстанавливатьМодифицированность", Ложь));
		// Диалога нет — запускаем синтакс-помощник сразу
		ЗагрузитьДанныеСинтаксПомощника();
	КонецЕсли;
	
КонецПроцедуры

