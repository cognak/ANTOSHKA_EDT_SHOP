Процедура ДобавитьОшибкуДирективы(МассивРез2, ТокенОшибкиПрепроцессора, СинтаксическаяОшибкаПрепроцессора)

	СтруктураОшибкиПрепроцессора = Новый Структура("Тип,Название,Строка", 0, НСтр("ru = 'Некорректный синтаксис препроцессора ('; en = 'Incorrect preprocessor syntax ('" , ТекущийЯзыкСистемы()) + ТокенОшибкиПрепроцессора.НомерСтроки + ", " + ТокенОшибкиПрепроцессора.Позиция + ")", ТокенОшибкиПрепроцессора.НомерСтроки);
	МассивРез2.Добавить(СтруктураОшибкиПрепроцессора );
	СинтаксическаяОшибкаПрепроцессора = Истина;

