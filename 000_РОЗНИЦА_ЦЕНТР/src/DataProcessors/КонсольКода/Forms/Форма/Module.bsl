&НаСервереБезКонтекста
Функция ПолучитьЗначениеПеременнойСервер(АдресВМСервер, ИмяПеременнойСервер, ИдентификаторФормыСервер, ЦепочкаДоступаСервер = "")

	ВМСервер = ПолучитьИзВременногоХранилища(АдресВМСервер);
	Если ВМСервер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОписательПеременной = НайтиПеременнуюВИнтерпретаторе(ВМСервер, ИмяПеременнойСервер);
	Если ОписательПеременной = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеальноеЗначение = Значение(ВМСервер, ОписательПеременной);
	// Применяем цепочку доступа (.Свойство, [Индекс], .А.Б[0])
	Если ЦепочкаДоступаСервер <> "" Тогда
		РеальноеЗначение = РазрешитьЦепочкуДоступа(РеальноеЗначение, ЦепочкаДоступаСервер);
	ИначеЕсли ТипЗнч(РеальноеЗначение) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Попытка
			РеальноеЗначение = КонвертироватьВыборкуВСтруктуру(РеальноеЗначение);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(РеальноеЗначение) = Тип("РезультатЗапроса") Тогда
		РеальноеЗначение = РеальноеЗначение.Выгрузить();
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("ЭтоКоллекция", ЗначениеЯвляетсяКоллекцией(РеальноеЗначение));
	Если Результат.ЭтоКоллекция Тогда
		Результат.Вставить("АдресЗначения", ПоместитьВоВременноеХранилище(РеальноеЗначение, ИдентификаторФормыСервер));
		Результат.Вставить("ТипЗначения", Строка(ТипЗнч(РеальноеЗначение)));
		Результат.Вставить("КоличествоЭлементов", ПолучитьРазмерКоллекции(РеальноеЗначение));
	Иначе
		Результат.Вставить("АдресЗначения", "");
		Результат.Вставить("ТипЗначения", Строка(ТипЗнч(РеальноеЗначение)));
		Результат.Вставить("КоличествоЭлементов", 0);
		Результат.Вставить("ТекстЗначения", ФорматироватьЗначениеРекурсивно(РеальноеЗначение, ВМСервер.ВариантВстроенногоЯзыка, 0, 20));
	КонецЕсли;

	Возврат Результат;

КонецФункции

