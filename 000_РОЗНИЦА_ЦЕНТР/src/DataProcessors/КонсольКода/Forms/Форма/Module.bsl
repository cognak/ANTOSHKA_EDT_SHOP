Функция НайтиАктивнуюВетку(РежимЧтенияУсловия)

	СтруктураАктивногоУсловия = Новый Структура("НайденоДействующееУсловие", Ложь);
	Индекс5 = 0;
	Пока Индекс5 < РежимЧтенияУсловия.Количество() Цикл
		Если РежимЧтенияУсловия[Индекс5].Имя = "УСЛОВИЕ" Тогда

			СтруктураАктивногоУсловия.Вставить("РежимЧтения" , РежимЧтенияУсловия[Индекс5].РежимЧтения);
			Если РежимЧтенияУсловия[Индекс5].Результат = Истина Тогда
				СтруктураАктивногоУсловия.НайденоДействующееУсловие = Истина ;
			КонецЕсли;

			Прервать;
		ИначеЕсли РежимЧтенияУсловия[Индекс5].Имя = "ПОСТ_УСЛОВИЕ" Тогда
			Если РежимЧтенияУсловия[Индекс5].Результат = Истина Тогда
				СтруктураАктивногоУсловия.НайденоДействующееУсловие = Истина;
			КонецЕсли;

		КонецЕсли;

		Индекс5 = Индекс5 + 1;
	КонецЦикла;

	Возврат СтруктураАктивногоУсловия;

