&НаКлиенте
Функция НовоеИмяСтрокиДереваДанных(Родитель, Тип)
	
	МаксИндекс = МаксимальныйИндексСтрокДереваДанных(Родитель, Тип);
	Представление = ПредставлениеТипа(Тип);
	
	Возврат СтрШаблон("%1 №%2", Представление, МаксИндекс + 1);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеТипа(Тип)
	
	Результат = Новый Соответствие;
	Результат.Вставить(ТипЭлементДанныхКод(), НСтр("ru = 'Код'"));
	Результат.Вставить(ТипЭлементДанныхГруппа(), НСтр("ru = 'Группа'"));
	
	Возврат Результат.Получить(Тип);
		
КонецФункции

&НаКлиенте
Функция МаксимальныйИндексСтрокДереваДанных(Родитель, Тип)
	
	Результат = 0;
	Для Каждого Строка Из Родитель.ПолучитьЭлементы() Цикл 
		
		Если Строка.Тип <> Тип Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = Строка["Имя"];
		Индекс = ИндексИдентификатора(Значение);
		
		Если Индекс > Результат Тогда
			
			Результат = Индекс;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИндексИдентификатора(Строка) Экспорт 
	
	НаборСимволовЦифры = НаборСимволовЦифры();
	Длина = СтрДлина(Строка);
	
	Индекс = Длина;
	Пока Индекс > 1 Цикл 
		
		Если Не СтрНайти(НаборСимволовЦифры, Сред(Строка, Индекс, 1)) Тогда 
			Прервать;
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Если Индекс = Длина Тогда
		Возврат 0;
	КонецЕсли;
		
	Результат = Сред(Строка, Индекс + 1);
	Возврат Число(Результат);
	
КонецФункции

// Получает значение свойства структуры
//
// Параметры:
//   Структура - Структура - Структура
//   Имя - Строка - Имя свойства
//   ЗначениеПоУмолчанию - Произвольный - Значение по умолчанию, когда в данной структуре нет этого свойства
//
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры
//
&НаКлиентеНаСервереБезКонтекста
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если Структура.Свойство(Ключ) Тогда
		
		Результат = Структура[Ключ];
		
	Иначе
		
		Результат = ЗначениеПоУмолчанию;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

