			СтекДиректив.Удалить(0);
		ИначеЕсли СтекДиректив [0].Имя = "УСЛОВИЕ" Тогда

			РежимЧтенияEndif = СтекДиректив[0].РежимЧтения;
			СтекДиректив.Удалить(0);
			СтекДиректив.Вставить(0, Новый Структура("Имя", "ОПЕРАТОР"));
			Возврат;
		Иначе

			ДобавитьОшибкуДирективы(МассивОшибокEndif, ИнфоДирективы, ФлагОшибкиEndif);
			Возврат;
		КонецЕсли;

