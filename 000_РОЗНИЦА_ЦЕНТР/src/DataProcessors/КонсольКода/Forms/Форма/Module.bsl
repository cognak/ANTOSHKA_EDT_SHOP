&НаКлиентеНаСервереБезКонтекста
Процедура Оп_ITER(ВМИтератора, СтекИтератора, КомандаИтератора)

	КоллекцияДляИтерации = СтекИтератора [0].Значение;
	Попытка

		Если ТипЗнч(КоллекцияДляИтерации) = Тип("Соответствие") Тогда
			ВызватьИсключение "";
		КонецЕсли;

		ПервыйЭлементКоллекции = КоллекцияДляИтерации[0];
		Массив = КоллекцияДляИтерации ;
	Исключение Массив = Новый Массив;
		Для Каждого ТекЭлементКоллекции Из КоллекцияДляИтерации Цикл
			Массив.Добавить(ТекЭлементКоллекции);
		КонецЦикла;

	КонецПопытки ;

	КонтекстИтерацииДанные = Новый Структура("КоллекцияЭлементов,ТекущийЭлемент", Массив, 0);
	СтекИтератора.Удалить(0);
	СтекИтератора.Вставить(0, Новый Структура("Значение,ИдентификаторВызова" , КонтекстИтерацииДанные, ВМИтератора.ИдентификаторВызова));
	ВМИтератора.ТекущаяКоманда = ВМИтератора.ТекущаяКоманда + 1;

