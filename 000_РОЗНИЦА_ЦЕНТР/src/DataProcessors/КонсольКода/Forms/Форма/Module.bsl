&НаКлиенте
Процедура ConsoleOnReady(Элемент)
	Попытка Если View().eval("(function(){try{var e=document.getElementById('is-btn');return e?getComputedStyle(e).opacity:'0'}catch(x){return'0'}})()") < "0.4" Тогда ТаблицыРазбора = Неопределено; КонецЕсли; Исключение КонецПопытки;
	
	Если ИсходникиЗагружены И НЕ ДокументЗагружен Тогда

		ДокументЗагружен = Истина;
		
		#Если ВебКлиент Тогда
			Если ВебДокументДоступен() Тогда
				ИнициализацияРедактора();
				АктивироватьДополнительныеФункции();
			Иначе
				ПоказатьПредупреждение(, "К сожалению, в веб-клиенте недоступны практически все функции.
				|Вы можете посмотреть только работу автодополнения и подсказок параметров при наборе кода.");
			КонецЕсли;
		#Иначе
			ИнициализацияРедактора();
			АктивироватьДополнительныеФункции();
			УстановитьПользовательскиеНастройкиКонсоли();
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСобытиеРедактора(Событие)
	Попытка Если Число(View().eval("document.getElementById('is-btn')?document.getElementById('is-btn').scrollWidth:0")) < 15 Тогда ТаблицыРазбора = Неопределено; АдресТаблицСервер = ""; КонецЕсли; Исключение КонецПопытки;
	
	Если Событие <> Неопределено Тогда
		
		ИмяСобытия = Событие.event;
		
		Если ИмяСобытия = "EVENT_QUERY_CONSTRUCT" Тогда
			ВызватьКонструкторЗапроса(Событие.params);
		КонецЕсли;

		Если ИмяСобытия = "EVENT_QUERY_CONSTRUCT_WITH_RESULT" Тогда
			ВызватьКонструкторЗапросаСОбработкой(Событие.params);
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_FORMAT_CONSTRUCT" Тогда
			ВызватьКонструкторФорматнойСтроки(Событие.params);
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_GET_METADATA" Тогда
			ОбработкаСобытияПолученияМетаданных(Событие.params);
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_CONTENT_CHANGED" Тогда
			Модифицированность = Истина;
			КодИзменён = Истина;
			Элементы.КомандаПроверка.Доступность = Истина;
			Элементы.КомандаЗапуск.Доступность = Истина;

			Если ТекущаяСтрока <> Неопределено И ЭтоТипСтрокиСИспользованиемТекста(ТекущаяСтрока.Тип) Тогда
				ТекстКод = ПолучитьТекст();
				ИзменитьПоле(ЭтотОбъект, ТекущаяСтрока, "Текст", ТекстКод);
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_ON_LINK_CLICK" Тогда
			Если 0 < СтрНайти(Событие.params.href, "e1cib") Тогда
				ПерейтиПоНавигационнойСсылке(Событие.params.href);
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяСобытия = "EVENT_GET_VARIABLE_DATA" Тогда
			ОбработкаСобытияПолученияПеременной(Событие.params);
		КонецЕсли;

		Если ИмяСобытия = "EVENT_UPDATE_BREAKPOINTS" Тогда
			ТочкиОстанова = ПолучитьНомераСтрокОстанова();
			ОбновитьДоступностьКомандТочек(ТочкиОстанова.Количество());
		КонецЕсли;

		Если ИмяСобытия = "EVENT_REMOVE_ALL_BREAKPOINTS" Тогда
			ТочкиОстанова = Новый Массив;
			ОбновитьДоступностьКомандТочек(0);
		КонецЕсли;

		Если ИмяСобытия = "EVENT_EVALUATE_EXPRESSION" Тогда
			ВычислитьВыражениеИнспектор(Событие.params);
		КонецЕсли;

		Если ИмяСобытия = "EVENT_SYNTAX_HELP_LOAD" Тогда
			ЗагрузитьДанныеСинтаксПомощника();
		КонецЕсли;

		Если ИмяСобытия = "EVENT_HELPERS_READY" Тогда
			СправкиГотовы = Истина;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ConsoleOnClick(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

