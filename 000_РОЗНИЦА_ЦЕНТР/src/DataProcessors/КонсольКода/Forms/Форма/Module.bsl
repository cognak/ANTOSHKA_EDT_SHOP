&НаКлиентеНаСервереБезКонтекста
Функция Транслировать(ИсходныйКод, АдресТаблицПерехода, РежимВыполнить = Ложь)

	Если ТипЗнч(АдресТаблицПерехода) = Тип("Строка") Тогда
		ТаблицыРазбора = ПолучитьИзВременногоХранилища(АдресТаблицПерехода);
	Иначе
		ТаблицыРазбора = АдресТаблицПерехода;
	КонецЕсли;

	СтруктураМПА = ТаблицыРазбора.СтруктураМПА;
	СоответствиеДКА = ТаблицыРазбора.СоответствиеДКА;
	СоответствиеЛексемПеревода = ТаблицыРазбора.СоответствиеЛексемПеревода;
	СоответствиеУдаляемых = ТаблицыРазбора.СоответствиеУдаляемых;
	СоответствиеРедукций = ТаблицыРазбора.СоответствиеРедукций;
	СоответствиеЛексемУсловияПрепроцессора = ТаблицыРазбора.СоответствиеЛексемУсловияПрепроцессора;
	РезультатПарсинга = Новый Структура();
	Массив = Новый Массив;
	СтекПрепроцессора = Новый Массив;
	Ошибки = Новый Массив;
	ДанныеСемантикиРезультат = НоваяСтруктураСемантики();
	ДанныеСемантикиРезультат.Код = ИсходныйКод ;
	ДанныеСемантикиРезультат.РежимВыполнить = РежимВыполнить;
	МассивЛексем = Новый Массив;
	Структура = Неопределено;
	Соответствие = Новый Соответствие;
	БуферQt = Неопределено; // Буфер для склейки многострочных строк (Qt + Qt → один Qt)
	РежимЧтенияПрепроцессора = Истина;
	ФлагОшибкиПрепроцессора = Ложь;
	ПолучитьФлагиПлатформы = ПолучитьФлагиПлатформы();
	Индекс = 1;
	НомерСтрокиЛексемы = 1;
	НомерТекущейСтроки = 1;
	ПозицияВСтроке = 1;
	ПозицияЛексемы = 1;
	ДлинаИсходногоКода = СтрДлина(ИсходныйКод);
	ТипЛексемы = "";
	ДостигнутКонецФайла = Ложь;
	Массив.Вставить(0, "0");
	ДобавитьИнструкцию("", 0, ДанныеСемантикиРезультат, Новый Структура("Атрибуты", Новый Структура("КоличествоОпераций", 0)));
	Пока Не ДостигнутКонецФайла Цикл
		ПереходНайден = Истина;
		ЗначениеЛексемы = "";
		СледующееСостояниеДКА = "S";
		Пока ПереходНайден Цикл
			Если Индекс > ДлинаИсходногоКода Тогда
				ТекЭлемент = 0;
			Иначе
				ТекЭлемент = Сред(ИсходныйКод, Индекс, 1);
			КонецЕсли;

			Если ТекЭлемент <> 0 Тогда

				ПереходДКА = СоответствиеДКА[ТекЭлемент];
				Если ПереходДКА = Неопределено Тогда
					ПереходДКА = СоответствиеДКА["\U"];
				КонецЕсли;

				СледующийПереход = ПереходДКА[СледующееСостояниеДКА];
			Иначе
				СледующийПереход = Неопределено;
			КонецЕсли;

			Если СледующийПереход = Неопределено Тогда

				ПереходДКА = СоответствиеДКА["&!"];
				ПереходEOF = ПереходДКА [СледующееСостояниеДКА];
				Если ПереходEOF = Неопределено Тогда
					Если ТекЭлемент = 0 Тогда

						ТипЛексемы = "EOF";
						ПозицияЛексемы = ПозицияВСтроке ;
						НомерСтрокиЛексемы = НомерТекущейСтроки;
						ДостигнутКонецФайла = Истина;
					Иначе

						ТипЛексемы = "Err";
						Индекс = Индекс + 1;
						ПозицияВСтроке = ПозицияВСтроке + 1;
						ЗначениеЛексемы = ЗначениеЛексемы + ТекЭлемент;
						НомерСтрокиЛексемы = НомерТекущейСтроки;
						ПозицияЛексемы = ПозицияВСтроке - СтрДлина(ЗначениеЛексемы);
					КонецЕсли;

				Иначе

					ТипЛексемы = ПереходEOF.Вывод;
					Если СоответствиеЛексемПеревода[ТипЛексемы] <> Неопределено Тогда

						НомерСтрокиЛексемы = НомерТекущейСтроки;
						НомерТекущейСтроки = НомерТекущейСтроки + 1;
						ПозицияЛексемы = ПозицияВСтроке - СтрДлина(ЗначениеЛексемы );
						ПозицияВСтроке = 1;
					Иначе

						НомерСтрокиЛексемы = НомерТекущейСтроки;
						ПозицияЛексемы = ПозицияВСтроке - СтрДлина(ЗначениеЛексемы);
					КонецЕсли;

				КонецЕсли ;

				ПереходНайден = Ложь;
			Иначе

				ЗначениеЛексемы = ЗначениеЛексемы + ТекЭлемент;
				СледующееСостояниеДКА = СледующийПереход.СледСостояние;
				Индекс = Индекс + 1;
				ПозицияВСтроке = ПозицияВСтроке + 1;
			КонецЕсли;

		КонецЦикла;

		СтруктураТокена = Новый Структура("Имя,Значение,НомерСтроки,Позиция", ТипЛексемы , ЗначениеЛексемы, НомерСтрокиЛексемы, ПозицияЛексемы);
		МассивЛексем.Добавить(СтруктураТокена);
		Если СоответствиеУдаляемых[СтруктураТокена.Имя] <> Неопределено Тогда

			Соответствие.Вставить(СтруктураТокена.Имя, Истина);
			Продолжить;
		КонецЕсли;

		Если СтруктураТокена.Имя = "Pr" Тогда

			ОбработатьДирективу(СтруктураТокена , РежимЧтенияПрепроцессора, СтекПрепроцессора, ПолучитьФлагиПлатформы, Ошибки, ФлагОшибкиПрепроцессора, СоответствиеЛексемУсловияПрепроцессора);
			Если ФлагОшибкиПрепроцессора Тогда
				Прервать;
			КонецЕсли;

			Продолжить;
		КонецЕсли;

		Если Не РежимЧтенияПрепроцессора И СтруктураТокена.Имя <> "EOF" Тогда
			Продолжить;
		КонецЕсли;

		// Склейка многострочных строк: буферизация последовательных Qt токенов
		// Парсер не умеет склеивать String := String, Qt — склеиваем до парсера
		Если СтруктураТокена.Имя = "Qt" Тогда
			Если БуферQt = Неопределено Тогда
				БуферQt = Новый Структура("Имя,Значение,НомерСтроки,Позиция", "Qt", СтруктураТокена.Значение, СтруктураТокена.НомерСтроки, СтруктураТокена.Позиция);
			Иначе
				ПродолжениеСтроки = СтруктураТокена.Значение;
				Если СтрНачинаетсяС(ПродолжениеСтроки, "|") Тогда
					ПродолжениеСтроки = Сред(ПродолжениеСтроки, 2);
				КонецЕсли;
				БуферQt.Значение = БуферQt.Значение + Символы.ПС + ПродолжениеСтроки;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Сброс буфера Qt перед не-Qt токеном (подать склеенную строку в парсер)
		ТокеныДляПарсера = Новый Массив;
		Если БуферQt <> Неопределено Тогда
			ТокеныДляПарсера.Добавить(БуферQt);
			БуферQt = Неопределено;
		КонецЕсли;
		ТокеныДляПарсера.Добавить(СтруктураТокена);

		Для Каждого ОбрабатываемыйТокен Из ТокеныДляПарсера Цикл
			СтруктураТокена = ОбрабатываемыйТокен;

		Структура = Новый Структура("ТипДействия", "Редукция");
		Пока Структура.ТипДействия = "Редукция" Цикл
			Структура = ДействиеПарсера(СтруктураТокена, Массив, СтруктураМПА);
			Если Структура <> Неопределено Тогда
				Если Структура.ТипДействия = "Сдвиг" Тогда

					Массив.Вставить(0, Новый Структура("Терминал,Значение,НомерСтроки,Позиция", СтруктураТокена.Имя, СтруктураТокена.Значение, СтруктураТокена.НомерСтроки, СтруктураТокена.Позиция));
					Массив.Вставить(0, Структура.Переход);
				ИначеЕсли Структура.ТипДействия = "Редукция" Тогда

					СимволыРедукции = СоответствиеРедукций[Структура.Редукция].Символы;
					ИмяНетерминала = СоответствиеРедукций[Структура.Редукция ].Нетерминал;
					МассивУзловРедукции = Новый Массив;
					Для Каждого ТекЭлемент Из СимволыРедукции Цикл
						Массив.Удалить(0);
						МассивУзловРедукции.Вставить(0, Массив [0]);
						Массив.Удалить(0);
					КонецЦикла;

					КлючНетерминала = Массив[0] + "_" + ИмяНетерминала;
					СоответствиеНетерминалов = СтруктураМПА.СоответствиеНетерминалов [КлючНетерминала];
					Узел = Новый Структура("Нетерминал,СоставУзла,Атрибуты,НомерСтроки", ИмяНетерминала, МассивУзловРедукции, Новый Структура("КоличествоОпераций", 0), МассивУзловРедукции [0].НомерСтроки);
					Массив.Вставить(0, Узел);
					СемантическоеДействие(Узел, ДанныеСемантикиРезультат, Ошибки);
					Массив.Вставить(0, СоответствиеНетерминалов.Переход);
				ИначеЕсли Структура.ТипДействия = "Завершение" Тогда
					Массив.Удалить(0);
				КонецЕсли;

			Иначе

				ОбработатьОшибкуСинтаксиса(Ошибки , МассивЛексем, СоответствиеУдаляемых, ИсходныйКод);
				ДостигнутКонецФайла = Истина;
				Прервать;
			КонецЕсли;

		КонецЦикла;
		КонецЦикла; // Для Каждого ОбрабатываемыйТокен

	КонецЦикла;

	Если Соответствие["Dr"] <> Неопределено Тогда

		Если Не РежимВыполнить Тогда
			Структура3 = Новый Структура("Тип,Название,Строка", 1, НСтр("ru = 'Директивы компиляции в консоли кода не используются и будут проигнорированы'; en = 'Compilation directives in the code console are not used and will be ignored'" , ТекущийЯзыкСистемы()));
		Иначе
			Структура3 = Новый Структура("Тип,Название,Строка", 0, НСтр("ru = 'Неизвестный оператор'; en = 'Unknown operator'", ТекущийЯзыкСистемы()));
		КонецЕсли;

		Ошибки.Добавить(Структура3 );
	КонецЕсли;

	Если Не ФлагОшибкиПрепроцессора Тогда
		Для Каждого ТекущийСимвол Из СтекПрепроцессора Цикл
			Если ТекущийСимвол.Имя <> "ОПЕРАТОР" Тогда

				ДобавитьОшибкуДирективы(Ошибки , ТекущийСимвол.Директива, ФлагОшибкиПрепроцессора);
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Если Структура <> Неопределено Тогда

		МассивУзловРедукции = Новый Массив;
		Если Массив.Количество() > 0 Тогда
			МассивУзловРедукции.Добавить(Массив[0]);
		КонецЕсли;

		Узел = Новый Структура("Нетерминал,СоставУзла,Атрибуты", "S", МассивУзловРедукции, Новый Структура("КоличествоОпераций", 0));
		СемантическоеДействие(Узел, ДанныеСемантикиРезультат, Ошибки, РезультатПарсинга);
		РезультатПарсинга.Вставить("Узел" , Узел);
	КонецЕсли;

	РезультатПарсинга.Вставить("МассивЛексем", МассивЛексем);
	Для Каждого ТекЭлемент3 Из Ошибки Цикл
		Если ТекЭлемент3.Тип = 0 Тогда

			РезультатПарсинга.Вставить("ВыполнениеВозможно", Ложь);
			Прервать;
		КонецЕсли;

	КонецЦикла;

	РезультатПарсинга.Вставить("Ошибки", Ошибки);
	Если Не РезультатПарсинга. Свойство("ВыполнениеВозможно") Тогда
		РезультатПарсинга.Вставить("ВыполнениеВозможно", Истина);
	КонецЕсли;

	Возврат РезультатПарсинга;

КонецФункции

