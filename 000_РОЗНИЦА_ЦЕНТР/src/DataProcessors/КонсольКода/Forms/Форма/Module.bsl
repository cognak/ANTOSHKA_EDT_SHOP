&НаКлиентеНаСервереБезКонтекста
Процедура Оп_EXEC(ВМВыполнитьКод, СтекВыполнитьКод, КомандаВыполнитьКод)

	ТекстКодаДляВыполнения = СтекВыполнитьКод[0].Значение;
	СтекВыполнитьКод.Удалить(0);
	Транслировать = Транслировать(ТекстКодаДляВыполнения, ВМВыполнитьКод.АдресТаблицПерехода , Истина);
	Если Не Транслировать.ВыполнениеВозможно Тогда
		Для Каждого ТекОшибкаВыполнения Из Транслировать.Ошибки Цикл
			Если ТекОшибкаВыполнения.Тип = 0 Тогда
				ВызватьИсключение ТекОшибкаВыполнения.Название;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	ВМДляДинамичКода = Новый Структура;
	ИнициализироватьИнтерпретатор( Транслировать.КомандыВМ, Транслировать.КонстантыВМ, Транслировать.МеткиВМ , Транслировать.ПеременныеВМ, Транслировать.ПроцедурыФункцииВМ, Транслировать.ТочкаВхода,,,, ВМВыполнитьКод.АдресТаблицПерехода, ВМВыполнитьКод.ВариантВстроенногоЯзыка , ВМВыполнитьКод, ВМДляДинамичКода);
	ПродолжитьИсполнение(ВМДляДинамичКода, Неопределено, Ложь, Новый Соответствие);
	ВМВыполнитьКод.ТекущаяКоманда = ВМВыполнитьКод.ТекущаяКоманда + 1;

