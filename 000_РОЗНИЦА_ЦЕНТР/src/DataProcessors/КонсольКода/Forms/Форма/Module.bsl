Функция ДобавитьИнструкцию(КодОперации , АргументОперации, ДанныеСемантикиКоманды, АтрибутыКоманды, Знач Индекс4 = Неопределено, ЗначениеКоманды = Неопределено, СмещениеКоманды = 0, ИдентификаторКоманды = Неопределено)

	КомандыВМ = ДанныеСемантикиКоманды.КомандыВМ;
	ДанныеКомандВМ = ДанныеСемантикиКоманды.ДанныеКомандВМ;
	ИдентификаторКоманды = ?(ИдентификаторКоманды = Неопределено, Новый УникальныйИдентификатор, ИдентификаторКоманды);
	Если Индекс4 = Неопределено Тогда

		КомандыВМ.Добавить(ИдентификаторКоманды );
		АдресВставки = КомандыВМ.Количество() - 1;
	ИначеЕсли ТипЗнч(Индекс4) = Тип("УникальныйИдентификатор") Тогда

		Индекс4 = ДанныеКомандВМ [Индекс4].Адрес;
		АдресВставки = Индекс4 + 1;
		КомандыВМ.Вставить(АдресВставки, ИдентификаторКоманды);
		Индекс4 = АдресВставки + 1;
		Пока Индекс4 < КомандыВМ.Количество() Цикл
			ДанныеОбновляемойКоманды = ДанныеКомандВМ[КомандыВМ[Индекс4 ]];
			ДанныеОбновляемойКоманды.Адрес = ДанныеОбновляемойКоманды.Адрес + 1;
			Индекс4 = Индекс4 + 1;
		КонецЦикла;

	Иначе

		КомандыВМ.Вставить(Индекс4 , ИдентификаторКоманды);
		АдресВставки = Индекс4;
		Индекс4 = Индекс4 + 1;
		Пока Индекс4 < КомандыВМ.Количество() Цикл
			ДанныеОбновляемойКоманды = ДанныеКомандВМ[КомандыВМ[Индекс4]];
			ДанныеОбновляемойКоманды.Адрес = ДанныеОбновляемойКоманды.Адрес + 1;
			Индекс4 = Индекс4 + 1;
		КонецЦикла;

	КонецЕсли;

	СтруктураКомандыВМ = Новый Структура("ОпКод,Аргумент,Идентификатор,ИдентификаторАргумента,Сдвиг,Адрес");
	Если ТипЗнч(ЗначениеКоманды) = Тип("УникальныйИдентификатор" ) Тогда
		СтруктураКомандыВМ.ИдентификаторАргумента = ЗначениеКоманды;
	КонецЕсли;

	СтруктураКомандыВМ.ОпКод = КодОперации;
	СтруктураКомандыВМ.Аргумент = АргументОперации ;
	СтруктураКомандыВМ.Идентификатор = ИдентификаторКоманды;
	СтруктураКомандыВМ.Сдвиг = СмещениеКоманды;
	СтруктураКомандыВМ.Адрес = АдресВставки;
	ДанныеКомандВМ.Вставить(ИдентификаторКоманды, СтруктураКомандыВМ);
	Атрибуты = АтрибутыКоманды.Атрибуты;
	Атрибуты.КоличествоОпераций = Атрибуты.КоличествоОпераций + 1;
	Возврат ИдентификаторКоманды;

