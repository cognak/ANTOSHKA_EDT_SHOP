#Область ФлагиПлатформы


&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьФлагиПлатформы()

	#Если Клиент Тогда
		Клиент = Истина;
	#Иначе
		Клиент = Ложь;
	#КонецЕсли

	#Если Сервер Тогда
		Сервер = Истина;
	#Иначе
		Сервер = Ложь;
	#КонецЕсли

	#Если ТонкийКлиент Тогда
		ТонкийКлиент = Истина;
	#Иначе
		ТонкийКлиент = Ложь;
	#КонецЕсли

	#Если МобильныйКлиент Тогда
		МобильныйКлиент = Истина;
	#Иначе
		МобильныйКлиент = Ложь;
	#КонецЕсли

	#Если ВебКлиент Тогда
		ВебКлиент = Истина;
	#Иначе
		ВебКлиент = Ложь;
	#КонецЕсли

	#Если ВнешнееСоединение Тогда
		ВнешнееСоединение = Истина;
