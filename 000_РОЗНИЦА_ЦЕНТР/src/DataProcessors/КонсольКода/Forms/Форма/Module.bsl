	СоответствиеВстроенныхФункций.Вставить("INT", Новый Структура("Имя,КоличествоПараметров,Код", "Цел", 1, 66));
	СоответствиеВстроенныхФункций.Вставить("ROUND", Новый Массив );
	СоответствиеВстроенныхФункций["ROUND"].Добавить(Новый Структура("Имя,КоличествоПараметров,Код", "Окр", 2, 67));
	СоответствиеВстроенныхФункций["ROUND"].Добавить(Новый Структура("Имя,КоличествоПараметров,Код", "Окр", 3, 68));
	СоответствиеВстроенныхФункций.Вставить("BOOLEAN", Новый Структура("Имя,КоличествоПараметров,Код", "Булево", 1, 69));
	СоответствиеВстроенныхФункций.Вставить("NUMBER", Новый Структура("Имя,КоличествоПараметров,Код", "Число", 1, 70));
	СоответствиеВстроенныхФункций.Вставить("STRING" , Новый Структура("Имя,КоличествоПараметров,Код", "Строка", 1, 71));
	СоответствиеВстроенныхФункций.Вставить("DATE", Новый Массив);
	СоответствиеВстроенныхФункций["DATE"].Добавить(Новый Структура("Имя,КоличествоПараметров,Код", "Дата", 1, 72));
	СоответствиеВстроенныхФункций["DATE"].Добавить(Новый Структура("Имя,КоличествоПараметров,Код", "Дата", 3, 73));
	СоответствиеВстроенныхФункций["DATE"].Добавить(Новый Структура("Имя,КоличествоПараметров,Код", "Дата", 6, 74));
	СоответствиеВстроенныхФункций.Вставить("ADDMONTH", Новый Структура("Имя,КоличествоПараметров,Код", "ДобавитьМесяц", 2, 75));
