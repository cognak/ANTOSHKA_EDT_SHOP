&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТаблицуЛексера(ДанныеФормирования)
	
	СоответствиеПереходов    = Новый Соответствие;
	СоответствиеСпецсимволов = ПолучитьКартуСпецсимволов(); 
	СоответствиеБукв         = ПолучитьКартуБукв();
	
	Для Каждого стПереход Из ДанныеФормирования.МассивПереходов Цикл
		ГруппаСимволов = ДанныеФормирования.МассивГруппСимволов[стПереход.ГруппаСимволов];
		Для Каждого Символ Из ГруппаСимволов Цикл
			Символ = ?(СоответствиеСпецсимволов[Символ] = Неопределено, Символ, СоответствиеСпецсимволов[Символ]);
			
			Если СоответствиеПереходов[Символ] = Неопределено Тогда
				СоответствиеПереходов.Вставить(Символ, Новый Соответствие);			
			КонецЕсли;			
			
			СоответствиеПереходов[Символ].Вставить(стПереход.ТекСостояние, Новый Структура("СледСостояние,Вывод", стПереход.СледСостояние, ""));
			
			Если СоответствиеБукв[Символ] <> Неопределено Тогда
				Если СоответствиеПереходов[НРег(Символ)] = Неопределено Тогда
					СоответствиеПереходов.Вставить(НРег(Символ), Новый Соответствие);			
				КонецЕсли;			
				
				СоответствиеПереходов[НРег(Символ)].Вставить(стПереход.ТекСостояние, Новый Структура("СледСостояние,Вывод", стПереход.СледСостояние, ""));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	СоответствиеПереходов.Вставить("&!", Новый Соответствие);
	
	Для Каждого стПереход Из ДанныеФормирования.МассивКонечныхПереходов Цикл
		СоответствиеПереходов["&!"].Вставить(стПереход.ТекСостояние, Новый Структура("СледСостояние,Вывод", "S", ДанныеФормирования.МассивЛексем[стПереход.НомерЛексемы]));		
	КонецЦикла;
	
	Возврат СоответствиеПереходов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТаблицуПарсера(ДанныеФормирования)
	
	СтруктураМПА             = Новый Структура;
	СоответствиеТерминалов   = Новый Соответствие;
	СоответствиеНетерминалов = Новый Соответствие;
	
	Для Каждого стПереход Из ДанныеФормирования.МассивПереходов Цикл			
		
		Если ТипЗнч(стПереход.Символ) = Тип("Строка") Тогда
			ДобавитьПереходВТаблицу(СоответствиеТерминалов, СоответствиеНетерминалов, стПереход);	
		Иначе
			МассивСимволов = ДанныеФормирования.МассивГруппСимволов[стПереход.Символ];
			Для Каждого Символ Из МассивСимволов Цикл
				ДобавитьПереходВТаблицу(СоответствиеТерминалов, СоответствиеНетерминалов, стПереход, Символ);	
			КонецЦикла;
		КонецЕсли;	
			
	КонецЦикла;
	
	СтруктураМПА.Вставить("СоответствиеТерминалов",   СоответствиеТерминалов);
	СтруктураМПА.Вставить("СоответствиеНетерминалов", СоответствиеНетерминалов);
		
	Возврат СтруктураМПА;
	
КонецФункции

