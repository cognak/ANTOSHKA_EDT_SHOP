Процедура Оп_ADD(ВМСложения, СтекСложения, КомандаСложения)

	Лев = СтекСложения[1].Значение;
	Прав = СтекСложения[0].Значение;
	Если ТипЗнч(Лев) = Тип("Строка") И ТипЗнч(Прав) <> Тип("Строка") Тогда
		Прав = Строка(Прав);
	КонецЕсли;
	ПоложитьВСтек(ВМСложения, Лев + Прав, СтекСложения);
	ВМСложения.ТекущаяКоманда = ВМСложения.ТекущаяКоманда + 1;

