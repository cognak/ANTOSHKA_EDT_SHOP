Функция СоздатьТЗВыраженияНаСервере(Выражение, ТипЗначения, ТекстЗначения, ИдентификаторФормы)
	ТЗВыражение = Новый ТаблицаЗначений;
	ТЗВыражение.Колонки.Добавить("Выражение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	ТЗВыражение.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ТЗВыражение.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	СтрТЗ = ТЗВыражение.Добавить();
	СтрТЗ.Выражение = Выражение;
	СтрТЗ.Тип = ТипЗначения;
	СтрТЗ.Значение = ТекстЗначения;
	Возврат ПоместитьВоВременноеХранилище(ТЗВыражение, ИдентификаторФормы);
