&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьОшибкуТрансляции(МассивРез3, КонтекстОшибки, КодДляСтрокиОшибки, ТокенДляОшибки)

	резСтрПолучитьСтроку = СтрПолучитьСтроку(КодДляСтрокиОшибки, ТокенДляОшибки.НомерСтроки);
	Позиция = ТокенДляОшибки.Позиция + СтрДлина(ТокенДляОшибки.Значение);
	ТекСимвол4 = Сред(резСтрПолучитьСтроку, 1, Позиция - 1) + "<<?>>" + Сред(резСтрПолучитьСтроку, Позиция);
	ОтформатированнаяОшибка = КонтекстОшибки + " (" + ТокенДляОшибки.НомерСтроки + ", " + Позиция + "): " + ТекСимвол4;
	МассивРез3.Добавить(Новый Структура("Тип,Название,Строка", 0, ОтформатированнаяОшибка , ТокенДляОшибки.НомерСтроки));

