Функция ДанныеПеременнойТ(ИмяПеременнойВМ, ДанныеСемантикиПеременной, МассивРез, ОпКодЛокальнойПеременной, ЭтоВнешняяПеременная = Ложь)

	СтруктураДанныхПеременной = Новый Структура("ОпКод,Адрес");
	ОпКодПеременной = "LDVAR";
	Переменные2 = ДанныеСемантикиПеременной.Переменные;
	ОбластьПеременной = 2;
	Если ДанныеСемантикиПеременной.ЧтениеПодпрограммы Тогда

		ДанныеПодпрограммы = ДанныеСемантикиПеременной.Подпрограммы[ДанныеСемантикиПеременной.КлючТекущейПодпрограммы].Переменные;
		Если ДанныеПодпрограммы [ВРег(ИмяПеременнойВМ)] <> Неопределено Тогда

			ОпКодПеременной = "LDLOC";
			Переменные2 = ДанныеПодпрограммы;
		КонецЕсли;

	КонецЕсли;

	ДанныеПеременной = Переменные2 [ВРег(ИмяПеременнойВМ)];
	Если ДанныеПеременной = Неопределено Тогда
		Если ДанныеСемантикиПеременной.ЧтениеПодпрограммы И ЭтоВнешняяПеременная Тогда

			Переменные2 = ДанныеСемантикиПеременной.Подпрограммы[ДанныеСемантикиПеременной.КлючТекущейПодпрограммы].Переменные;
			ОпКодПеременной = "LDLOC";
			ОбластьПеременной = 1;
		ИначеЕсли Не ДанныеСемантикиПеременной.ЧтениеПодпрограммы И ЭтоВнешняяПеременная Тогда
			ОбластьПеременной = 0;
		КонецЕсли;

		Если ОбластьПеременной = 0 ИЛИ ОбластьПеременной = 1 Тогда
			Если ЭтоВнешняяПеременная(ИмяПеременнойВМ) Тогда
				ОбластьПеременной = 2;
			КонецЕсли;

		ИначеЕсли ОбластьПеременной = 2 И Не ЭтоВнешняяПеременная(ИмяПеременнойВМ) Тогда

			Сообщение = НСтр("ru = 'Переменная не определена ('; en = 'Variable is not defined ('" , ТекущийЯзыкСистемы()) + ИмяПеременнойВМ + ")";
			МассивРез.Добавить(Новый Структура("Тип,Название,Строка", 1, Сообщение, ОпКодЛокальнойПеременной));
		КонецЕсли;

		Если ОбластьПеременной = 2 Тогда

			Переменные2 = ДанныеСемантикиПеременной.Переменные;
			ОпКодПеременной = "LDVAR";
		КонецЕсли;

		АдресНовойПеременной = Переменные2.Количество();
		Переменные2.Вставить(ВРег(ИмяПеременнойВМ), Новый Структура("Адрес,Флаг,Имя", АдресНовойПеременной, ОбластьПеременной, ИмяПеременнойВМ));
		ДанныеПеременной = Переменные2 [ВРег(ИмяПеременнойВМ)];
	КонецЕсли;

	СтруктураДанныхПеременной.ОпКод = ОпКодПеременной;
	СтруктураДанныхПеременной.Адрес = ДанныеПеременной.Адрес;
	Возврат СтруктураДанныхПеременной ;

