&НаКлиентеНаСервереБезКонтекста
Функция ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат, ВариантЯзыка, Глубина, МаксЭлементов = 10)

	Если Глубина > 3 Тогда
		Возврат "...";
	КонецЕсли;

	Если ЗначениеДляФормат = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	ТипПеременной = ТипЗнч(ЗначениеДляФормат);
	Отступ = "";
	Для Сч = 1 По Глубина Цикл
		Отступ = Отступ + "  ";
	КонецЦикла;

	ОтступВложенный = Отступ + "  ";
	Если ТипПеременной = Тип("Булево") Тогда
		Если ВариантЯзыка = "ru" Тогда
			Возврат Формат(ЗначениеДляФормат, "БЛ=Ложь; БИ=Истина");
		Иначе
			Возврат Формат(ЗначениеДляФормат, "BF=False; BT=True");
		КонецЕсли;

	ИначеЕсли ТипПеременной = Тип("Строка") Тогда

		Если СтрДлина(ЗначениеДляФормат) > 200 Тогда
			Возврат """" + Лев(ЗначениеДляФормат, 200) + "...""";
		КонецЕсли;

		Возврат """" + ЗначениеДляФормат + """";
	ИначеЕсли ТипПеременной = Тип("Число") ИЛИ ТипПеременной = Тип("Дата") Тогда
		Возврат Строка(ЗначениеДляФормат);
	ИначеЕсли ТипПеременной = Тип("Null") Тогда
		Возврат "Null";
	ИначеЕсли ТипПеременной = Тип("Структура") Тогда
		Попытка

			Количество = ЗначениеДляФормат.Количество();
			Если Количество = 0 Тогда
				Возврат "Структура (пусто)";
			КонецЕсли;

			Части = Новый Массив;
			Счётчик = 0;
			Для Каждого КЗ Из ЗначениеДляФормат Цикл
				Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

					Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
					Прервать;
				КонецЕсли;

				Части.Добавить(ОтступВложенный + КЗ.Ключ + ": " + ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов));
				Счётчик = Счётчик + 1;
			КонецЦикла;

			Возврат "Структура (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
		Исключение
			Возврат "Структура";
		КонецПопытки;

	ИначеЕсли ТипПеременной = Тип("Соответствие") Тогда
		Попытка

			Количество = ЗначениеДляФормат.Количество();
			Если Количество = 0 Тогда
				Возврат "Соответствие (пусто)";
			КонецЕсли;

			Части = Новый Массив;
			Счётчик = 0;
			Для Каждого КЗ Из ЗначениеДляФормат Цикл
				Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

					Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
					Прервать;
				КонецЕсли;

				КлючСтр = "";
				Попытка КлючСтр = Строка(КЗ.Ключ); Исключение КлючСтр = Строка(ТипЗнч(КЗ.Ключ)); КонецПопытки;
					Части.Добавить(ОтступВложенный + "[" + КлючСтр + "]: " + ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов));
					Счётчик = Счётчик + 1;
				КонецЦикла;

				Возврат "Соответствие (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
			Исключение
				Возврат "Соответствие";
			КонецПопытки;

		ИначеЕсли ТипПеременной = Тип("Массив") Тогда
			Попытка

				Количество = ЗначениеДляФормат.Количество();
				Если Количество = 0 Тогда
					Возврат "Массив (пусто)";
				КонецЕсли;

				Части = Новый Массив;
				Макс = ?(МаксЭлементов > 0 И Количество > МаксЭлементов, МаксЭлементов, Количество);
				Для Инд = 0 По Макс - 1 Цикл
					Части.Добавить(ОтступВложенный + "[" + Строка(Инд) + "]: " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат[Инд], ВариантЯзыка, Глубина + 1, МаксЭлементов));
				КонецЦикла;

				Если МаксЭлементов > 0 И Количество > МаксЭлементов Тогда
					Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
				КонецЕсли;

				Возврат "Массив (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
			Исключение
				Возврат "Массив";
			КонецПопытки;

		ИначеЕсли ТипПеременной = Тип("ТаблицаЗначений") Тогда
			Попытка

				КоличествоСтрок = ЗначениеДляФормат.Количество();
				ИменаКолонок = Новый Массив;
				Для Каждого Колонка Из ЗначениеДляФормат.Колонки Цикл
					ИменаКолонок.Добавить(Колонка.Имя);
				КонецЦикла;

				Заголовок = "ТаблицаЗначений (" + Строка(КоличествоСтрок) + " строк, колонки: " + СтрСоединить(ИменаКолонок, ", ") + ")";
				Если КоличествоСтрок = 0 Тогда
					Возврат Заголовок;
				КонецЕсли;

				Части = Новый Массив;
				Счётчик = 0;
				Для Каждого СтрокаТЗ Из ЗначениеДляФормат Цикл
					Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

						Части.Добавить(ОтступВложенный + "... ещё " + Строка(КоличествоСтрок - МаксЭлементов));
						Прервать;
					КонецЕсли;

					ЧастиСтроки = Новый Массив;
					Для Каждого Колонка Из ЗначениеДляФормат.Колонки Цикл
						Попытка
							ЧастиСтроки.Добавить(Колонка.Имя + " = " + ФорматироватьЗначениеРекурсивно(СтрокаТЗ[Колонка.Имя], ВариантЯзыка, Глубина + 1, МаксЭлементов));
						Исключение
							ЧастиСтроки.Добавить(Колонка.Имя + " = <ошибка>");
						КонецПопытки;

					КонецЦикла;

					Части.Добавить(ОтступВложенный + "[" + Строка(Счётчик) + "]: {" + СтрСоединить(ЧастиСтроки, ", ") + "}");
					Счётчик = Счётчик + 1;
				КонецЦикла;

				Возврат Заголовок + Символы.ПС + СтрСоединить(Части, Символы.ПС);
			Исключение
				Возврат "ТаблицаЗначений";
			КонецПопытки;

		ИначеЕсли ТипПеременной = Тип("СписокЗначений") Тогда
			Попытка

				Количество = ЗначениеДляФормат.Количество();
				Если Количество = 0 Тогда
					Возврат "СписокЗначений (пусто)";
				КонецЕсли;

				Части = Новый Массив;
				Счётчик = 0;
				Для Каждого Элемент Из ЗначениеДляФормат Цикл
					Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

						Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
						Прервать;
					КонецЕсли;

					Попытка

						Представление = "";
						Если ЗначениеЗаполнено(Элемент.Представление) Тогда
							Представление = " (" + Элемент.Представление + ")";
						КонецЕсли;

						Части.Добавить(ОтступВложенный + "[" + Строка(Счётчик) + "]: " + ФорматироватьЗначениеРекурсивно(Элемент.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов) + Представление);
					Исключение
						Части.Добавить(ОтступВложенный + "[" + Строка(Счётчик) + "]: <ошибка>");
					КонецПопытки;

					Счётчик = Счётчик + 1;
				КонецЦикла;

				Возврат "СписокЗначений (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
			Исключение
				Возврат "СписокЗначений";
			КонецПопытки;

		ИначеЕсли ТипПеременной = Тип("СтрокаТаблицыЗначений") Тогда
			Попытка

				ЧастиСтроки = Новый Массив;
				Для Каждого Колонка Из ЗначениеДляФормат.Владелец().Колонки Цикл
					Попытка
						ЧастиСтроки.Добавить(Колонка.Имя + " = " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат[Колонка.Имя], ВариантЯзыка, Глубина + 1, МаксЭлементов));
					Исключение
						ЧастиСтроки.Добавить(Колонка.Имя + " = <ошибка>");
					КонецПопытки;

				КонецЦикла;

				Возврат "{" + СтрСоединить(ЧастиСтроки, ", ") + "}";
			Исключение
				Возврат "СтрокаТаблицыЗначений";
			КонецПопытки;

		ИначеЕсли ТипПеременной = Тип("КлючИЗначение") Тогда
			Попытка

				КлючСтр = "";
				Попытка КлючСтр = Строка(ЗначениеДляФормат.Ключ); Исключение КлючСтр = Строка(ТипЗнч(ЗначениеДляФормат.Ключ)); КонецПопытки;
					Возврат "{" + КлючСтр + ": " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов) + "}";
				Исключение
					Возврат "{КлючИЗначение}";
				КонецПопытки;

			ИначеЕсли ТипПеременной = Тип("ФиксированнаяСтруктура") Тогда
				Попытка

					Количество = ЗначениеДляФормат.Количество();
					Если Количество = 0 Тогда
						Возврат "ФиксированнаяСтруктура (пусто)";
					КонецЕсли;

					Части = Новый Массив;
					Счётчик = 0;
					Для Каждого КЗ Из ЗначениеДляФормат Цикл
						Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

							Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
							Прервать;
						КонецЕсли;

						Части.Добавить(ОтступВложенный + КЗ.Ключ + ": " + ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов));
						Счётчик = Счётчик + 1;
					КонецЦикла;

					Возврат "ФиксированнаяСтруктура (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
				Исключение
					Возврат "ФиксированнаяСтруктура";
				КонецПопытки;

			ИначеЕсли ТипПеременной = Тип("ФиксированноеСоответствие") Тогда
				Попытка

					Количество = ЗначениеДляФормат.Количество();
					Если Количество = 0 Тогда
						Возврат "ФиксированноеСоответствие (пусто)";
					КонецЕсли;

					Части = Новый Массив;
					Счётчик = 0;
					Для Каждого КЗ Из ЗначениеДляФормат Цикл
						Если МаксЭлементов > 0 И Счётчик >= МаксЭлементов Тогда

							Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
							Прервать;
						КонецЕсли;

						КлючСтр = "";
						Попытка КлючСтр = Строка(КЗ.Ключ); Исключение КлючСтр = Строка(ТипЗнч(КЗ.Ключ)); КонецПопытки;
							Части.Добавить(ОтступВложенный + "[" + КлючСтр + "]: " + ФорматироватьЗначениеРекурсивно(КЗ.Значение, ВариантЯзыка, Глубина + 1, МаксЭлементов));
							Счётчик = Счётчик + 1;
						КонецЦикла;

						Возврат "ФиксированноеСоответствие (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
					Исключение
						Возврат "ФиксированноеСоответствие";
					КонецПопытки;

				ИначеЕсли ТипПеременной = Тип("ФиксированныйМассив") Тогда
					Попытка

						Количество = ЗначениеДляФормат.Количество();
						Если Количество = 0 Тогда
							Возврат "ФиксированныйМассив (пусто)";
						КонецЕсли;

						Части = Новый Массив;
						Макс = ?(МаксЭлементов > 0 И Количество > МаксЭлементов, МаксЭлементов, Количество);
						Для Инд = 0 По Макс - 1 Цикл
							Части.Добавить(ОтступВложенный + "[" + Строка(Инд) + "]: " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат[Инд], ВариантЯзыка, Глубина + 1, МаксЭлементов));
						КонецЦикла;

						Если МаксЭлементов > 0 И Количество > МаксЭлементов Тогда
							Части.Добавить(ОтступВложенный + "... ещё " + Строка(Количество - МаксЭлементов));
						КонецЕсли;

						Возврат "ФиксированныйМассив (" + Строка(Количество) + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
					Исключение
						Возврат "ФиксированныйМассив";
					КонецПопытки;

				ИначеЕсли ТипПеременной = Тип("РезультатЗапроса") Тогда
					Попытка
						Возврат "Результат запроса → " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат.Выгрузить(), ВариантЯзыка, Глубина, МаксЭлементов);
					Исключение
						Возврат "РезультатЗапроса";
					КонецПопытки;

				ИначеЕсли ТипПеременной = Тип("ВыборкаИзРезультатаЗапроса") Тогда
					Попытка
						КолонкиВыборки = ЗначениеДляФормат.Владелец().Колонки;
						КолКолонок = КолонкиВыборки.Количество();
						Если КолКолонок = 0 Тогда
							Возврат "Выборка (нет колонок)";
						КонецЕсли;
						ИменаКолонок = Новый Массив;
						Для Инд = 0 По КолКолонок - 1 Цикл
							ИменаКолонок.Добавить(КолонкиВыборки.Получить(Инд).Имя);
						КонецЦикла;
						Заголовок = "Выборка (колонки: " + СтрСоединить(ИменаКолонок, ", ") + ")";
						Попытка
							ЧастиВыборки = Новый Массив;
							Для Инд = 0 По КолКолонок - 1 Цикл
								Попытка
									ЧастиВыборки.Добавить(ОтступВложенный + ИменаКолонок[Инд] + " = " + ФорматироватьЗначениеРекурсивно(ЗначениеДляФормат.Получить(Инд), ВариантЯзыка, Глубина + 1, МаксЭлементов));
								Исключение
									ЧастиВыборки.Добавить(ОтступВложенный + ИменаКолонок[Инд] + " = <ошибка>");
								КонецПопытки;
							КонецЦикла;
							Возврат Заголовок + " текущая строка:" + Символы.ПС + СтрСоединить(ЧастиВыборки, Символы.ПС);
						Исключение
							Возврат Заголовок + " (курсор не позиционирован)";
						КонецПопытки;
					Исключение
						Возврат "ВыборкаИзРезультатаЗапроса";
					КонецПопытки;

				Иначе
					Возврат БезопасноеПредставление(ЗначениеДляФормат);
				КонецЕсли;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Функция НомерСтрокиИнструкции(КэшНомеровСтрок, ИндексКоманды, ВМДляПоиска)

				КэшированныйНомер = КэшНомеровСтрок[ИндексКоманды];
				КомандыПоиска = ВМДляПоиска.Команды;
				Если КэшированныйНомер <> Неопределено Тогда
					Возврат КэшированныйНомер ;
				Иначе

					ИндексПоиска = ИндексКоманды - 1;
					КомандаПоиска = КомандыПоиска[ИндексПоиска];
					Пока ИндексПоиска >= 0 Цикл
						КомандаПоиска = КомандыПоиска[ИндексПоиска];
						Если КомандаПоиска.ОпКод = "LINENUM" Тогда

							КэшНомеровСтрок.Вставить(ИндексКоманды, КомандаПоиска.Аргумент );
							Возврат КомандаПоиска.Аргумент;
						КонецЕсли;

						ИндексПоиска = ИндексПоиска - 1;
					КонецЦикла;

				КонецЕсли;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Процедура ОбработатьИсключениеВМ(ВМ, Стек, АдресОбработчикаИсключения , Знач ИдентификаторВызоваОбработчика, ТекстОшибкиДляВозбуждения = Неопределено, РазмерСтекаВременных = Неопределено, СохраненнаяИнфоОшибки = Неопределено)

				КомандыОбработчика = ВМ.Команды;
				СтекПопытокОбработчика = ВМ.СтекПопыток;
				ЕстьОбработчикИсключения = СтекПопытокОбработчика.Количество() > 0;
				КартаТочекОстановаОбраб = ВМ.СоответствиеТочекОстанова;
				РазмерСтекаВременных = ?(РазмерСтекаВременных = Неопределено , ВМ.СтекВременныхПеременных.Количество(), РазмерСтекаВременных);
				Пока Истина Цикл
					Команда = КомандыОбработчика[ВМ.ТекущаяКоманда];
					Попытка
						Если ЕстьОбработчикИсключения Тогда
							Если ТекстОшибкиДляВозбуждения = Неопределено Тогда

								АдресИзСтекаПопыток = СтекПопытокОбработчика[0].АдресПерехода;
								ТекстИзСтекаПопыток = СтекПопытокОбработчика[0].ТекстИсключения;
								ИдентВызоваИзСтекаПопыток = СтекПопытокОбработчика [0].ИдентификаторВызова;
								ВременныхИзСтекаПопыток = СтекПопытокОбработчика[0].КоличествоВременныхПеременных;
								СтекПопытокОбработчика.Удалить(0);
								ЕстьОбработчикИсключения = Ложь;
								ОбработатьИсключениеВМ( ВМ, Стек, АдресИзСтекаПопыток, ИдентВызоваИзСтекаПопыток, ТекстИзСтекаПопыток, ВременныхИзСтекаПопыток, СохраненнаяИнфоОшибки);
							Иначе
								ВызватьИсключение ТекстОшибкиДляВозбуждения;
							КонецЕсли ;

						ИначеЕсли ТекстОшибкиДляВозбуждения <> Неопределено Тогда
							ВызватьИсключение ТекстОшибкиДляВозбуждения;
						ИначеЕсли ВМ.ОстановленоПоОшибке Тогда

							СтекПопытокОбработчика.Вставить(0, Новый Структура("АдресПерехода,ТекстИсключения,ИдентификаторВызова,КоличествоВременныхПеременных" , АдресОбработчикаИсключения, Неопределено, ИдентификаторВызоваОбработчика, РазмерСтекаВременных));
							Возврат;
						ИначеЕсли Команда.ОпКод = "LINENUM" Тогда

							Если КартаТочекОстановаОбраб = Неопределено ИЛИ(Команда.Аргумент <> ВМ.НомерСтрокиОстанова И КартаТочекОстановаОбраб <> Неопределено И КартаТочекОстановаОбраб[Команда.Аргумент] <> Неопределено) Тогда
								Если ВМ.ЭтоСервер И ПроверитьТранзакцию() Тогда
									ОшибкаТранзакции(ВМ, Команда.Аргумент);
								Иначе

									СтекПопытокОбработчика.Вставить(0, Новый Структура("АдресПерехода,ТекстИсключения,ИдентификаторВызова,КоличествоВременныхПеременных", АдресОбработчикаИсключения, Неопределено, ИдентификаторВызоваОбработчика , РазмерСтекаВременных));
									Возврат;
								КонецЕсли;

							КонецЕсли;

							ВМ.НомерСтрокиОстанова = Команда.Аргумент;
							ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
						ИначеЕсли Команда.ОпКод = "ENDTRY" Тогда

							ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							Возврат;
						ИначеЕсли Команда.ОпКод = "BLCKEND" Тогда
							Если ВМ.СчетчикБлоков = Неопределено Тогда

								ВМ.СчетчикБлоков = Команда.Аргумент - 1;
								Возврат;
							ИначеЕсли ВМ.СчетчикБлоков > 0 Тогда

								ВМ.СчетчикБлоков = ВМ.СчетчикБлоков - 1;
								Возврат;
							Иначе

								ВМ.СчетчикБлоков = Неопределено;
								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							КонецЕсли;

						ИначеЕсли Команда.ОпКод = "RAISE" Тогда

							ЗначениеДляВозбуждения = Стек[0].Значение;
							Стек.Удалить(0);
							ВызватьИсключение ЗначениеДляВозбуждения;
						ИначеЕсли Команда.ОпКод = "ERRORINFO" Тогда

							Стек.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", ?(СохраненнаяИнфоОшибки = Неопределено, ИнформацияОбОшибке(), ВоссоздатьОшибку(СохраненнаяИнфоОшибки)), ВМ.ИдентификаторВызова));
							ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
						ИначеЕсли Команда.ОпКод = "ERRORDESCRIPTION" Тогда

							Стек.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", ?(СохраненнаяИнфоОшибки = Неопределено, "", СохраненнаяИнфоОшибки), ВМ.ИдентификаторВызова ));
							ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
						ИначеЕсли Команда.ОпКод = "BEGINTRY" Тогда

							ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							ОбработатьИсключениеВМ(ВМ, Стек, Команда.Аргумент, ВМ.ИдентификаторВызова,,, СохраненнаяИнфоОшибки );
						Иначе
							Выполнить "Оп_" + Команда.ОпКод + "(ВМ, Стек, Команда)";
						КонецЕсли;

					Исключение ОписаниеПерехваченнойОшибки = ИнформацияОбОшибке().Описание;
						Если ЕстьОбработчикИсключения Тогда

							АдресИзСтекаПопыток = СтекПопытокОбработчика [0].АдресПерехода;
							ТекстИзСтекаПопыток = СтекПопытокОбработчика[0].ТекстИсключения;
							ИдентВызоваИзСтекаПопыток = СтекПопытокОбработчика[0].ИдентификаторВызова;
							ВременныхИзСтекаПопыток = СтекПопытокОбработчика [0].КоличествоВременныхПеременных;
							СтекПопытокОбработчика.Удалить(0);
							ЕстьОбработчикИсключения = Ложь;
							ОбработатьИсключениеВМ(ВМ, Стек, АдресИзСтекаПопыток, ИдентВызоваИзСтекаПопыток, ТекстИзСтекаПопыток , ВременныхИзСтекаПопыток, ОписаниеПерехваченнойОшибки);
							Если ВМ.ОстановленоПоОшибке Тогда

								СтекПопытокОбработчика.Вставить(0, Новый Структура("АдресПерехода,ТекстИсключения,ИдентификаторВызова,КоличествоВременныхПеременных", АдресОбработчикаИсключения, ОписаниеПерехваченнойОшибки, ИдентификаторВызоваОбработчика, РазмерСтекаВременных));
								Возврат;
							КонецЕсли;

						ИначеЕсли ТекстОшибкиДляВозбуждения = Неопределено Тогда

							РаскрутитьСтек(ВМ, ИдентификаторВызоваОбработчика, РазмерСтекаВременных);
							ВМ.ТекущаяКоманда = АдресОбработчикаИсключения;
							Если ВМ.ОстановкаПоОшибке Тогда
								Если ВМ.ЭтоСервер И ПроверитьТранзакцию() Тогда
									ОшибкаТранзакции(ВМ, ВМ.НомерСтрокиОстанова);
								Иначе

									ВМ.ОстановленоПоОшибке = Истина;
									ВМ.Ошибки.Добавить(Новый Структура("Тип,Название,Строка", 2, ОписаниеПерехваченнойОшибки, ВМ.НомерСтрокиОстанова));
									СтекПопытокОбработчика.Вставить(0, Новый Структура("АдресПерехода,ТекстИсключения,ИдентификаторВызова,КоличествоВременныхПеременных", АдресОбработчикаИсключения, ОписаниеПерехваченнойОшибки, ИдентификаторВызоваОбработчика, РазмерСтекаВременных) );
									Возврат;
								КонецЕсли;

							КонецЕсли;

						КонецЕсли;

						Пока Истина Цикл
							Команда = КомандыОбработчика[ВМ.ТекущаяКоманда];
							Если Команда.ОпКод = "LINENUM" Тогда

								Если КартаТочекОстановаОбраб = Неопределено ИЛИ(Команда.Аргумент <> ВМ.НомерСтрокиОстанова И КартаТочекОстановаОбраб <> Неопределено И КартаТочекОстановаОбраб[Команда.Аргумент] <> Неопределено) Тогда
									Если ВМ.ЭтоСервер И ПроверитьТранзакцию() Тогда
										ОшибкаТранзакции(ВМ, Команда.Аргумент);
									Иначе

										СтекПопытокОбработчика.Вставить(0, Новый Структура("АдресПерехода,ТекстИсключения,ИдентификаторВызова,КоличествоВременныхПеременных", АдресОбработчикаИсключения, ОписаниеПерехваченнойОшибки, ИдентификаторВызоваОбработчика , РазмерСтекаВременных));
										Возврат;
									КонецЕсли;

								КонецЕсли;

								ВМ.НомерСтрокиОстанова = Команда.Аргумент;
								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							ИначеЕсли Команда.ОпКод = "ENDTRY" Тогда

								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
								Возврат;
							ИначеЕсли Команда.ОпКод = "BLCKEND" Тогда
								Если ВМ.СчетчикБлоков = Неопределено Тогда

									ВМ.СчетчикБлоков = Команда.Аргумент;
									Возврат;
								ИначеЕсли ВМ.СчетчикБлоков > 0 Тогда
									Возврат;
								Иначе

									ВМ.СчетчикБлоков = Неопределено;
									ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
								КонецЕсли ;

							ИначеЕсли Команда.ОпКод = "RAISE" Тогда
								Если Команда.Аргумент = 0 Тогда
									ВызватьИсключение;
								Иначе

									ЗначениеДляВозбуждения = Стек[0].Значение;
									Стек.Удалить(0);
									ВызватьИсключение ЗначениеДляВозбуждения;
								КонецЕсли;

							ИначеЕсли Команда.ОпКод = "ERRORINFO" Тогда

								Стек.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", ИнформацияОбОшибке(), ВМ.ИдентификаторВызова));
								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							ИначеЕсли Команда.ОпКод = "ERRORDESCRIPTION" Тогда

								Стек.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", ОписаниеПерехваченнойОшибки, ВМ.ИдентификаторВызова));
								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
							ИначеЕсли Команда.ОпКод = "BEGINTRY" Тогда

								ВМ.ТекущаяКоманда = ВМ.ТекущаяКоманда + 1;
								ОбработатьИсключениеВМ(ВМ, Стек, Команда.Аргумент, ВМ.ИдентификаторВызова,,, ОписаниеПерехваченнойОшибки);
							Иначе
								Выполнить "Оп_" + Команда.ОпКод + "(ВМ, Стек, Команда)";
							КонецЕсли;

						КонецЦикла;

					КонецПопытки;

				КонецЦикла;

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Процедура РаскрутитьСтек(ВМРаскрутки, ИсходныйИдентВызова, ИсходныйРазмерСтека)

				СтекВызововРаскрутки = ВМРаскрутки.СтекВызовов;
				ФильтрВызововРаскрутки = Новый Соответствие;
				ГлубинаСтекаВызовов = СтекВызововРаскрутки.Количество();
				Пока ГлубинаСтекаВызовов > 0 Цикл
					ИдентВызоваТекФрейма = СтекВызововРаскрутки[0].ИдентификаторВызова;
					Если ИдентВызоваТекФрейма <> ИсходныйИдентВызова Тогда

						ФильтрВызововРаскрутки.Вставить(ИдентВызоваТекФрейма, Истина);
						ВМРаскрутки.КлючиПеременных.Удалить(ИдентВызоваТекФрейма);
						СтекВызововРаскрутки.Удалить(0);
					Иначе
						Прервать;
					КонецЕсли ;

					ГлубинаСтекаВызовов = ГлубинаСтекаВызовов - 1;
				КонецЦикла;

				СтекВремПеремРаскрутки = ВМРаскрутки.СтекВременныхПеременных;
				ОчиститьСтекВызова(СтекВремПеремРаскрутки , ФильтрВызововРаскрутки);
				ГлубинаСтекаВременных = СтекВремПеремРаскрутки.Количество();
				Пока ГлубинаСтекаВременных > ИсходныйРазмерСтека Цикл
					СтекВремПеремРаскрутки.Удалить(0);
					ГлубинаСтекаВременных = ГлубинаСтекаВременных - 1;
				КонецЦикла;

				ФильтрВызововРаскрутки.Вставить(ИсходныйИдентВызова, Истина);
				ОчиститьСтекВызова(ВМРаскрутки.Стек, ФильтрВызововРаскрутки);
				ВМРаскрутки.ИдентификаторВызова = ИсходныйИдентВызова;

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Процедура ОчиститьСтекВызова(СтекДляФильтрации, ФильтрИдентВызовов)

				РазмерФильтруемогоСтека = СтекДляФильтрации.Количество();
				Для ИндексФильтрации = 1 По РазмерФильтруемогоСтека Цикл
					ИндексЭлементаСтека = РазмерФильтруемогоСтека - ИндексФильтрации;
					ЭлементСтека = СтекДляФильтрации[ИндексЭлементаСтека];
					Если ФильтрИдентВызовов[ЭлементСтека.ИдентификаторВызова] <> Неопределено Тогда
						СтекДляФильтрации.Удалить(ИндексЭлементаСтека );
					КонецЕсли;

				КонецЦикла;

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВызватьМетод(ВМ, Стек, КомандаВызоваМетода, ЭтоФункция = Истина)

	ЧислоАргМетода = ВМ.КоличествоАргументов;
	АдресОбъекта = ЧислоАргМетода ;
	КодВызоваМетода = ?(ЭтоФункция = Истина, "ВМ.РезультатФункции.Значение = ", "") + "Стек[АдресОбъекта].Значение." + ВМ.Константы[КомандаВызоваМетода.Аргумент].Значение + "(";
	
	ЧислоАргМетода = ЧислоАргМетода - 1;
	Пока ЧислоАргМетода >= 0 Цикл
		КодВызоваМетода = КодВызоваМетода + ?(Стек[ЧислоАргМетода].Свойство("ЭтоПустоеЗначение"), "", "Стек[" + Формат(ЧислоАргМетода, "ЧН=0; ЧГ=0") + "].Значение") + ?(ЧислоАргМетода = 0, "", ", ");
		ЧислоАргМетода = ЧислоАргМетода - 1;
	КонецЦикла;

	КодВызоваМетода = КодВызоваМетода + ")";
	Выполнить КодВызоваМетода;
	
	Для Инд = 0 По ВМ.КоличествоАргументов - 1 Цикл
		ЭлементСтека = Стек[Инд];
		Если ЭлементСтека.Свойство("Адрес") И ЭлементСтека.Свойство("Имя") И ЭлементСтека.Имя <> Неопределено Тогда
			ИмяСвойства = Неопределено;
			ЭлементСтека.Свойство("ИмяСвойства", ИмяСвойства);
			Если ЭлементСтека.Флаг <> 2 И ИмяСвойства = Неопределено Тогда
				ЗаписатьПеременную(ВМ, Стек, ЭлементСтека, ЭлементСтека.Флаг, ЭлементСтека.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Пока АдресОбъекта >= 0 Цикл
		Стек.Удалить(0);
		АдресОбъекта = АдресОбъекта - 1;
	КонецЦикла;

КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ВызватьПодпрограмму(ВМ, Стек, КомандаЛокВызова, ЭтоФункцияЛокальная = Истина)

	ЧислоАргЛокВызова = ВМ.КоличествоАргументов;
	ЧислоАргументовМетода = ЧислоАргЛокВызова;
	КодЛокальногоВызова = ?(ЭтоФункцияЛокальная = Истина, "ВМ.РезультатФункции.Значение = " , "") + ВМ.Подпрограммы[КомандаЛокВызова.Аргумент].Имя + "(";
	
	ЧислоАргЛокВызова = ЧислоАргЛокВызова - 1;
	Пока ЧислоАргЛокВызова >= 0 Цикл
		КодЛокальногоВызова = КодЛокальногоВызова + ?(Стек[ЧислоАргЛокВызова].Свойство("ЭтоПустоеЗначение"), "", "Стек[" + Формат(ЧислоАргЛокВызова, "ЧН=0; ЧГ=0") + "].Значение") + ?(ЧислоАргЛокВызова = 0, "", ", ");
		ЧислоАргЛокВызова = ЧислоАргЛокВызова - 1;
	КонецЦикла;

	КодЛокальногоВызова = КодЛокальногоВызова + ")";
	Выполнить КодЛокальногоВызова;
	
	Для Инд = 0 По ЧислоАргументовМетода - 1 Цикл
		ЭлементСтека = Стек[Инд];
		Если ЭлементСтека.Свойство("Адрес") И ЭлементСтека.Свойство("Имя") И ЭлементСтека.Имя <> Неопределено Тогда
			ИмяСвойства = Неопределено;
			ЭлементСтека.Свойство("ИмяСвойства", ИмяСвойства);
			Если ЭлементСтека.Флаг <> 2 И ИмяСвойства = Неопределено Тогда
				ЗаписатьПеременную(ВМ, Стек, ЭлементСтека, ЭлементСтека.Флаг, ЭлементСтека.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Пока ЧислоАргументовМетода > 0 Цикл
		Стек.Удалить(0);
		ЧислоАргументовМетода = ЧислоАргументовМетода - 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Процедура ВычислитьМинМакс(ВММинМакс, Стек, ИмяФункцииМинМакс)

				ЧислоАргМинМакс = ВММинМакс.КоличествоАргументов;
				ЧислоАргМинМаксКопия = ЧислоАргМинМакс;
				РезультатФункции = Неопределено;
				КодМинМакс = "РезультатФункции = " + ИмяФункцииМинМакс + "(";
				ЧислоАргМинМакс = ЧислоАргМинМакс - 1;
				Пока ЧислоАргМинМакс >= 0 Цикл
					КодМинМакс = КодМинМакс + "Стек[" + Формат(ЧислоАргМинМакс, "ЧН=0; ЧГ=0") + "].Значение" + ?(ЧислоАргМинМакс = 0, "", ", ");
					ЧислоАргМинМакс = ЧислоАргМинМакс - 1;
				КонецЦикла;

				КодМинМакс = КодМинМакс + ")";
				Выполнить КодМинМакс;
				Пока ЧислоАргМинМаксКопия > 0 Цикл
					Стек.Удалить(0);
					ЧислоАргМинМаксКопия = ЧислоАргМинМаксКопия - 1;
				КонецЦикла;

				Стек.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", РезультатФункции, ВММинМакс.ИдентификаторВызова) );

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Процедура ЗагрузитьСвойство(ВМСвойства, СтекСвойства, ИмяСвойства)

				ЗначениеПредСвойства = СтекСвойства[0];
				СтруктураДоступаКСвойству = Новый Структура("Значение,ИдентификаторВызова", ЗначениеПредСвойства.Значение[ИмяСвойства], ВМСвойства.ИдентификаторВызова);
				Если ЗначениеПредСвойства.Свойство("Адрес") Тогда

					СтруктураДоступаКСвойству.Вставить("ИмяСвойства", ИмяСвойства);
					СтруктураДоступаКСвойству.Вставить("ЗначениеПредСвойства", ЗначениеПредСвойства.Значение);
					СтруктураДоступаКСвойству.Вставить("Адрес", ЗначениеПредСвойства.Адрес);
					СтруктураДоступаКСвойству.Вставить("Флаг", ЗначениеПредСвойства.Флаг);
					СтруктураДоступаКСвойству.Вставить("ИсходныйИдентификаторВызова", ЗначениеПредСвойства.ИсходныйИдентификаторВызова);
					СтруктураДоступаКСвойству.Вставить("ВМ", ЗначениеПредСвойства.ВМ);
					СтруктураДоступаКСвойству.Вставить("Имя", ЗначениеПредСвойства.Имя);
				КонецЕсли;

				СтекСвойства.Удалить(0);
				СтекСвойства.Вставить(0, СтруктураДоступаКСвойству );

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Функция Значение(ВМДляЗначения, ОписательПеременной)

				Если ОписательПеременной.Флаг <> 2 Тогда

					ЦелеваяВМДляЗначения = ?(ОписательПеременной.ВМ = Неопределено, ВМДляЗначения, ОписательПеременной.ВМ);
					ИмяСвойстваДоступа = ОписательПеременной.ИмяСвойства;
					Если ИмяСвойстваДоступа <> Неопределено Тогда
						Возврат ОписательПеременной.ЗначениеПредСвойства[ИмяСвойстваДоступа];
					КонецЕсли;

					Если ОписательПеременной.ИдентификаторВызова = Неопределено Тогда
						Возврат ЦелеваяВМДляЗначения.Переменные[ОписательПеременной.Адрес].Значение ;
					Иначе
						Возврат ЦелеваяВМДляЗначения.КлючиПеременных[ОписательПеременной.ИдентификаторВызова][ОписательПеременной.Адрес].Значение;
					КонецЕсли;

				Иначе
					Возврат ЗначениеВнешнейПеременной(ОписательПеременной.Имя);
				КонецЕсли;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Функция СсылкаНаПеременную(ВМДляСсылки, ОписательСсылки)

				ЦелеваяВМДляСсылки = ?(ОписательСсылки.ВМ = Неопределено, ВМДляСсылки , ОписательСсылки.ВМ);
				Если ОписательСсылки.ИсходныйИдентификаторВызова = Неопределено Тогда
					Возврат ЦелеваяВМДляСсылки.Переменные[ОписательСсылки.Адрес];
				Иначе
					Возврат ЦелеваяВМДляСсылки.КлючиПеременных[ОписательСсылки.ИсходныйИдентификаторВызова][ОписательСсылки.Адрес];
				КонецЕсли;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Процедура ЗаписатьПеременную(ВМПрисвоения, СтекПрисвоения , ОписательЦелиПрисвоения, ФлагТипаЦели, Значение)

				СсылкаНаЦелевуюПеременную = СсылкаНаПеременную(ВМПрисвоения, ОписательЦелиПрисвоения);
				СсылкаНаЦелевуюПеременную.Инициализирована = Истина;
				Если ФлагТипаЦели <> 2 Тогда
					Если ОписательЦелиПрисвоения.ИмяСвойства <> Неопределено Тогда
						ОписательЦелиПрисвоения.ЗначениеПредСвойства[ОписательЦелиПрисвоения.ИмяСвойства ] = Значение;
					Иначе
						СсылкаНаЦелевуюПеременную.Значение = Значение;
					КонецЕсли;

				Иначе
					Выполнить СсылкаНаЦелевуюПеременную.Имя + " = Значение";
				КонецЕсли;

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Функция КлючиПеременныхМодуля(МассивПеременныхМодуля )

				КартаПеременныхМодуля = Новый Соответствие;
				ИндексОбходаПеременных = 0;
				КоличествоПеременныхМодуля = МассивПеременныхМодуля.Количество();
				Пока ИндексОбходаПеременных < КоличествоПеременныхМодуля Цикл
					КартаПеременныхМодуля.Вставить(ВРег(МассивПеременныхМодуля[ИндексОбходаПеременных].Имя), ИндексОбходаПеременных);
					ИндексОбходаПеременных = ИндексОбходаПеременных + 1;
				КонецЦикла;

				Возврат КартаПеременныхМодуля;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Функция КлючиПодпрограмм(МассивПодпрограмм)

				КартаЛокальныхПодпрограмм = Новый Соответствие;
				Для Каждого ТекПодпрограммаКлючей Из МассивПодпрограмм Цикл
					Если ТекПодпрограммаКлючей.Флаг <> 32 И ТекПодпрограммаКлючей.Флаг <> 33 Тогда
						КартаЛокальныхПодпрограмм.Вставить(ВРег(ТекПодпрограммаКлючей.Имя), ТекПодпрограммаКлючей);
					КонецЕсли;

				КонецЦикла ;

				Возврат КартаЛокальныхПодпрограмм;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Функция ДанныеПодпрограммыИзКарты(КартаПодпрограмм, МассивПодпрограммДляЗаполнения)

				Для Каждого ТекПодпрограммаЗаполнения Из МассивПодпрограммДляЗаполнения Цикл
					НайденнаяПодпрограмма = КартаПодпрограмм[ВРег(ТекПодпрограммаЗаполнения.Имя)];
					Если НайденнаяПодпрограмма <> Неопределено Тогда
						ЗаполнитьЗначенияСвойств(ТекПодпрограммаЗаполнения, НайденнаяПодпрограмма );
					КонецЕсли;

				КонецЦикла;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Функция КонтекстВложенного(ОсновнаяВМ, РодительскаяВМ)

				КопияВМ = Новый Структура;
				Для Каждого ТекЭлементОсновнойВМ Из ОсновнаяВМ Цикл
					КопияВМ.Вставить(ТекЭлементОсновнойВМ.Ключ, ТекЭлементОсновнойВМ.Значение);
				КонецЦикла;

				КопияВМ.Вставить("Стек", Новый Массив);
				КопияВМ.Вставить("СтекВызовов", Новый Массив);
				КопияВМ.Вставить("СтекВременныхПеременных", Новый Массив);
				КопияВМ.Вставить("СтекПопыток", Новый Массив);
				КопияВМ.Вставить("КоличествоАргументов" , 0);
				КопияВМ.Вставить("НомерСтрокиОстанова", 0);
				КопияВМ.Вставить("ОстановленоПоОшибке", Ложь);
				КопияВМ.Вставить("ОписаниеОшибки", Неопределено);
				КопияВМ.Вставить("СчетчикБлоков", Неопределено);
				КопияВМ.Вставить("ИсходнаяВМ", РодительскаяВМ);
				КопияВМ.Вставить("ОсновнаяВМ", ОсновнаяВМ);
				Возврат КопияВМ ;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
			Процедура ПоложитьВСтек(ВМОперации, РезультатОперации, СтекОперации)

				СтекОперации.Удалить(0);
				СтекОперации.Удалить(0);
				СтекОперации.Вставить(0, Новый Структура("Значение,ИдентификаторВызова", РезультатОперации, ВМОперации.ИдентификаторВызова));

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Процедура СнимокКонтекста(ВМДляКопированияКонтекста , ВМ, ИндексФреймаСтека)

				ТекущийКонтекст = Новый Соответствие;
				Для Каждого ТекЭлементКопииКонтекста Из ВМ.ТекущийКонтекст Цикл
					ТекущийКонтекст.Вставить(ТекЭлементКопииКонтекста.Ключ, ТекЭлементКопииКонтекста.Значение);
				КонецЦикла;

				Для Каждого ТекПеременнаяКонтекста Из ВМ.Переменные Цикл
					Если ТекПеременнаяКонтекста.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяКонтекста.Имя, "0") И ТекущийКонтекст[ВРег(ТекПеременнаяКонтекста.Имя)] = Неопределено Тогда

						ОпределениеПеремКонтекста = Новый Структура("Адрес,ИдентификаторВызова,Флаг,Инициализирована,ЗначениеПредСвойства,ИмяСвойства" );
						ЗаполнитьЗначенияСвойств(ОпределениеПеремКонтекста, ТекПеременнаяКонтекста);
						ОпределениеПеремКонтекста.Вставить("ВМ", ВМ);
						ТекущийКонтекст.Вставить(ВРег(ТекПеременнаяКонтекста.Имя), ОпределениеПеремКонтекста);
					КонецЕсли;

				КонецЦикла;

				КоличествоФреймовВызовов = ВМ.СтекВызовов.Количество();
				Если КоличествоФреймовВызовов > 0 И ИндексФреймаСтека < КоличествоФреймовВызовов Тогда
					Для Каждого ТекПеременнаяКонтекста Из ВМ.СтекВызовов[ИндексФреймаСтека].Переменные Цикл
						Если ТекПеременнаяКонтекста.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяКонтекста.Имя, "0") Тогда

							ОпределениеПеремКонтекста = Новый Структура("Адрес,ИдентификаторВызова,Флаг,Инициализирована,ЗначениеПредСвойства,ИмяСвойства");
							ЗаполнитьЗначенияСвойств(ОпределениеПеремКонтекста, ТекПеременнаяКонтекста);
							ОпределениеПеремКонтекста.Вставить("ВМ", ВМ);
							ТекущийКонтекст.Вставить(ВРег(ТекПеременнаяКонтекста.Имя), ОпределениеПеремКонтекста);
						КонецЕсли;

					КонецЦикла;

				КонецЕсли;

				Для Каждого ТекПеременнаяКонтекста Из ВМДляКопированияКонтекста.Переменные Цикл
					ОпределениеПеремКонтекста = ТекущийКонтекст[ВРег(ТекПеременнаяКонтекста.Имя)];
					Если ОпределениеПеремКонтекста <> Неопределено Тогда
						ЗаполнитьЗначенияСвойств(ТекПеременнаяКонтекста, ОпределениеПеремКонтекста);
					КонецЕсли;

				КонецЦикла;

				ВМДляКопированияКонтекста.Вставить("ТекущийКонтекст", ТекущийКонтекст);

			КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
			Функция ОбновитьПеременныеКонтекста(ВМОбновления , АдресВМКонтекста, АдресКонтекстаОбновления, ИндексФреймаОбновления = 0)

				СобранныеПеременные = Новый Соответствие;
				ВсеПеременныеСериализуемы = Истина;
				Для Каждого ТекПеременнаяОбновления Из ВМОбновления.Переменные Цикл
					ПроверкаСериализуемости(ТекПеременнаяОбновления, ВМОбновления, ВсеПеременныеСериализуемы);
					Если ТекПеременнаяОбновления.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяОбновления.Имя, "0") Тогда
						СобранныеПеременные.Вставить(ТекПеременнаяОбновления.Имя, ТекПеременнаяОбновления.Значение);
					КонецЕсли;

				КонецЦикла;

				КоличествоФреймовОбновления = ВМОбновления.СтекВызовов.Количество();
				ИндексОбходаФреймов = 0;
				Пока ИндексОбходаФреймов < КоличествоФреймовОбновления Цикл
					Для Каждого ТекПеременнаяОбновления Из ВМОбновления.СтекВызовов[ИндексОбходаФреймов].Переменные Цикл
						ПроверкаСериализуемости(ТекПеременнаяОбновления, ВМОбновления, ВсеПеременныеСериализуемы);
						Если ИндексОбходаФреймов = ИндексФреймаОбновления И ИндексФреймаОбновления < КоличествоФреймовОбновления Тогда
							Если ТекПеременнаяОбновления.Инициализирована И Не СтрНачинаетсяС(ТекПеременнаяОбновления.Имя, "0") Тогда
								СобранныеПеременные.Вставить(ТекПеременнаяОбновления.Имя, Значение(ВМОбновления, ТекПеременнаяОбновления));
							КонецЕсли;

						КонецЕсли;

					КонецЦикла;

					ИндексОбходаФреймов = ИндексОбходаФреймов + 1;
				КонецЦикла;

				Если Не ВсеПеременныеСериализуемы Тогда
					Возврат Ложь;
				КонецЕсли;

				Если ТипЗнч(АдресВМКонтекста) = Тип("Строка") Тогда

					ДанныеКонтекстаОбновления = ПолучитьИзВременногоХранилища(АдресКонтекстаОбновления);
					ДанныеКонтекстаОбновления.Вставить("Переменные" , СобранныеПеременные);
					ПоместитьВоВременноеХранилище(ДанныеКонтекстаОбновления, АдресКонтекстаОбновления);
					ПоместитьВоВременноеХранилище(ВМОбновления, АдресВМКонтекста);
				Иначе

					ДанныеКонтекстаОбновления = АдресКонтекстаОбновления;
					ДанныеКонтекстаОбновления.Вставить("Переменные", СобранныеПеременные);
				КонецЕсли;

				Возврат Истина;

			КонецФункции

&НаКлиентеНаСервереБезКонтекста
