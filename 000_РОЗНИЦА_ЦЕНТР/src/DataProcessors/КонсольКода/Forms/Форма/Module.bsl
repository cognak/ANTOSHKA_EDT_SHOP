&НаКлиентеНаСервереБезКонтекста
Функция ИменаВстроенных()

	СоответствиеВстроенныхФункций = Новый Соответствие;
	ПолучитьКартуВстроенных = ПолучитьКартуВстроенных();
	Для Каждого ТекЭлемент6 Из ПолучитьКартуВстроенных Цикл
		Если ТипЗнч(ТекЭлемент6.Значение) = Тип("Структура") Тогда

			СоответствиеВстроенныхФункций.Вставить(ТекЭлемент6.Ключ, Новый Соответствие);
			СоответствиеВстроенныхФункций[ТекЭлемент6.Ключ].Вставить(ТекЭлемент6.Значение.КоличествоПараметров, ТекЭлемент6.Ключ);
			СоответствиеВстроенныхФункций.Вставить(ВРег(ТекЭлемент6.Значение.Имя), Новый Соответствие);
			СоответствиеВстроенныхФункций[ВРег(ТекЭлемент6.Значение.Имя)].Вставить(ТекЭлемент6.Значение.КоличествоПараметров, ТекЭлемент6.Ключ);
		Иначе
			Для Каждого ТекЭлемент7 Из ТекЭлемент6.Значение Цикл
				Если СоответствиеВстроенныхФункций[ТекЭлемент6.Ключ ] = Неопределено Тогда

					СоответствиеВстроенныхФункций.Вставить(ТекЭлемент6.Ключ, Новый Соответствие);
					СоответствиеВстроенныхФункций.Вставить(ВРег(ТекЭлемент7.Имя), Новый Соответствие);
				КонецЕсли;

				СоответствиеВстроенныхФункций [ТекЭлемент6.Ключ].Вставить(ТекЭлемент7.КоличествоПараметров, ТекЭлемент6.Ключ + "_" + Формат(ТекЭлемент7.Код, "ЧГ=0"));
				СоответствиеВстроенныхФункций[ВРег(ТекЭлемент7.Имя)].Вставить(ТекЭлемент7.КоличествоПараметров, ТекЭлемент6.Ключ + "_" + Формат(ТекЭлемент7.Код, "ЧГ=0"));
			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	Возврат СоответствиеВстроенныхФункций ;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбработатьОшибкуСинтаксиса(МассивТокенов, ПозицияВМассивеТокенов, ПропускаемыеТокены, ИсходныйКодДляОшибки)

	ИндексПоследнегоТокена = ПозицияВМассивеТокенов.Количество() - 1;
	ТекущийТокенОшибки = ПозицияВМассивеТокенов[ИндексПоследнегоТокена];
	Пока ИндексПоследнегоТокена > 0 Цикл
		ИндексПоследнегоТокена = ИндексПоследнегоТокена - 1;
		ТекущийТокенОшибки = ПозицияВМассивеТокенов[ИндексПоследнегоТокена];
		Если ПропускаемыеТокены[ТекущийТокенОшибки.Имя] = Неопределено Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	ДобавитьОшибкуТрансляции(МассивТокенов , НСтр("ru = 'Синтаксическая ошибка'; en = 'Syntax error'", ТекущийЯзыкСистемы()), ИсходныйКодДляОшибки, ТекущийТокенОшибки)

