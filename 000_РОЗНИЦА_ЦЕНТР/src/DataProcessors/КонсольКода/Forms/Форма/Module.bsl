Функция ВалидацияСтроки(СтрокаДляВалидации)

	ДлинаПроверяемойСтроки = СтрДлина(СтрокаДляВалидации );
	Если ДлинаПроверяемойСтроки = 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	БалансКавычек = Ложь;
	Пока ДлинаПроверяемойСтроки > 1 Цикл
		ТекСимвол = Сред(СтрокаДляВалидации, ДлинаПроверяемойСтроки , 1);
		Если ТекСимвол = """" Тогда
			БалансКавычек = Не БалансКавычек;
		Иначе
			Прервать;
		КонецЕсли;

		ДлинаПроверяемойСтроки = ДлинаПроверяемойСтроки - 1;
	КонецЦикла;

	Возврат БалансКавычек;

