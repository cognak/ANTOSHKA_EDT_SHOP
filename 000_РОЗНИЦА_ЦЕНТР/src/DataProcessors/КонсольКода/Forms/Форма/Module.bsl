Процедура ПредставлениеСтека(ВМДляПредставления, ДанныеПредставленияОтладки)

	ПредставлениеСтекаВызовов = Новый Массив;
	КэшНомеровСтрокВызовов = Новый Соответствие ;
	Для Каждого ТекФреймВызова Из ВМДляПредставления.СтекВызовов Цикл
		ФреймСтекаВызовов = Новый Структура("Строка,Название", НомерСтрокиИнструкции(КэшНомеровСтрокВызовов, ТекФреймВызова.ТочкаВызова, ВМДляПредставления));
		ПредставлениеСтекаВызовов.Добавить(ФреймСтекаВызовов);
	КонецЦикла;

	Если ПредставлениеСтекаВызовов.Количество() > 0 Тогда

		ФреймСтекаВызовов = Новый Структура("Строка,Название", НомерСтрокиИнструкции(КэшНомеровСтрокВызовов, ВМДляПредставления.ТекущаяКоманда, ВМДляПредставления));
		ПредставлениеСтекаВызовов.Вставить(0, ФреймСтекаВызовов );
		ПредставлениеСтекаВызовов[ПредставлениеСтекаВызовов.Количество() - 1].Название = НСтр("ru='<Основной модуль консоли кода>';en='<Main code console module>'", ТекущийЯзыкСистемы());
		ИндексОбходаСтека = 0;
		Для Каждого ТекФреймВызова Из ВМДляПредставления.СтекВызовов Цикл
			ПредставлениеСтекаВызовов[ИндексОбходаСтека].Название = НазваниеФрейма(ТекФреймВызова, ВМДляПредставления);
			ИндексОбходаСтека = ИндексОбходаСтека + 1;
		КонецЦикла;

	КонецЕсли;

	ДанныеПредставленияОтладки.Вставить("ПредставлениеСтекаВызовов", ПредставлениеСтекаВызовов);

КонецПроцедуры

