	Если СтрДлина(СтрокаДляОбрезки) > МаксДлина Тогда
		ТекСимвол = Сред(СтрокаДляОбрезки, 1, МаксДлина - 3) + "..." ;
	КонецЕсли;

	Возврат ТекСимвол;

