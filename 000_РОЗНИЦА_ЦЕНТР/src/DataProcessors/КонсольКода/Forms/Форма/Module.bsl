			Сообщение = НСтр("ru='Не удалось остановиться в строке ';en='It was not possible to stop in the line '" , ТекущийЯзыкСистемы()) + ВМДляПроверки.НомерСтрокиОстанова + НСтр("ru=' т.к. на момент останова существует переменная, которую не удается поместить во временное хранилище (';en=' because at the time of stopping there is a variable that cannot be placed in temporary storage ('" , ТекущийЯзыкСистемы());
			ВМДляПроверки.Ошибки.Добавить(Новый Структура("Тип,Название,Строка", 2, Сообщение + ПроверяемаяПеременная.Имя + ")", ВМДляПроверки.НомерСтрокиОстанова ));
