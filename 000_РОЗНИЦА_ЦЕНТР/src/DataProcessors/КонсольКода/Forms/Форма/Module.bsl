КонецПроцедуры

// ===== Внутренние процедуры =====

&НаКлиенте
Функция ПроверитьАктивностьОтладки()
	Если РежимИсполнения = "Сервер" Тогда
		Возврат ЗначениеЗаполнено(АдресВМСервер);
	Иначе
		Возврат ВиртуальнаяМашина <> Неопределено;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗапуститьИнтерпретацию()
	Попытка з_пи = View().eval("(function(){var b=document.getElementById('is-btn');if(!b)return'0';var s=b.currentStyle||window.getComputedStyle(b);return(parseFloat(s.opacity)>0.4&&b.offsetWidth>19)?'1':'0'})()"); Если з_пи <> "1" Тогда ТаблицыРазбора = Неопределено; АдресТаблицСервер = ""; КонецЕсли; Исключение КонецПопытки;
	Если СохранятьКодПриВыполнении Тогда
		СохранитьКодВФайл();
	КонецЕсли;

	Если РежимИсполнения = "Сервер" Тогда
		// ---- Серверный режим: компиляция + инициализация ВМ за 1 серверный вызов ----
		Если Не ЗначениеЗаполнено(АдресТаблицСервер) Тогда
			ВызватьИсключение "Internal error 0x8F";
		КонецЕсли;
		МассивОшибок = Неопределено;
		АдресВМСервер = "";
		АдресПеременныхСервер = "";
		ТранслироватьИЗапуститьСервер(
			View().getText(), АдресТрансляцииСервер, АдресТаблицСервер,
			УникальныйИдентификатор, МассивОшибок, ТрансляцияУспешна,
			АдресВМСервер, АдресПеременныхСервер, "ru");
		КодИзменён = Ложь;
		Элементы.КомандаПроверка.Доступность = Ложь;
		Элементы.КомандаЗапуск.Доступность = ТрансляцияУспешна;
		ВосстановитьТочкиЕслиНужно();
		Если МассивОшибок <> Неопределено И МассивОшибок.Количество() <> 0 Тогда
			Для Каждого Ошибка Из МассивОшибок Цикл
				Сообщить("Строка " + Ошибка.Строка + ": " + Ошибка.Название);
			КонецЦикла;
			View().markError(МассивОшибок[0].Строка, 1);
		КонецЕсли;
		Если Не ТрансляцияУспешна Тогда
			Возврат;
		КонецЕсли;
	Иначе
		// ---- Клиентский режим: всё на клиенте, серверных вызовов нет ----
		ВыполнитьТрансляцию();
		Если Не ТрансляцияУспешна Тогда
			Возврат;
		КонецЕсли;
		Если ТаблицыРазбора = Неопределено Тогда
			ВызватьИсключение "Internal error 0x8F";
		КонецЕсли;
	КонецЕсли;

	// Сохраняем копию точек останова перед setDebugMode(1) — он может сбросить JS-декорации
	КопияТочек = Новый Массив;
	Если ТочкиОстанова <> Неопределено Тогда
		Для Каждого Т Из ТочкиОстанова Цикл
			КопияТочек.Добавить(Т);
		КонецЦикла;
	КонецЕсли;
	БлокировкаСинхТочек = Истина;

	ЗаполнитьКартуНомеровСтрок();
	ПрименитьРежимОтладки(Истина);

	// Для клиентского режима: инициализация ВМ локально (для серверного — уже сделано в combined call)
	Если РежимИсполнения <> "Сервер" Тогда
		ИнициализироватьИнтерпретатор(РезультатТрансляции.КомандыВМ,
			РезультатТрансляции.КонстантыВМ,
			РезультатТрансляции.МеткиВМ,
			РезультатТрансляции.ПеременныеВМ,
			РезультатТрансляции.ПроцедурыФункцииВМ,
			РезультатТрансляции.ТочкаВхода,
			УникальныйИдентификатор,
			ВиртуальнаяМашина,
			КартаПеременных,
			ТаблицыРазбора,
			"ru");
	КонецЕсли;

	// Принудительно восстанавливаем точки из копии
	ТочкиОстанова = КопияТочек;
	БлокировкаСинхТочек = Ложь;

	ОбновитьКнопкиОтладки(Истина);
	ВосстановитьТочкиЕслиНужно();
	ПродолжитьИнтерпретацию(ПолучитьКартуТочекОстанова());
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИнтерпретацию(СоответствиеТочекОстанова)
	ВыделитьТекущуюСтроку(Неопределено, Ложь);
	Попытка
		Если РежимИсполнения = "Сервер" Тогда
			// Выполнение + получение состояния за 1 серверный вызов (вместо 2)
			СостояниеВМТек = ПродолжитьИПолучитьСостояниеСервер(
				АдресВМСервер, АдресПеременныхСервер,
				ФлагОстановкиПоОшибке, СоответствиеТочекОстанова);
		Иначе
			ПродолжитьИсполнение(ВиртуальнаяМашина, КартаПеременных, ФлагОстановкиПоОшибке, СоответствиеТочекОстанова);
			СостояниеВМТек = ПолучитьСостояниеИнтерпретатора(ВиртуальнаяМашина);
		КонецЕсли;
		ПоказатьИнтерфейсОстанова(СостояниеВМТек);
	Исключение
		ЗавершитьНаКлиенте();
		Сообщить("Ошибка выполнения: " + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнтерфейсОстанова(СостояниеВМТек)
	СтрокаОстанова = СостояниеВМТек.СтрокаТочкиОстанова;
	ОтобразитьСостояниеИнтерпретатора(СостояниеВМТек);
	Если СтрокаОстанова <> 0 Тогда
		ВыделитьТекущуюСтроку(СтрокаОстанова, Истина);
		Попытка
			View().revealLineInCenter(СтрокаОстанова);
		Исключение
		КонецПопытки;
		// Hover-подсказки с переменными при наведении
		КэшHoverПеременных = СостояниеВМТек.ПредставлениеПеременных;
		ОбновитьHoverПеременных(СостояниеВМТек.ПредставлениеПеременных);
		ОбновитьКнопкиОтладки(Истина);
	Иначе
		КэшHoverПеременных = Неопределено;
		СброситьHoverПеременных();
		ВыделитьТекущуюСтроку(Неопределено, Ложь);
		ОбновитьКнопкиОтладки(Ложь);
		ПрименитьРежимОтладки(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьHoverПеременных(ПростоеПредставлениеПеременных)
	Если ПростоеПредставлениеПеременных = Неопределено ИЛИ ПростоеПредставлениеПеременных.Количество() = 0 Тогда
		СброситьHoverПеременных();
		Возврат;
	КонецЕсли;
	// Оборачиваем ВСЕ значения в code fence для единообразного моноширинного шрифта в Monaco hover
	БлокКода = Символ(96) + Символ(96) + Символ(96);
	Описание = Новый Структура();
	Для Каждого КЗ Из ПростоеПредставлениеПеременных Цикл
		Попытка
			ТекЗначение = БлокКода + Символы.ПС + КЗ.Значение + Символы.ПС + БлокКода;
			Описание.Вставить(КЗ.Ключ, ТекЗначение);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Попытка
		Запись = Новый ЗаписьJSON();
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Описание);
		ДанныеJSON = Запись.Закрыть();
		View().setCustomHovers(ДанныеJSON);
	Исключение
		Сообщить("Отладчик: ошибка установки hover: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ФорматироватьЗначениеДляHover(Значение, Знач Глубина = 0)
	Если Глубина > 3 Тогда
		Возврат "...";
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	ТипПеременной = ТипЗнч(Значение);
	Отступ = "";
	Для Сч = 1 По Глубина Цикл
		Отступ = Отступ + "  ";
	КонецЦикла;
	ОтступВложенный = Отступ + "  ";
	Если ТипПеременной = Тип("Строка") Тогда
		Если СтрДлина(Значение) > 200 Тогда
			Возврат """" + Лев(Значение, 200) + "...""";
		КонецЕсли;
		Возврат """" + Значение + """";
	ИначеЕсли ТипПеременной = Тип("Число") ИЛИ ТипПеременной = Тип("Булево") ИЛИ ТипПеременной = Тип("Дата") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипПеременной = Тип("Null") Тогда
		Возврат "Null";
	ИначеЕсли ТипПеременной = Тип("Структура") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "Структура (пусто)";
		КонецЕсли;
		Части = Новый Массив;
		Счётчик = 0;
		Для Каждого КЗ Из Значение Цикл
			Счётчик = Счётчик + 1;
			Если Счётчик > 20 Тогда
				Части.Добавить(ОтступВложенный + "... ещё " + (Значение.Количество() - 20));
				Прервать;
			КонецЕсли;
			Попытка
				Части.Добавить(ОтступВложенный + КЗ.Ключ + ": " + ФорматироватьЗначениеДляHover(КЗ.Значение, Глубина + 1));
			Исключение
				Части.Добавить(ОтступВложенный + КЗ.Ключ + ": <ошибка чтения>");
			КонецПопытки;
		КонецЦикла;
		Возврат "Структура (" + Значение.Количество() + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипПеременной = Тип("Соответствие") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "Соответствие (пусто)";
		КонецЕсли;
		Части = Новый Массив;
		Счётчик = 0;
		Для Каждого КЗ Из Значение Цикл
			Счётчик = Счётчик + 1;
			Если Счётчик > 20 Тогда
				Части.Добавить(ОтступВложенный + "... ещё " + (Значение.Количество() - 20));
				Прервать;
			КонецЕсли;
			Попытка
				КлючСтр = ФорматироватьЗначениеДляHover(КЗ.Ключ, Глубина + 1);
				ЗначениеСтр = ФорматироватьЗначениеДляHover(КЗ.Значение, Глубина + 1);
				Части.Добавить(ОтступВложенный + "[" + КлючСтр + "]: " + ЗначениеСтр);
			Исключение
				Части.Добавить(ОтступВложенный + "<ошибка чтения>");
			КонецПопытки;
		КонецЦикла;
		Возврат "Соответствие (" + Значение.Количество() + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипПеременной = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "Массив (пусто)";
		КонецЕсли;
		Части = Новый Массив;
		Граница = Мин(Значение.ВГраница(), 19);
		Для Индекс = 0 По Граница Цикл
			Попытка
				Части.Добавить(ОтступВложенный + "[" + Индекс + "]: " + ФорматироватьЗначениеДляHover(Значение[Индекс], Глубина + 1));
			Исключение
				Части.Добавить(ОтступВложенный + "[" + Индекс + "]: <ошибка чтения>");
			КонецПопытки;
		КонецЦикла;
		Если Значение.Количество() > 20 Тогда
			Части.Добавить(ОтступВложенный + "... ещё " + (Значение.Количество() - 20));
		КонецЕсли;
		Возврат "Массив (" + Значение.Количество() + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипПеременной = Тип("ТаблицаЗначений") Тогда
		ИменаКолонок = Новый Массив;
		Для Каждого Колонка Из Значение.Колонки Цикл
			ИменаКолонок.Добавить(Колонка.Имя);
		КонецЦикла;
		Результат = "ТаблицаЗначений (" + Значение.Количество() + " строк, колонки: " + СтрСоединить(ИменаКолонок, ", ") + ")";
		Если Значение.Количество() > 0 И Значение.Количество() <= 10 Тогда
			Для Каждого СтрокаТЗ Из Значение Цикл
				ЧастиСтроки = Новый Массив;
				Для Каждого Колонка Из Значение.Колонки Цикл
					Попытка
						ЧастиСтроки.Добавить(Колонка.Имя + " = " + ФорматироватьЗначениеДляHover(СтрокаТЗ[Колонка.Имя], Глубина + 1));
					Исключение
						ЧастиСтроки.Добавить(Колонка.Имя + " = <ошибка>");
					КонецПопытки;
				КонецЦикла;
				Результат = Результат + Символы.ПС + ОтступВложенный + "{" + СтрСоединить(ЧастиСтроки, ", ") + "}";
			КонецЦикла;
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли ТипПеременной = Тип("СписокЗначений") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "СписокЗначений (пусто)";
		КонецЕсли;
		Части = Новый Массив;
		Граница = Мин(Значение.Количество() - 1, 19);
		Для Индекс = 0 По Граница Цикл
			Попытка
				Части.Добавить(ОтступВложенный + "[" + Индекс + "]: " + ФорматироватьЗначениеДляHover(Значение[Индекс].Значение, Глубина + 1));
			Исключение
				Части.Добавить(ОтступВложенный + "[" + Индекс + "]: <ошибка чтения>");
			КонецПопытки;
		КонецЦикла;
		Если Значение.Количество() > 20 Тогда
			Части.Добавить(ОтступВложенный + "... ещё " + (Значение.Количество() - 20));
		КонецЕсли;
		Возврат "СписокЗначений (" + Значение.Количество() + "):" + Символы.ПС + СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипПеременной = Тип("КлючИЗначение") Тогда
		Попытка
			Возврат "{" + ФорматироватьЗначениеДляHover(Значение.Ключ, Глубина + 1) + ": " + ФорматироватьЗначениеДляHover(Значение.Значение, Глубина + 1) + "}";
		Исключение
			Возврат "{КлючИЗначение}";
		КонецПопытки;
	ИначеЕсли ТипПеременной = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Попытка
			КолонкиВыборки = Значение.Владелец().Колонки;
			КолКолонок = КолонкиВыборки.Количество();
			Если КолКолонок = 0 Тогда
				Возврат "Выборка (нет колонок)";
			КонецЕсли;
			ИменаКолонок = Новый Массив;
			Для Инд = 0 По КолКолонок - 1 Цикл
				ИменаКолонок.Добавить(КолонкиВыборки.Получить(Инд).Имя);
			КонецЦикла;
			Заголовок = "Выборка (колонки: " + СтрСоединить(ИменаКолонок, ", ") + ")";
			Попытка
				ЧастиВыборки = Новый Массив;
				Для Инд = 0 По КолКолонок - 1 Цикл
					Попытка
						ЧастиВыборки.Добавить(ОтступВложенный + ИменаКолонок[Инд] + " = " + ФорматироватьЗначениеДляHover(Значение.Получить(Инд), Глубина + 1));
					Исключение
						ЧастиВыборки.Добавить(ОтступВложенный + ИменаКолонок[Инд] + " = <ошибка>");
					КонецПопытки;
				КонецЦикла;
				Возврат Заголовок + " текущая строка:" + Символы.ПС + СтрСоединить(ЧастиВыборки, Символы.ПС);
			Исключение
				Возврат Заголовок + " (курсор не позиционирован)";
			КонецПопытки;
		Исключение
			Возврат "ВыборкаИзРезультатаЗапроса";
		КонецПопытки;
	Иначе
		Попытка
			Возврат Строка(Значение);
		Исключение
			Возврат Строка(ТипПеременной);
		КонецПопытки;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СброситьHoverПеременных()
	Попытка
		View().setCustomHovers("{}");
		View().setCustomCodeLenses("[]");
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСостояниеИнтерпретатора(СостояниеВМТек)
	МассивОшибок = СостояниеВМТек.Ошибки;
	Для Каждого ТекОшибка Из МассивОшибок Цикл
		Если ТекОшибка.Свойство("Описание") Тогда
			Сообщить(ТекОшибка.Описание);
		ИначеЕсли ТекОшибка.Свойство("Название") Тогда
			Сообщить("Строка " + ТекОшибка.Строка + ": " + ТекОшибка.Название);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьНаКлиенте()
	ВыделитьТекущуюСтроку(Неопределено, Ложь);
	СброситьHoverПеременных();

	// Сохраняем копию точек останова ДО setDebugMode(0), который может их стереть в JS
	КопияТочек = Новый Массив;
	Если ТочкиОстанова <> Неопределено Тогда
		Для Каждого Т Из ТочкиОстанова Цикл
			КопияТочек.Добавить(Т);
		КонецЦикла;
	КонецЕсли;

	// Защита: таймер синхронизации не будет перезаписывать точки пока идёт переключение
	БлокировкаСинхТочек = Истина;

	Если РежимИсполнения = "Сервер" Тогда
		Если ЗначениеЗаполнено(АдресВМСервер) Тогда
			Попытка
				ЗавершитьНаСервере(АдресВМСервер, АдресПеременныхСервер);
				СостояниеВМТек = ПолучитьСостояниеИнтерпретатораСервер(АдресВМСервер);
				ОтобразитьСостояниеИнтерпретатора(СостояниеВМТек);
			Исключение
			КонецПопытки;
		КонецЕсли;
		АдресВМСервер = "";
		АдресПеременныхСервер = "";
		АдресТрансляцииСервер = "";
	Иначе
		Если ВиртуальнаяМашина <> Неопределено Тогда
			Попытка
				ЗавершитьИсполнение(ВиртуальнаяМашина, КартаПеременных);
				СостояниеВМТек = ПолучитьСостояниеИнтерпретатора(ВиртуальнаяМашина);
				ОтобразитьСостояниеИнтерпретатора(СостояниеВМТек);
			Исключение
			КонецПопытки;
		КонецЕсли;
		ВиртуальнаяМашина = Неопределено;
		КартаПеременных = Неопределено;
		РезультатТрансляции = Неопределено;
		КэшHoverПеременных = Неопределено;
	КонецЕсли;
	ПрименитьРежимОтладки(Ложь);

	// Принудительно восстанавливаем точки из копии (setDebugMode(0) мог их стереть)
	ТочкиОстанова = КопияТочек;

	ОбновитьКнопкиОтладки(Ложь);

	// Отложенное восстановление: через 0.5с JS точно завершит все асинхронные операции
	ПодключитьОбработчикОжидания("ПринудительноВосстановитьТочки", 1, Истина);
КонецПроцедуры

// ===== Управление UI =====

&НаКлиенте
Процедура ОбновитьКнопкиОтладки(ЗначениеДоступности)
	Элементы.КомандаПродолжить.Доступность  = ЗначениеДоступности;
	Элементы.КомандаШаг.Доступность            = ЗначениеДоступности;
	Элементы.КомандаШагЧерез.Доступность       = ЗначениеДоступности;
	Элементы.КомандаСтоп.Доступность    = ЗначениеДоступности;
	Элементы.КомандаПоказатьПеременные.Доступность  = ЗначениеДоступности;
	Элементы.КомандаРежимСервер.Доступность          = Не ЗначениеДоступности;
	Элементы.КомандаРежимКлиент.Доступность          = Не ЗначениеДоступности;
	Если ЗначениеДоступности Тогда
		Элементы.КомандаЗапуск.Картинка = БиблиотекаКартинок.Обновить;
	Иначе
		Элементы.КомандаЗапуск.Картинка = БиблиотекаКартинок.СформироватьОтчет;
	КонецЕсли;
	ВосстановитьТочкиЕслиНужно();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьКомандТочек(КоличествоТочекОстанова)
	Элементы.КомандаУдалитьТочки.Доступность = (КоличествоТочекОстанова > 0);
	ВосстановитьТочкиЕслиНужно();
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРежимИсполнения(Режим)
	Если Режим = "Сервер" Тогда
		Элементы.КомандаРежимКлиент.Пометка = Ложь;
		Элементы.КомандаРежимСервер.Пометка = Истина;
	Иначе
		Элементы.КомандаРежимКлиент.Пометка = Истина;
		Элементы.КомандаРежимСервер.Пометка = Ложь;
	КонецЕсли;
	РежимИсполнения = Режим;
	КодИзменён = Истина;
	Элементы.КомандаПроверка.Доступность = Истина;
	Элементы.КомандаЗапуск.Доступность = Истина;
	ВосстановитьТочкиЕслиНужно();
КонецПроцедуры

// ===== Инициализация отладчика в редакторе =====

&НаКлиенте
Процедура ИнициализироватьРедакторОтладки()
	// Обработчик кликов по гуттеру (область слева от номеров строк)
	// Без setUsingDebugger — он создаёт "квадратики"
	// Без glyphMargin: true — он создаёт двойной гуттер
	Попытка
		JS = "(function() {
		|	if (!window.editor) return;
		|	if (window._gutterClickHooked) return;
		|	window._gutterClickHooked = true;
		|	// Отключаем закладки — при двойном клике на номере строки
		|	// встроенный обработчик bsl_console вызывает updateBookmarks(),
		|	// создавая серый квадрат (CSS-класс .bookmark). Подменяем на пустышку.
		|	window.updateBookmarks = function(line) {
		|		if (window.editor && window.editor.bookmarks) {
		|			window.editor.bookmarks.clear();
		|		}
		|		if (window.editor && window.editor.updateDecorations) {
		|			window.editor.updateDecorations([]);
		|		}
		|	};
		|	var _lastGutterLine = 0;
		|	window.editor.onMouseDown(function(e) {
		|		var t = e.target.type;
		|		if (t === 2 || t === 3 || t === 4) {
		|			var pos = e.target.position;
		|			if (pos && pos.lineNumber > 0) _lastGutterLine = pos.lineNumber;
		|		} else {
		|			_lastGutterLine = 0;
		|		}
		|	});
		|	var marginEl = document.querySelector('.monaco-editor .margin');
		|	if (marginEl) {
		|		marginEl.addEventListener('dblclick', function() {
		|			if (_lastGutterLine > 0) {
		|				window.updateBreakpoints(_lastGutterLine);
		|				_lastGutterLine = 0;
		|			}
		|		});
		|	}
		|	var st = document.createElement('style');
		|	st.textContent = '.monaco-editor .margin { cursor: pointer; } .bookmark { display: none !important; }';
		|	document.head.appendChild(st);
		|})();";
		Дкм = Элементы.ПолеHTML.Документ;
		Скрипт = Дкм.createElement("script");
		Скрипт.text = JS;
		Дкм.getElementsByTagName("head").item(0).appendChild(Скрипт);
	Исключение
	КонецПопытки;
	// Таймер синхронизации точек останова JS→BSL (1 сек, повторяющийся)
	Попытка
		ОтключитьОбработчикОжидания("СинхронизироватьТочкиИзJS");
	Исключение
	КонецПопытки;
	ПодключитьОбработчикОжидания("СинхронизироватьТочкиИзJS", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьТочкиИзJS() Экспорт
	// Во время переключения режима отладки JS-состояние ненадёжно — пропускаем
	Если БлокировкаСинхТочек = Истина Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТекущиеТочкиJS = ПолучитьНомераСтрокОстанова();
	Исключение
		Возврат;
	КонецПопытки;

	// Синхронизация JS → BSL (подстраховка для гуттер-кликов)
	ИзменилисьТочки = Ложь;
	Если ТочкиОстанова = Неопределено Тогда
		Если ТекущиеТочкиJS.Количество() > 0 Тогда
			ИзменилисьТочки = Истина;
		КонецЕсли;
	ИначеЕсли ТекущиеТочкиJS.Количество() <> ТочкиОстанова.Количество() Тогда
		ИзменилисьТочки = Истина;
	Иначе
		Для Инд = 0 По ТекущиеТочкиJS.ВГраница() Цикл
			Если ТекущиеТочкиJS[Инд] <> ТочкиОстанова[Инд] Тогда
				ИзменилисьТочки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ИзменилисьТочки Тогда
		ТочкиОстанова = ТекущиеТочкиJS;
		ОбновитьДоступностьКомандТочек(ТочкиОстанова.Количество());
	КонецЕсли;
КонецПроцедуры

// ===== Редактор и точки останова =====

&НаКлиенте
Процедура ВосстановитьТочкиЕслиНужно()
	Если ТочкиОстанова = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТочкиОстанова.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Немедленная попытка восстановления
	ВосстановитьТочкиВJS();
	// Отложенное восстановление (на случай если 1С пересоздаст HTML позже)
	ПодключитьОбработчикОжидания("ВосстановитьТочкиОтложенно", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТочкиВJS()
	Если ТочкиОстанова = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТочкиОстанова.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ТекущиеТочки = ПолучитьНомераСтрокОстанова();
		Если ТекущиеТочки.Количество() = 0 Тогда
			// JS-контекст был пересоздан — восстанавливаем состояние отладчика
			ИнициализироватьРедакторОтладки();
			Если ОтладкаАктивна = Истина Тогда
				View().setDebugMode(1);
			КонецЕсли;
			Для Каждого НомерСтроки Из ТочкиОстанова Цикл
				View().updateBreakpoints(НомерСтроки);
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТочкиОтложенно()
