	СостояниеВМ.Вставить("КлючиЛокальныхПодпрограмм", ?(ИсходнаяВМ = Неопределено, КлючиПодпрограмм(Подпрограммы), ИсходнаяВМ.КлючиЛокальныхПодпрограмм));
	СостояниеВМ.Вставить("ТекущийКонтекст", Новый Соответствие);
