&НаСервере
Функция ПредставлениеЗначения(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Т = ТипЗнч(Значение);
	Если Т = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли Т = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=ДВ");
	ИначеЕсли Т = Тип("ТаблицаЗначений") Тогда
		Возврат "ТаблицаЗначений (" + Значение.Количество() + " строк)";
	ИначеЕсли Т = Тип("Массив") ИЛИ Т = Тип("ФиксированныйМассив") Тогда
		Возврат "Массив (" + Значение.Количество() + ")";
	ИначеЕсли Т = Тип("Структура") ИЛИ Т = Тип("ФиксированнаяСтруктура") Тогда
		Возврат "Структура (" + Значение.Количество() + ")";
	ИначеЕсли Т = Тип("Соответствие") ИЛИ Т = Тип("ФиксированноеСоответствие") Тогда
		Возврат "Соответствие (" + Значение.Количество() + ")";
	ИначеЕсли Т = Тип("СписокЗначений") Тогда
		Возврат "СписокЗначений (" + Значение.Количество() + ")";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

