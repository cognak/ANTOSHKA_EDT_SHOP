
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ИмяПеременной") Тогда
		ИмяПеременной = Параметры.ИмяПеременной;
	КонецЕсли;

	Если Параметры.Свойство("Тип") Тогда
		Заголовок = Параметры.Тип;
	ИначеЕсли ЗначениеЗаполнено(ИмяПеременной) Тогда
		Заголовок = ИмяПеременной;
	КонецЕсли;

	Если Параметры.Свойство("КоличествоЭлементов") Тогда
		КоличествоЭлементов = Параметры.КоличествоЭлементов;
	КонецЕсли;

	Если Параметры.Свойство("АдресЗначения") И ЗначениеЗаполнено(Параметры.АдресЗначения) Тогда
		Адрес = Параметры.АдресЗначения;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("СформироватьОтображениеКоллекции", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// Резерв
КонецПроцедуры

#КонецОбласти

#Область Обработчики_команд

&НаКлиенте
Процедура ПоказатьОтдельно(Команда)
	ОткрытьВложенныйЭлемент();
КонецПроцедуры

#КонецОбласти

#Область Обработчики_элементов_формы

&НаКлиенте
Процедура ТаблицаКоллекцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьВложенныйЭлемент();
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура СформироватьОтображениеКоллекции() Экспорт

	Попытка
		СформироватьТаблицуНаСервере();
	Исключение
		Сообщить("Ошибка формирования отображения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Элементы.СтраницыОтображениеКоллекции.ТекущаяСтраница = Элементы.СтраницаТаблица;
	Элементы.ПоказатьОтдельно.Видимость = Истина;

КонецПроцедуры

// Открытие вложенного элемента по двойному клику или кнопке
&НаКлиенте
Процедура ОткрытьВложенныйЭлемент()

	ТекДанные = Элементы.ТаблицаКоллекции.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Индекс = ТекДанные.НомерСтроки;
	Результат = ПолучитьВложенноеЗначениеНаСервере(Адрес, Индекс, РежимРаботы, УникальныйИдентификатор);

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.ЭтоКоллекция Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресЗначения",       Результат.АдресЗначения);
		ПараметрыФормы.Вставить("Тип",                 Результат.ТипЗначения);
		ПараметрыФормы.Вставить("КоличествоЭлементов", Результат.КоличествоЭлементов);
		ОткрытьФорму("ВнешняяОбработка.КонсольКода.Форма.ФормаСодержимогоКоллекции",
			ПараметрыФормы, ЭтаФорма, Новый УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ПоказатьПредупреждение(, Результат.ТипЗначения + ": " + Результат.ТекстЗначения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СформироватьТаблицуНаСервере()

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат;
	КонецЕсли;

	ЗначениеКоллекции = ПолучитьИзВременногоХранилища(Адрес);

	Если ЗначениеКоллекции = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипЗначения = ТипЗнч(ЗначениеКоллекции);

	// Запоминаем тип коллекции для drill-down
	МассивСодержитСтрокиТЗ = Ложь;
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		РежимРаботы = "ТЗ";
	ИначеЕсли ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		// Проверяем: если массив содержит СтрокаТаблицыЗначений — показываем как таблицу с колонками
		Если ЗначениеКоллекции.Количество() > 0 И ТипЗнч(ЗначениеКоллекции[0]) = Тип("СтрокаТаблицыЗначений") Тогда
			МассивСодержитСтрокиТЗ = Истина;
			РежимРаботы = "МасСтрокТЗ";
		Иначе
			РежимРаботы = "Мас";
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		РежимРаботы = "Стр";
	ИначеЕсли ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		РежимРаботы = "Соот";
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		РежимРаботы = "Спис";
	КонецЕсли;

	ИмяТаблицы = "ТаблицаКоллекции";

	// Реквизиты для динамической таблицы
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяТаблицы, Новый ОписаниеТипов("ТаблицаЗначений"), "", ""));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НомерСтроки", Новый ОписаниеТипов("Число"), ИмяТаблицы, НСтр("ru = '№'")));

	ИменаКолонок = Новый Массив;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Для Каждого Колонка Из ЗначениеКоллекции.Колонки Цикл
			ИмяРеквизита = "_" + Колонка.Имя;
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка"), ИмяТаблицы, Колонка.Имя));
			ИменаКолонок.Добавить(ИмяРеквизита);
		КонецЦикла;

	ИначеЕсли МассивСодержитСтрокиТЗ Тогда
		// Массив строк ТЗ — колонки берём из таблицы-владельца
		Попытка
			КолонкиТЗ = ЗначениеКоллекции[0].Владелец().Колонки;
			Для Каждого Колонка Из КолонкиТЗ Цикл
				ИмяРеквизита = "_" + Колонка.Имя;
				ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка"), ИмяТаблицы, Колонка.Имя));
				ИменаКолонок.Добавить(ИмяРеквизита);
			КонецЦикла;
		Исключение
			// Если Владелец() недоступен — показываем как обычный массив
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолЗначение",   Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Значение'")));
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолТипЗначения", Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Тип'")));
			ИменаКолонок.Добавить("КолЗначение");
			ИменаКолонок.Добавить("КолТипЗначения");
			МассивСодержитСтрокиТЗ = Ложь;
			РежимРаботы = "Мас";
		КонецПопытки;

	ИначеЕсли ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолКлюч",       Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Ключ'")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолЗначение",   Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Значение'")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолТипЗначения", Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Тип'")));
		ИменаКолонок.Добавить("КолКлюч");
		ИменаКолонок.Добавить("КолЗначение");
		ИменаКолонок.Добавить("КолТипЗначения");

	Иначе
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолЗначение",   Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Значение'")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолТипЗначения", Новый ОписаниеТипов("Строка"), ИмяТаблицы, НСтр("ru = 'Тип'")));
		ИменаКолонок.Добавить("КолЗначение");
		ИменаКолонок.Добавить("КолТипЗначения");

	КонецЕсли;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	// Создаём элемент таблицы на форме
	ТаблицаФормы                           = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), Элементы.СтраницаТаблица);
	ТаблицаФормы.ПутьКДанным               = ИмяТаблицы;
	ТаблицаФормы.ТолькоПросмотр            = Истина;
	ТаблицаФормы.КоманднаяПанель.Видимость = Ложь;

	// Двойной клик — открытие вложенного значения
	ТаблицаФормы.УстановитьДействие("Выбор", "ТаблицаКоллекцииВыбор");

	// Колонка номера строки
	ДобавитьКолонкуВТаблицу("НомерСтроки", ТаблицаФормы, ИмяТаблицы);
	Элементы["НомерСтроки"].Формат                  = "ЧН=0; ЧГ=0";
	Элементы["НомерСтроки"].Ширина                   = 3;
	Элементы["НомерСтроки"].АвтоМаксимальнаяШирина   = Ложь;
	Элементы["НомерСтроки"].МаксимальнаяШирина        = 4;

	// Колонки данных
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ДобавитьКолонкуВТаблицу(ИмяКолонки, ТаблицаФормы, ИмяТаблицы);
	КонецЦикла;

	// Заполняем данными
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		ЗаполнитьИзТаблицыЗначений(ЗначениеКоллекции, ИмяТаблицы);

	ИначеЕсли МассивСодержитСтрокиТЗ Тогда
		ЗаполнитьИзМассиваСтрокТЗ(ЗначениеКоллекции, ИмяТаблицы);

	ИначеЕсли ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		ЗаполнитьИзМассива(ЗначениеКоллекции, ИмяТаблицы);

	ИначеЕсли ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		ЗаполнитьИзСтруктуры(ЗначениеКоллекции, ИмяТаблицы);

	ИначеЕсли ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		ЗаполнитьИзСоответствия(ЗначениеКоллекции, ИмяТаблицы);

	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		ЗаполнитьИзСпискаЗначений(ЗначениеКоллекции, ИмяТаблицы);

	КонецЕсли;

	КоличествоЭлементов = ЭтаФорма[ИмяТаблицы].Количество();

КонецПроцедуры

// Получение вложенного элемента коллекции для drill-down
&НаСервереБезКонтекста
Функция ПолучитьВложенноеЗначениеНаСервере(АдресКоллекции, Индекс, ТипКоллекции, ИдентификаторФормы)

	Если Не ЗначениеЗаполнено(АдресКоллекции) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Коллекция = ПолучитьИзВременногоХранилища(АдресКоллекции);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;

	Если ТипКоллекции = "ТЗ" Тогда
		// Строку ТЗ → Структура (ключ = имя колонки, значение = значение ячейки)
		Если Индекс < 0 ИЛИ Индекс >= Коллекция.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		СтрокаТЗ = Коллекция[Индекс];
		НоваяСтруктура = Новый Структура;
		Для Каждого Колонка Из Коллекция.Колонки Цикл
			НоваяСтруктура.Вставить(Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
		КонецЦикла;
		Значение = НоваяСтруктура;

	ИначеЕсли ТипКоллекции = "МасСтрокТЗ" Тогда
		// Массив строк ТЗ — конвертируем строку в Структуру
		Если Индекс < 0 ИЛИ Индекс >= Коллекция.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		СтрокаТЗ = Коллекция[Индекс];
		Попытка
			НоваяСтруктура = Новый Структура;
			Для Каждого Колонка Из СтрокаТЗ.Владелец().Колонки Цикл
				НоваяСтруктура.Вставить(Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
			КонецЦикла;
			Значение = НоваяСтруктура;
		Исключение
			Значение = СтрокаТЗ;
		КонецПопытки;

	ИначеЕсли ТипКоллекции = "Мас" Тогда
		Если Индекс < 0 ИЛИ Индекс >= Коллекция.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = Коллекция[Индекс];

	ИначеЕсли ТипКоллекции = "Стр" ИЛИ ТипКоллекции = "Соот" Тогда
		Счетчик = 0;
		Для Каждого КЗ Из Коллекция Цикл
			Если Счетчик = Индекс Тогда
				Значение = КЗ.Значение;
				Прервать;
			КонецЕсли;
			Счетчик = Счетчик + 1;
		КонецЦикла;

	ИначеЕсли ТипКоллекции = "Спис" Тогда
		Если Индекс < 0 ИЛИ Индекс >= Коллекция.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = Коллекция[Индекс].Значение;

	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ЭтоКолл = ЗначениеЯвляетсяКоллекциейСервер(Значение);

	Результат = Новый Структура("ЭтоКоллекция", ЭтоКолл);
	Если ЭтоКолл Тогда
		Результат.Вставить("АдресЗначения", ПоместитьВоВременноеХранилище(Значение, ИдентификаторФормы));
		Результат.Вставить("ТипЗначения", Строка(ТипЗнч(Значение)));
		Результат.Вставить("КоличествоЭлементов", КоличествоЭлементовСервер(Значение));
	Иначе
		Попытка
			ТекстЗнач = Строка(Значение);
		Исключение
			ТекстЗнач = "<ошибка представления>";
		КонецПопытки;
		Результат.Вставить("ТекстЗначения", ТекстЗнач);
		Результат.Вставить("ТипЗначения", Строка(ТипЗнч(Значение)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеЯвляетсяКоллекциейСервер(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = ТипЗнч(Значение);
	Возврат Т = Тип("ТаблицаЗначений") ИЛИ Т = Тип("Массив") ИЛИ Т = Тип("ФиксированныйМассив")
		ИЛИ Т = Тип("Структура") ИЛИ Т = Тип("ФиксированнаяСтруктура")
		ИЛИ Т = Тип("Соответствие") ИЛИ Т = Тип("ФиксированноеСоответствие")
		ИЛИ Т = Тип("СписокЗначений");
КонецФункции

&НаСервереБезКонтекста
Функция КоличествоЭлементовСервер(Значение)
	Попытка
		Возврат Значение.Количество();
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ДобавитьКолонкуВТаблицу(ИмяКолонки, ТаблицаФормы, ИмяТаблицы)
	НовыйЭлемент             = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ТаблицаФормы);
	НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = ИмяТаблицы + "." + ИмяКолонки;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзТаблицыЗначений(ТЗ, ИмяТаблицы)
	Индекс = 0;
	Для Каждого СтрТЗ Из ТЗ Цикл
		НоваяСтрока = ЭтаФорма[ИмяТаблицы].Добавить();
		НоваяСтрока.НомерСтроки = Индекс;
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Попытка
				НоваяСтрока["_" + Колонка.Имя] = ПредставлениеЗначения(СтрТЗ[Колонка.Имя]);
			Исключение
				НоваяСтрока["_" + Колонка.Имя] = "<ошибка>";
			КонецПопытки;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзМассиваСтрокТЗ(МассивСтрок, ИмяТаблицы)
	Попытка
		КолонкиТЗ = МассивСтрок[0].Владелец().Колонки;
	Исключение
		Возврат;
	КонецПопытки;
	Для Индекс = 0 По МассивСтрок.ВГраница() Цикл
		СтрокаТЗ = МассивСтрок[Индекс];
		НоваяСтрока = ЭтаФорма[ИмяТаблицы].Добавить();
		НоваяСтрока.НомерСтроки = Индекс;
		Для Каждого Колонка Из КолонкиТЗ Цикл
			Попытка
				НоваяСтрока["_" + Колонка.Имя] = ПредставлениеЗначения(СтрокаТЗ[Колонка.Имя]);
			Исключение
				НоваяСтрока["_" + Колонка.Имя] = "<ошибка>";
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

