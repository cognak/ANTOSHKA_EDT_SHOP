&НаКлиенте
Процедура ПрименитьНастройкиРедактораКОбъекту(defaultView, Настройки)
	
	defaultView.setTheme(Настройки.РедакторТема);
	
	defaultView.minimap(Настройки.РедакторОтображатьКарту);
	
	ПутьКФайлуШаблоновКода = Настройки.РедакторПутьКФайлуШаблонов;
	Если ЗначениеЗаполнено(ПутьКФайлуШаблоновКода) Тогда
		
		МассивПутей = Новый Массив;
		МассивПутей.Добавить(ПутьКФайлуШаблоновКода);
		
		ВыборФайлаШаблонаЗавершение(МассивПутей, Неопределено);
				
	Иначе
		
		defaultView.setDefaultSnippets();
		
	КонецЕсли;
	
	Если Настройки.РедакторОтображатьНомераСтрок Тогда
		defaultView.showLineNumbers();
	Иначе
		defaultView.hideLineNumbers();
	КонецЕсли;
	
	defaultView.renderWhitespace(Настройки.РедакторОтображатьПробелыИТабуляции);
	
	Если Настройки.РедакторОтображатьСостояние Тогда
		defaultView.showStatusBar();
	Иначе
		defaultView.hideStatusBar();
	КонецЕсли;
	
	// Установка шрифта
	Шрифт = Настройки.РедакторШрифт;
	РазмерШрифта = Шрифт.Размер;
	
	defaultView.setFontFamily(Шрифт.Имя);
	defaultView.setFontSize(РазмерШрифта);
	
	Если Шрифт.Полужирный = Истина Тогда
		Жирность = "bold";
	Иначе
		Жирность = "normal";
	КонецЕсли;
	defaultView.setFontWeight(Жирность);
		
	Интервал = 1.35;
	defaultView.setLineHeight(РазмерШрифта * Интервал);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаШаблонаЗавершение(Файлы, ДопПараметры) Экспорт
	
	Если Файлы <> Неопределено И 0 < Файлы.Количество() Тогда
		
		Файл = Новый ЧтениеТекста(Файлы[0], КодировкаТекста.UTF8);
		СтрокаШаблона = "";
		Строка = Файл.ПрочитатьСтроку();
		
		Пока Строка <> Неопределено Цикл
			СтрокаШаблона = СтрокаШаблона + Строка + Символы.ПС;
			Строка = Файл.ПрочитатьСтроку();
		КонецЦикла;
		
		Файл.Закрыть();
		View().parseSnippets(СтрокаШаблона);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере(Настройки)
	
	ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта(), КлючНастроекКонсоли(), Настройки);  
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиКонсолиНаСервере()
	
	ЗагруженныеНастройкиКонсоли = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта(), КлючНастроекКонсоли());;
	
	Если ЗагруженныеНастройкиКонсоли = Неопределено Тогда
		ЗагруженныеНастройкиКонсоли = НастройкиКонсолиПоУмолчанию();	
	КонецЕсли;             
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекущиеНастройкиКонсоли(Форма)
	
	НастройкиРедактор = Новый Структура;
	НастройкиРедактор.Вставить("РедакторПутьКФайлуШаблонов", Форма.РедакторПутьКФайлуШаблонов);
	НастройкиРедактор.Вставить("РедакторОтображатьКарту", Форма.РедакторОтображатьКарту);
	НастройкиРедактор.Вставить("РедакторОтображатьНомераСтрок", Форма.РедакторОтображатьНомераСтрок);
	НастройкиРедактор.Вставить("РедакторОтображатьПробелыИТабуляции", Форма.РедакторОтображатьПробелыИТабуляции);
	НастройкиРедактор.Вставить("РедакторОтображатьСостояние", Форма.РедакторОтображатьСостояние);
	НастройкиРедактор.Вставить("РедакторШрифт", Форма.РедакторШрифт);
	НастройкиРедактор.Вставить("РедакторТема", Форма.РедакторТема);
	
	НастройкиФункциональность = Новый Структура;
	НастройкиФункциональность.Вставить("КаталогИсходногоКодаКонфигурации", Форма.Объект.КаталогИсходногоКодаКонфигурации);
	НастройкиФункциональность.Вставить("СохранятьКодПриВыполнении", Форма.СохранятьКодПриВыполнении);
	НастройкиФункциональность.Вставить("ПоказыватьЗначенияПеременныхПослеВыполнения", Форма.ПоказыватьЗначенияПеременныхПослеВыполнения);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Редактор", НастройкиРедактор);
	Настройки.Вставить("Функциональность", НастройкиФункциональность);
	
	Возврат Настройки;
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиКонсолиПоУмолчанию()
	
	НастройкиРедактор = Новый Структура;                          
	НастройкиРедактор.Вставить("РедакторПутьКФайлуШаблонов", "");
	НастройкиРедактор.Вставить("РедакторОтображатьКарту", Истина);
	НастройкиРедактор.Вставить("РедакторОтображатьНомераСтрок", Истина);
	НастройкиРедактор.Вставить("РедакторОтображатьПробелыИТабуляции", Ложь);
	НастройкиРедактор.Вставить("РедакторОтображатьСостояние", Ложь);
	НастройкиРедактор.Вставить("РедакторШрифт", Новый Шрифт("Consolas",, 14,Истина));
	НастройкиРедактор.Вставить("РедакторТема", "bsl-solar-light");
	
	НастройкиФункциональность = Новый Структура;
	НастройкиФункциональность.Вставить("КаталогИсходногоКодаКонфигурации", "");
	НастройкиФункциональность.Вставить("СохранятьКодПриВыполнении", Ложь);
	НастройкиФункциональность.Вставить("ПоказыватьЗначенияПеременныхПослеВыполнения", Ложь);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Редактор", НастройкиРедактор);
	Настройки.Вставить("Функциональность", НастройкиФункциональность);
	
	Возврат Настройки;
		
КонецФункции

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершенВыборФайлаШаблоновКода(Файлы, ДополнительныеПараметры) Экспорт
	
	Если Файлы = Неопределено Тогда
		Возврат;	
	КонецЕсли;  
	
	РедакторПутьКФайлуШаблонов = Файлы[0];
	
	НастройкиРедактораПриИзменении(Неопределено);
	
