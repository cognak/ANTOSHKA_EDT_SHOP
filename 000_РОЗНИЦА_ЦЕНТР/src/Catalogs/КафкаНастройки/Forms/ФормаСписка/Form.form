  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КафкаНастройки.Ссылка КАК Ссылка,
	КафкаНастройки.Наименование КАК Наименование,
	КафкаНастройки.ВидОбъекта КАК ВидОбъекта,
	КафкаНастройки.ИсключитьИзОбменов КАК ИсключитьИзОбменов
ИЗ
	Справочник.КафкаНастройки КАК КафкаНастройки
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КафкаНастройки.Топики КАК КафкаНастройкиТопики
		ПО (КафкаНастройкиТопики.Ссылка = КафкаНастройки.Ссылка)
ГДЕ
	(КафкаНастройкиТопики.Топик = &amp;Топик
			ИЛИ &amp;ВсеТопики)
	И (&amp;НаправлениеОтправки = 1
			ИЛИ &amp;НаправлениеОтправки = 2
				И КафкаНастройкиТопики.ОтправлятьИзЦентра
			ИЛИ &amp;НаправлениеОтправки = 3
				И КафкаНастройкиТопики.ОтправлятьИзПереферии
			ИЛИ &amp;НаправлениеОтправки = 4
				И НЕ КафкаНастройкиТопики.ОтправлятьИзЦентра
				И НЕ КафкаНастройкиТопики.ОтправлятьИзПереферии
			ИЛИ &amp;НаправлениеОтправки = 5
				И КафкаНастройкиТопики.ОтправлятьИзЦентра
				И КафкаНастройкиТопики.ОтправлятьИзПереферии)</queryText>
      <mainTable>Catalog.КафкаНастройки</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ссылка</dataPath>
        <field>Ссылка</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Наименование</dataPath>
        <field>Наименование</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ВидОбъекта</dataPath>
        <field>ВидОбъекта</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ИсключитьИзОбменов</dataPath>
        <field>ИсключитьИзОбменов</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Топики</dataPath>
        <field>Топики</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Предопределенный</dataPath>
        <field>Предопределенный</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ИмяПредопределенныхДанных</dataPath>
        <field>ИмяПредопределенныхДанных</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ПометкаУдаления</dataPath>
        <field>ПометкаУдаления</field>
      </fields>
      <parameters>
        <name>ВсеТопики</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Все топики</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>Boolean</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>Топик</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Топик</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.КафкаТопики</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>НаправлениеОтправки</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Направление отправки</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>Number</types>
