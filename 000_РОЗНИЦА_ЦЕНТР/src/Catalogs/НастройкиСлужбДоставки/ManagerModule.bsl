
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СтоимостьДоставки(ДатаДокумента, СлужбаДоставки, ТипДоставки) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("СуммаБесплатнойДоставки", 0);
	Результат.Вставить("СуммаДоставкиСлужбойДоставки", 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	НастройкиСлужбДоставкиСтоимостьДоставки.СуммаДоставки КАК СуммаДоставкиСлужбойДоставки,
		|	НастройкиСлужбДоставкиСтоимостьДоставки.МаксимальнаяСуммаПосылки КАК СуммаБесплатнойДоставки
		|ИЗ
		|	Справочник.НастройкиСлужбДоставки.СтоимостьДоставки КАК НастройкиСлужбДоставкиСтоимостьДоставки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиСлужбДоставки КАК НастройкиСлужбДоставки
		|		ПО НастройкиСлужбДоставкиСтоимостьДоставки.Ссылка = НастройкиСлужбДоставки.Ссылка
		|ГДЕ
		|	НастройкиСлужбДоставки.СлужбаДоставки = &СлужбаДоставки
		|	И НастройкиСлужбДоставкиСтоимостьДоставки.ТипДоставки В (&ТипДоставки)";
	
	Запрос.УстановитьПараметр("ТипДоставки", Перечисления.ТипыДоставки.ПолусчитьТипыДоставки(ТипДоставки));
	Запрос.УстановитьПараметр("СлужбаДоставки", СлужбаДоставки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
	Иначе
		
		УчетнаяПолитика = ОбщегоНазначенияРТ.ПолучитьУчетнуюПолитику(ДатаДокумента);
		Результат.СуммаДоставкиСлужбойДоставки = УчетнаяПолитика.СуммаДоставкиЗаказаПокупателя;
		Результат.СуммаБесплатнойДоставки = УчетнаяПолитика.СуммаБесплатнойДоставки;
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

