#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// + Бакан 29102026  Разовое срабатывание скидки
//	Регистр хранит, какие разовые скидки (реквизит "Разовое срабатывание" справочника "Скидки наценки")
//	уже срабатывали у клиента. Пишется при проведении чека продажи, по обмену "ПоМагазину" уходит
//	во все магазины - повторное срабатывание проверяется локально, без связи с центром.

#Область ПрограммныйИнтерфейс

// Клиент, по которому учитываются разовые скидки: владелец дисконтной карты, а если его нет - сама карта.
//
// Параметры:
//  ДисконтнаяКарта - СправочникСсылка.ИнформационныеКарты - карта документа.
//  ВладелецКарты   - СправочникСсылка.Контрагенты, СправочникСсылка.ФизическиеЛица, СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - Неопределено, если клиент не определён (продажа без карты).
//
Функция КлиентРазовойСкидки(ДисконтнаяКарта, ВладелецКарты) Экспорт

	Если ЗначениеЗаполнено(ВладелецКарты) Тогда
		Возврат ВладелецКарты;
	ИначеЕсли ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат ДисконтнаяКарта;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Убирает из таблицы действующих скидок разовые скидки, которые уже срабатывали у клиента
// в текущем периоде действия (начало - период записи регистра "Действие скидок наценок" для магазина).
// Если клиент не определён, разовые скидки не предоставляются: повторное срабатывание не проверить.
//
// Параметры:
//  СкидкиНаценки   - ТаблицаЗначений - действующие скидки, колонка "СкидкаНаценка"; лишние строки удаляются.
//  Клиент          - см. КлиентРазовойСкидки.
//  Магазин         - СправочникСсылка.Магазины - магазин документа.
//  ДатаРасчета     - Дата - дата расчета скидок.
//  ТекущийДокумент - ДокументСсылка - рассчитываемый документ, его собственное срабатывание не учитывается.
//
Процедура ИсключитьИспользованныеРазовыеСкидки(СкидкиНаценки, Клиент, Магазин, ДатаРасчета, ТекущийДокумент) Экспорт

	Если СкидкиНаценки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДействиеСкидок.СкидкаНаценка КАК СкидкаНаценка,
	|	МИНИМУМ(ДействиеСкидок.Период) КАК ДатаНачала
	|ПОМЕСТИТЬ РазовыеСкидки
	|ИЗ
	|	РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
	|			&ДатаРасчета,
	|			(КОНЕЦПЕРИОДА(ДатаОкончания, ДЕНЬ) >= &ДатаРасчета
	|				ИЛИ ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|				И СкидкаНаценка В (&СкидкиНаценки)
	|				И СкидкаНаценка.РазовоеСрабатывание = ИСТИНА
	|				И (Магазин = &Магазин
	|					ИЛИ Магазин = ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка))) КАК ДействиеСкидок
	|
	|СГРУППИРОВАТЬ ПО
	|	ДействиеСкидок.СкидкаНаценка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазовыеСкидки.СкидкаНаценка КАК СкидкаНаценка
	|ИЗ
	|	РазовыеСкидки КАК РазовыеСкидки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрабатыванияРазовыхСкидок КАК Срабатывания
	|		ПО (Срабатывания.Клиент = &Клиент)
	|			И РазовыеСкидки.СкидкаНаценка = Срабатывания.СкидкаНаценка
	|			И РазовыеСкидки.ДатаНачала <= Срабатывания.ДатаСрабатывания
	|			И (НЕ Срабатывания.ДокументПродажи = &ТекущийДокумент)
	|ГДЕ
	|	(НЕ &КлиентОпределен
	|			ИЛИ НЕ Срабатывания.СкидкаНаценка ЕСТЬ NULL)");

	Запрос.УстановитьПараметр("СкидкиНаценки"  , СкидкиНаценки.ВыгрузитьКолонку("СкидкаНаценка"));
	Запрос.УстановитьПараметр("ДатаРасчета"    , ДатаРасчета);
	Запрос.УстановитьПараметр("Магазин"        , Магазин);
	Запрос.УстановитьПараметр("Клиент"         , Клиент);
	Запрос.УстановитьПараметр("КлиентОпределен", ЗначениеЗаполнено(Клиент));
	Запрос.УстановитьПараметр("ТекущийДокумент", ТекущийДокумент);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого СтрокаСкидки Из СкидкиНаценки.НайтиСтроки(Новый Структура("СкидкаНаценка", Выборка.СкидкаНаценка)) Цикл
			СкидкиНаценки.Удалить(СтрокаСкидки);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Записывает срабатывания разовых скидок по чеку (вызывается при проведении).
// Пишет только пробитые и архивные чеки продажи; если чек перестал им быть - записи по нему очищаются.
// Обычный чек без разовых скидок ничего не пишет, чтобы пустые наборы не уходили в обмен.
//
// Параметры:
//  Чек - ДокументОбъект.ЧекККМ - проводимый чек.
//
Процедура ЗаписатьСрабатыванияПоЧеку(Чек) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СкидкиЧека.СкидкаНаценка КАК СкидкаНаценка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫРАЗИТЬ(СкидкиНаценки.СкидкаНаценка КАК Справочник.СкидкиНаценки) КАК СкидкаНаценка
	|	ИЗ
	|		Документ.ЧекККМ.СкидкиНаценки КАК СкидкиНаценки
	|	ГДЕ
	|		СкидкиНаценки.Ссылка = &Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВЫРАЗИТЬ(Подарки.СкидкаНаценка КАК Справочник.СкидкиНаценки)
	|	ИЗ
	|		Документ.ЧекККМ.Подарки КАК Подарки
	|	ГДЕ
	|		Подарки.Ссылка = &Ссылка) КАК СкидкиЧека
	|ГДЕ
	|	&ЧекПродажи = ИСТИНА
	|	И СкидкиЧека.СкидкаНаценка.РазовоеСрабатывание = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Срабатывания.ДокументПродажи КАК ДокументПродажи
	|ИЗ
	|	РегистрСведений.СрабатыванияРазовыхСкидок КАК Срабатывания
	|ГДЕ
	|	Срабатывания.ДокументПродажи = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнформационныеКарты.ВладелецКарты КАК ВладелецКарты
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК ИнформационныеКарты
	|ГДЕ
	|	ИнформационныеКарты.Ссылка = &ДисконтнаяКарта");

	Запрос.УстановитьПараметр("Ссылка"         , Чек.Ссылка);
	Запрос.УстановитьПараметр("ДисконтнаяКарта", Чек.ДисконтнаяКарта);
	Запрос.УстановитьПараметр("ЧекПродажи"     , Чек.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Продажа
		И (Чек.СтатусЧекаККМ = Перечисления.СтатусыЧековККМ.Пробитый
			ИЛИ Чек.СтатусЧекаККМ = Перечисления.СтатусыЧековККМ.Архивный));

	Результаты    = Запрос.ВыполнитьПакет();
	РазовыеСкидки = Результаты[0].Выгрузить();
	ЗаписиБыли    = НЕ Результаты[1].Пустой();

	Если РазовыеСкидки.Количество() = 0 И НЕ ЗаписиБыли Тогда
		Возврат;
	КонецЕсли;

//	Клиент - как при расчете скидок (СкидкиНаценкиСерверПереопределяемый.ПараметрыРасчетаСкидок):
//	при предъявленной карте берется владелец из карты.
	ВладелецКарты = Чек.ВладелецДисконтнойКарты;
	ВыборкаКарты  = Результаты[2].Выбрать();

	Если ВыборкаКарты.Следующий() Тогда
		ВладелецКарты = ВыборкаКарты.ВладелецКарты;
	КонецЕсли;

	Клиент = КлиентРазовойСкидки(Чек.ДисконтнаяКарта, ВладелецКарты);

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументПродажи.Установить(Чек.Ссылка);

	Если ЗначениеЗаполнено(Клиент) Тогда

		Для Каждого СтрокаСкидки Из РазовыеСкидки Цикл

			Запись = НаборЗаписей.Добавить();
			Запись.Клиент           = Клиент;
			Запись.СкидкаНаценка    = СтрокаСкидки.СкидкаНаценка;
			Запись.ДокументПродажи  = Чек.Ссылка;
			Запись.ДатаСрабатывания = Чек.Дата;
			Запись.Магазин          = Чек.Магазин;
			Запись.ДисконтнаяКарта  = Чек.ДисконтнаяКарта;

		КонецЦикла;

	КонецЕсли;

	Если НаборЗаписей.Количество() = 0 И НЕ ЗаписиБыли Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей.Записать();

КонецПроцедуры

// Удаляет срабатывания разовых скидок по чеку (чек помечен на удаление).
// Пустой набор пишется только если записи были, чтобы не гонять в обмен пустые наборы.
//
// Параметры:
//  ДокументПродажи - ДокументСсылка.ЧекККМ - чек.
//
Процедура ОчиститьСрабатыванияПоЧеку(ДокументПродажи) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Срабатывания.ДокументПродажи КАК ДокументПродажи
	|ИЗ
	|	РегистрСведений.СрабатыванияРазовыхСкидок КАК Срабатывания
	|ГДЕ
	|	Срабатывания.ДокументПродажи = &ДокументПродажи");

	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);

	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументПродажи.Установить(ДокументПродажи);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

// - Бакан

#КонецЕсли
