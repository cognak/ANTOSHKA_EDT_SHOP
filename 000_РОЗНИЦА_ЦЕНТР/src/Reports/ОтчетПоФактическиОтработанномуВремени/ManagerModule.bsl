&НаСервере
Функция СформироватьЗапросПоТабелю(ПараметрыОтчета)
	
	СтрокаЧасы = "";
	СтрокаОтпуск = "";
	
	Для День = 1 По 31 Цикл
		СтрокаЧасы = СтрокаЧасы + " + ВЫБОР КОГДА ТЧ.Часов" + День+ " = 0 ТОГДА ТЧ.ЧасовФактАвто"+День+" ИНАЧЕ ТЧ.Часов" + День+ " КОНЕЦ";
		СтрокаОтпуск = СтрокаОтпуск + " + ВЫБОР КОГДА ТЧ.Комментарий" + День + " = ""отпуск"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ";
	КонецЦикла;
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТЧ.Сотрудник КАК Сотрудник,
	|	ТЧ.Сотрудник.ИНН КАК ИНН,
	|	ТЧ.Должность КАК Должность,
	|	ТЧ.Ссылка.Магазин КАК Магазин,
	|	(" + Сред(СтрокаЧасы, 4) + ") КАК ЧасыСтроки,
	|	(" + Сред(СтрокаОтпуск, 4) + ") КАК ОтпускСтроки
	|ПОМЕСТИТЬ ВТ_ИсходныеДанные
	|ИЗ
	|	Документ.ТабельУчетаРабочегоВремени.ДанныеОВремени КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка.Проведен = ИСТИНА
	|	И ТЧ.Ссылка.ДатаНачалаПериода >= &НачалоПериода
	|	И ТЧ.Ссылка.ДатаОкончанияПериода <= &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Сотрудник КАК Сотрудник,
	|	ВТ.ИНН КАК ИНН,
	|	ВТ.Должность КАК Должность,
	|	ВТ.Магазин КАК Магазин,
	|	СУММА(ВТ.ЧасыСтроки) КАК ВсегоОтработаноЧасов,
	|	СУММА(ВТ.ОтпускСтроки) КАК ВсегоДнейВОтпуске
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Магазин,
	|	ВТ.ИНН,
	|	ВТ.Сотрудник,
	|	ВТ.Должность";
	
    //Сообщить(ТекстЗапроса);
	Запрос = Новый Запрос(ТекстЗапроса);
	Если ПараметрыОтчета.Свойство("Магазин") И ЗначениеЗаполнено(ПараметрыОтчета.Магазин) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"И ТЧ.Ссылка.ДатаОкончанияПериода <= &КонецПериода", "И ТЧ.Ссылка.ДатаОкончанияПериода <= &КонецПериода И ТЧ.Ссылка.Магазин = &Магазин");
		Запрос.УстановитьПараметр("Магазин",ПараметрыОтчета.Магазин); 
		Запрос.Текст = ТекстЗапроса;
	КонецЕсли;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",   ПараметрыОтчета.КонецПериода);

	
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция СформироватьТабличныйДокумент(ПараметрыОтчета) Экспорт
	ТЗДанные = СформироватьЗапросПоТабелю(ПараметрыОтчета);
	Таб = Новый ТабличныйДокумент;
	
	Макет = Отчеты.ОтчетПоФактическиОтработанномуВремени.ПолучитьМакет("МакетПечати");
	Область_ = Макет.ПолучитьОбласть("Шапка");
	Если ПараметрыОтчета.НачалоПериода = НачалоМесяца(ПараметрыОтчета.НачалоПериода) И
		 ПараметрыОтчета.КонецПериода = КонецМесяца(ПараметрыОтчета.КонецПериода) Тогда
		 Если Месяц(ПараметрыОтчета.НачалоПериода) = Месяц(ПараметрыОтчета.КонецПериода)
		 И Год(ПараметрыОтчета.НачалоПериода) = Год(ПараметрыОтчета.КонецПериода) Тогда
		
			ПериодРегистрации =  Формат(ПараметрыОтчета.НачалоПериода,"ДФ='ММММ гггг'");
		Иначе
			ПериодРегистрации =  Формат(ПараметрыОтчета.НачалоПериода,"ДФ='ММММ гггг'")+" - "+Формат(ПараметрыОтчета.КонецПериода,"ДФ='ММММ гггг'");
		КонецЕсли;
	Иначе	
		ПериодРегистрации =  Формат(ПараметрыОтчета.НачалоПериода,"ДФ=dd.MM.yyyy")+" - "+Формат(ПараметрыОтчета.КонецПериода,"ДФ='dd.MM.yyyy'");
	КонецЕсли;
	Область_.Параметры.ПериодРегистрации = ПериодРегистрации;
	
	Таб.Вывести(Область_);
	Для Каждого Строка_ Из ТЗДанные Цикл
		Область_ = Макет.ПолучитьОбласть("Строка");
		Область_.Параметры.Магазин 		= Строка_.Магазин;
		Область_.Параметры.Сотрудник 	= Строка_.Сотрудник;
		Область_.Параметры.Должность 	= Строка_.Должность;
		Область_.Параметры.ИНН 			= Строка_.Сотрудник.ИНН;
		Область_.Параметры.КоличествоЧасов = Строка_.ВсегоОтработаноЧасов;
		Область_.Параметры.ДнейВОтпуске = Строка_.ВсегоДнейВОтпуске;
		Таб.Вывести(Область_);
	КонецЦикла;
	
	Возврат Таб;
	
КонецФункции
