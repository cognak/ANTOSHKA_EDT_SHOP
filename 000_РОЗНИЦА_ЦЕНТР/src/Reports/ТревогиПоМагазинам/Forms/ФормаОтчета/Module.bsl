&НаСервере
Функция ПолучитьТЗДанные()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КартаТревог.Период КАК НачалоТревоги,
	               |	КартаТревог.КодТерритории КАК КодТерритории,
	               |	КартаТревог.НазваниеТерритории КАК Регион,
	               |	КартаТревог.ДатаОкончания КАК ОкончаниеТревоги,
	               |	КартаТревог.ТипТерритории КАК ТипТерритории,
	               |	КартаТревог.ТипТревоги КАК ТипТревоги,
	               |	КартаТревог.Примечание КАК Примечание,
	               |	Магазины.Ссылка КАК Магазин,
	               |	Магазины.Город КАК Город,
	               |	ИнтервалыРаботыМагазинов.НачалоИнтервала КАК НачалоРаботы,
	               |	ИнтервалыРаботыМагазинов.ОкончаниеИнтервала КАК ОкончаниеРаботы,
	               |	РАЗНОСТЬДАТ(КартаТревог.Период, КартаТревог.ДатаОкончания, МИНУТА) КАК Длительность
	               |ИЗ
	               |	Справочник.Магазины КАК Магазины
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КартаТревог КАК КартаТревог
	               |		ПО Магазины.Город.КодТерритории = КартаТревог.КодТерритории
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнтервалыРаботыМагазинов КАК ИнтервалыРаботыМагазинов
	               |		ПО (ИнтервалыРаботыМагазинов.Магазин = Магазины.Ссылка)
	               |ГДЕ
	               |	КартаТревог.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И Магазины.ВведенВЭксплуатацию = ИСТИНА";
	Запрос.УстановитьПараметр("НачалоПериода",Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Период.ДатаОкончания));
	вТЗ = Запрос.Выполнить().Выгрузить();

	Возврат вТЗ;
КонецФункции	

&НаСервере
Функция ОбработатьДанные(вТЗ)
	
	рТЗ = вТЗ.СкопироватьКолонки();
	
	// 2. Обходим исходную ТЗ
	Для Каждого СтрокаИсходная Из вТЗ Цикл
		
		ТекНачалоТревоги = СтрокаИсходная.НачалоТревоги;
		ТекКонецТревоги  = СтрокаИсходная.ОкончаниеТревоги;
		
		// Защита от пустых или некорректных дат
		Если Не ЗначениеЗаполнено(ТекНачалоТревоги) Или Не ЗначениеЗаполнено(ТекКонецТревоги) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаИсходная.НачалоРаботы) ИЛИ Не ЗначениеЗаполнено(СтрокаИсходная.ОкончаниеРаботы) Тогда
			Продолжить;
		КонецЕсли;
		
		
		// Перебираем каждый календарный день по порядку от начала до конца тревоги
		ТекущийДень = НачалоДня(ТекНачалоТревоги);
		Пока ТекущийДень <= НачалоДня(ТекКонецТревоги) Цикл
			
			// Считаем рабочие часы магазина для конкретного ТекущегоДня
			// Смещаем время работы (например, 11:00) на начало текущих суток
			СекундОтНачалаДняНачало = СтрокаИсходная.НачалоРаботы - НачалоДня(СтрокаИсходная.НачалоРаботы);
			СекундОтНачалаДняКонец  = СтрокаИсходная.ОкончаниеРаботы - НачалоДня(СтрокаИсходная.ОкончаниеРаботы);
			
			РабочееНачало = ТекущийДень + СекундОтНачалаДняНачало;
			РабочийКонец  = ТекущийДень + СекундОтНачалаДняКонец;
			
			// Если магазин работает круглосуточно или закрывается на следующий день (например, с 22:00 до 06:00), 
			// здесь потребуется усложнение. Код ниже рассчитан на работу внутри одного дня.
			
			// Находим пересечение интервала тревоги и рабочего времени магазина в этот день
			ПересечениеНачало = Максимум(ТекНачалоТревоги, РабочееНачало);
			ПересечениеКонец  = Минимум(ТекКонецТревоги, РабочийКонец);
			
			// Если пересечение существует и оно корректно (начало раньше конца)
			Если ПересечениеНачало < ПересечениеКонец Тогда
				Если ПересечениеНачало < Период.ДатаНачала ИЛИ ПересечениеКонец > КонецДня(Период.ДатаОкончания) Тогда
					// Переходим к следующему дню
					ТекущийДень = ДобавитьМесяц(ТекущийДень, 0); // Безопасный сдвиг дня в 1С делается через + 86400 секунд
					ТекущийДень = ТекущийДень + 86400; 
					Продолжить;
				КонецЕсли;
				
				// Добавляем строку в результирующую ТЗ
				НоваяСтрока = рТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходная);
				
				НоваяСтрока.НачалоТревоги    = ПересечениеНачало;
				НоваяСтрока.ОкончаниеТревоги = ПересечениеКонец;
				
				// Вычисляем длительность в минутах (разница дат в 1С дает секунды)
				НоваяСтрока.Длительность = Цел((ПересечениеКонец - ПересечениеНачало) / 60);
				
			КонецЕсли;
			
			// Переходим к следующему дню
			ТекущийДень = ДобавитьМесяц(ТекущийДень, 0); // Безопасный сдвиг дня в 1С делается через + 86400 секунд
			ТекущийДень = ТекущийДень + 86400; 
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат рТЗ;

	
КонецФункции

// Вспомогательные функции минимума и максимума для дат
Функция Максимум(Значение1, Значение2)
	Возврат ?(Значение1 > Значение2, Значение1, Значение2);
КонецФункции

Функция Минимум(Значение1, Значение2)
	Возврат ?(Значение1 < Значение2, Значение1, Значение2);
КонецФункции

&НаСервере
Процедура КомандаСформироватьНаСервере()
	
	Результат.Очистить();

	вТЗ = ПолучитьТЗДанные();
	оТЗ = ОбработатьДанные(вТЗ);
	//ТабДок = СформироватьОтчетПоТЗ(вТЗ);
	ТабДок = СформироватьОтчетПоТЗ(оТЗ);
	
	Результат.Вывести(ТабДок);    
	Элементы.Результат.ОтображениеСостояния.Видимость = Ложь;
	Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;	
КонецПроцедуры 

&НаСервере
Функция СформироватьОтчетПоТЗ(вТЗ)
	// Получаем макет схемы из самого отчета
	СхемаСКД = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	// Используем текущие настройки из пользовательского интерфейса
	НастройкиТекущие = Отчет.КомпоновщикНастроек.ПолучитьНастройки();

	// Инициализируем макет компоновки
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки  = КомпоновщикМакета.Выполнить(СхемаСКД, НастройкиТекущие);

	// Передаем вашу таблицу значений в структуру внешних наборов
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("вТЗ", вТЗ); // Имя ключа должно точно совпадать с "Имя объекта" в наборе данных СКД

	// Запускаем компоновку данных
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);

	// Выводим результат в табличный документ
	ТабДок = Новый ТабличныйДокумент; // Или используйте реквизит формы Элементы.Результат
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТабДок;
КонецФункции


&НаКлиенте
Процедура КомандаСформировать(Команда)
	КомандаСформироватьНаСервере();
КонецПроцедуры
