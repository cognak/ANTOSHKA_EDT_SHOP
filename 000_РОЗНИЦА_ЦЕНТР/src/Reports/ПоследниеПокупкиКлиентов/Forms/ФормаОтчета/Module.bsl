
&НаКлиенте
Процедура РезультатПередПечатью(Элемент, ДиалогПечати, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если РольДоступна("ПолныеПрава") Тогда 
		Элементы.Результат.Защита = Ложь;
		Элементы.Результат.Вывод = ИспользованиеВывода.Авто;
	Иначе 
		Элементы.Результат.Защита = Истина;
		Элементы.Результат.Вывод = ИспользованиеВывода.Запретить;
	КонецЕсли;	
	
КонецПроцедуры
