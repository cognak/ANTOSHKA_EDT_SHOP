// РАБОТА С ФИСКАЛЬНЫМИ ЧЕКАМИ (ОБРАБОТКА И ОТПРАВКА СТРУКТУРЫ "SELL")

// Функция агрегирует данные входящих массивов Розницы 2.0, сопоставляет налоги,
// формирует JSON-пакет чека продажи/возврата и закрывает его одним POST-запросом к API ПРРО.
&НаКлиенте
Функция ПечатьЧека(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВходныеПараметры, ВыходныеПараметры) Экспорт
	
	// Очищаем и готовим выходные параметры под формат Розницы
	//ШаблонЧека = СформироватьШаблонЧека(ВходныеПараметры);
	 
	Результат  = Истина;
	
	ВыходныеПараметры = Новый Массив;
	
	// Извлекаем три базовые коллекции из входящего пакета РМК
	МассивТоваров  = ВходныеПараметры[0];
	МассивОплат    = ВходныеПараметры[1];
	МассивОбщих    = ВходныеПараметры[2];
	
	//2026-09-23 sa добавим еще сведения о фискальном регистраторе
	СведенияОФР = Новый Структура;
	СведенияОФР.Вставить("Организация",Параметры.Организация);
	СведенияОФР.Вставить("ЕДРПОУ",Параметры.ЕДРПОУ);
	СведенияОФР.Вставить("Кассир",Параметры.Кассир);
	СведенияОФР.Вставить("ФискальныйНомерУстройства",Параметры.ФискальныйНомерУстройства); 
	СведенияОФР.Вставить("Магазин",МассивОбщих[21].Магазин); 
	
	АргументыМетода = Новый Массив;
	АргументыМетода.Добавить(МассивОбщих[21].Магазин); 	
	ИмяНашейОбработки = "ОбщийМодуль.ПодключаемоеОборудованиеФискальныйРегистраторЧекбокс"; 
	
	ОтветШлюза = ОбщегоНазначенияВызовСервера.ВыполнитьМетодНаСервере(ИмяНашейОбработки, "ПолучитьАдресМагазина", АргументыМетода);
	
	Если ОтветШлюза.Успешно Тогда
		АдресМагазина = ОтветШлюза.РезультатМетода;
	Иначе
		АдресМагазина = "";
	КонецЕсли;
	СведенияОФР.Вставить("АдресМагазина",АдресМагазина);
	
	ВходныеПараметры.Добавить(СведенияОФР);	
	
	ДополнительныеРеквизитыЧека = МассивОбщих[22];
	УИДЧека =  ПолучитьУИДЧека(ДополнительныеРеквизитыЧека.УИД);
	// Определяем тип чека из общих параметров: 0 - продажа, 1 - возврат
	ТипЧека = МассивОбщих[0];
	ЭтоВозврат = (ТипЧека = 1);
	
	// Извлекаем структуру дополнительных параметров из элемента [22] общего массива
	СтруктураДопПараметров = Неопределено;
	Если МассивОбщих.Количество() > 22 Тогда
		СтруктураДопПараметров = МассивОбщих[22];
	КонецЕсли;
	
	// 1. ИНИЦИАЛИЗАЦИЯ И НАПОЛНЕНИЕ ТОВАРНОЙ ЧАСТИ ЧЕКА (goods)
	МассивGoodsППРРО = Новый Массив;
	
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		
		// Извлечение параметров из СпискаЗначений строки товара по фиксированным индексам БСП
		НаименованиеТовара = СтрокаТовара[0].Значение;
		Штрихкод           = СтрокаТовара[1].Значение;
		Цена               = СтрокаТовара[4].Значение;
		Количество         = СтрокаТовара[5].Значение;
		СуммаСкидки        = СтрокаТовара[7].Значение;
		СтавкаНДССтрокой   = СтрокаТовара[17].Значение;
		ЭтоПодакциз                 = СтрокаТовара[18].Значение;
		КодУКТВЭД          = ?(СтрокаТовара.Количество() > 19, СтрокаТовара[19].Значение, "");
		
		// Определение кода налоговой группы Checkbox
		НалоговаяГруппаКод = ПолучитьНалоговуюГруппу(ОбъектДрайвера, СтавкаНДССтрокой, ЭтоПодакциз);
		
		// Формирование структуры позиции товара (GoodPayload)
		СтруктураТовараПРРО = Новый Структура;
		СтруктураТовараПРРО.Вставить("name",     СокрЛП(НаименованиеТовара));
		СтруктураТовараПРРО.Вставить("price",    КопейкиИзСуммы(Цена));
		СтруктураТовараПРРО.Вставить("quantity", ТысячныеИзКоличества(Количество));
		
		// Массив налогов товара
		МассивНалоговТовара = Новый Массив;
		МассивНалоговТовара.Добавить(НалоговаяГруппаКод);
		СтруктураТовараПРРО.Вставить("taxes", МассивНалоговТовара);
		
		// Специфические флаги ПРРО
		Если ЭтоВозврат Тогда
			СтруктураТовараПРРО.Вставить("is_return", Истина);
		КонецЕсли;
		
		// Передача кодов акцизных марок, если товар подакцизный и есть штрихкод акциза
		Если ЭтоПодакциз И ЗначениеЗаполнено(Штрихкод) И Найти(Штрихкод, "#") = 0 Тогда
			// Базовая проверка: если штрихкод передан и не является стандартным EAN, считаем маркой
			Если СтрДлина(Штрихкод) >= 10 Тогда 
				МассивАкцизов = Новый Массив;
				МассивАкцизов.Добавить(Штрихкод);
				СтруктураТовараПРРО.Вставить("excise_barcodes", МассивАкцизов);
			КонецЕсли;
		КонецЕсли;
		
		// Если по позиции была скидка, передаем ее блоком
		Если СуммаСкидки > 0 Тогда
			МассивСкидокПозиции = Новый Массив;
			СтруктураСкидки = Новый Структура;
			СтруктураСкидки.Вставить("type",  "DISCOUNT");
			СтруктураСкидки.Вставить("mode",  "VALUE");
			СтруктураСкидки.Вставить("value", КопейкиИзСуммы(СуммаСкидки));
			
			МассивСкидокПозиции.Добавить(СтруктураСкидки);
			СтруктураТовараПРРО.Вставить("discounts", МассивСкидокПозиции);
		КонецЕсли;
		
		МассивGoodsППРРО.Добавить(СтруктураТовараПРРО);
	КонецЦикла;
	
	// 2. ФОРМИРОВАНИЕ ОПЛАТ ЧЕКА (payments)
	МассивPaymentsППРРО = Новый Массив;
	
	Для Каждого ЗначениеОплаты Из МассивОплат Цикл
		
		// Параметры оплаты: СтрокаОплаты — это структура, подготовленная РМК
		СтрокаОплаты = Новый Структура("КодТипаОплаты,Сумма,ТипОплаты,ЭквайринговыйТерминал,КодТранзакции,НомерПлатежнойКарты"
			,ЗначениеОплаты[0].Значение,ЗначениеОплаты[1].Значение,ЗначениеОплаты[2].Значение,ЗначениеОплаты[3].Значение,ЗначениеОплаты[4].Значение); 
		
		
		ТипОплаты1С  = СтрокаОплаты.ТипОплаты; // Строка (Наличные, ПлатежнаяКарта...)
		СуммаОплаты = СтрокаОплаты.Сумма;
		
		СтруктураОплатыПРРО = Новый Структура;
		
		// Сопоставление типов оплат 1С с системными типами Checkbox (CASH / CASHLESS)
		Если Найти(Строка(ТипОплаты1С), "Наличные") > 0 ИЛИ Найти(Строка(ТипОплаты1С), "Готівка") > 0 Тогда
			СтруктураОплатыПРРО.Вставить("type", "CASH");
		Иначе
			СтруктураОплатыПРРО.Вставить("type", "CASHLESS");
			// Передаем дополнительные эквайринговые реквизиты для безнала при их наличии
			Если СтрокаОплаты.Свойство("НомерПлатежнойКарты") И ЗначениеЗаполнено(СтрокаОплаты.НомерПлатежнойКарты) Тогда
				СтруктураОплатыПРРО.Вставить("card_mask", СтрокаОплаты.НомерПлатежнойКарты);
			КонецЕсли;
			Если СтрокаОплаты.Свойство("ЭквайринговыйТерминал") И ЗначениеЗаполнено(СтрокаОплаты.ЭквайринговыйТерминал) Тогда
				СтруктураОплатыПРРО.Вставить("terminal", СтрокаОплаты.ЭквайринговыйТерминал);
			КонецЕсли;
			Если СтрокаОплаты.Свойство("КодТранзакции") И ЗначениеЗаполнено(СтрокаОплаты.КодТранзакции) Тогда
				СтруктураОплатыПРРО.Вставить("rrn", СтрокаОплаты.КодТранзакции);
			КонецЕсли;
		КонецЕсли;
		СтруктураОплатыПРРО.Вставить("value", КопейкиИзСуммы(СуммаОплаты));
		МассивPaymentsППРРО.Добавить(СтруктураОплатыПРРО);
	КонецЦикла;
	
	// 3. СБОРКА ИТОГОВОГО ПАКЕТА ЧЕКА (ReceiptPayload)
	ТелоЗапросаЧек = Новый Структура;
	// Привязываем уникальный UUID документа 1С для предотвращения повторной фискализации (клиентский custom_id)
	Если СтруктураДопПараметров <> Неопределено И СтруктураДопПараметров.Свойство("УИД") Тогда
		ТелоЗапросаЧек.Вставить("custom_id", СтруктураДопПараметров.УИД);
	Иначе
		ТелоЗапросаЧек.Вставить("custom_id", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	ТелоЗапросаЧек.Вставить("goods",    МассивGoodsППРРО);
	ТелоЗапросаЧек.Вставить("payments", МассивPaymentsППРРО);
	// Блок отправки электронного чека (телефон/email) покупателя при наличии
	ТелоDelivery = Новый Структура;
	КонтактыПолучателя = МассивОбщих[19];
	// Индекс контактов контрагента из ВходныеПараметрыПолучить
	Если ЗначениеЗаполнено(КонтактыПолучателя) Тогда
		Если Найти(КонтактыПолучателя, "@") > 0 Тогда
			ТелоDelivery.Вставить("email", СокрЛП(КонтактыПолучателя));
		Иначе
			// Очистка номера телефона от лишних символов форматирования
			ТелефонЧистый = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(КонтактыПолучателя, "(", ""), ")", ""), "-", ""), " ", "");
			ТелоDelivery.Вставить("phone", СокрЛП(ТелефонЧистый));
		КонецЕсли;
		ТелоЗапросаЧек.Вставить("delivery", ТелоDelivery);
	КонецЕсли;
	// Запрос на автоматическое формирование графического файла чека на сервере ПРРО
	ТелоЗапросаЧек.Вставить("print", Истина);
	// Сериализация структуры в строку JSON
	СтрокаJSONЧека = СтруктуруВТекстДЖСОН(ТелоЗапросаЧек);
	// 4. СИНХРОННАЯ ОТПРАВКА НА API (Вызов метода ЗакрытьЧек одним махом)
	АдресРесурса = "receipt/sell";
	РезультатЗапроса = ОтправитьДанные(ОбъектДрайвера, АдресРесурса, СтрокаJSONЧека);
	
	//Была ошибка выходим из модуля обработки
	Если Не РезультатЗапроса Тогда
		// Обработка критической ошибки связи / сбоя транспортного уровня
		ТекстОшибки = "Не вдалося отримати відповідь від CheckBox.Manager. Перевірте з'єднання.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		ВыходныеПараметры.Очистить();
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка виклику методу <ОбъектДрайвера.ЗакрытьЧек>:" + Символы.ПС + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	// 5. ОБРАБОТКА РЕЗУЛЬТАТОВ И ФОРМИРОВАНИЕ ВЫХОДНЫХ ПАРАМЕТРОВ
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		// Проверка внутренней логической ошибки ПРРО, возвращенной сервером
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ТекстОшибки = СтруктураОтвета.message;
			ВыходныеПараметры.Очистить();
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка виклику методу <ОбъектДрайвера.ЗакрытьЧек>:" + Символы.ПС + ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
		// Извлечение фискальных данных созданного документа
		ФискальныйНомерЧека = "";
		НомерЧекаККМ = 0;
		НомерСменыККМ = 0;
		строкаURLЧека = "";
		СтруктураОтвета.Свойство("fiscal_code", ФискальныйНомерЧека);
		// Ссылка на онлайн-проверку чека в налоговой (ГНС)
		СтруктураОтвета.Свойство("qr_tax_url",  строкаURLЧека);
		СтруктураОтвета.Свойство("id",  НомерЧекаККМ);
        НомерФР = Параметры.ФискальныйНомерУстройства;
		Если СтруктураОтвета.Свойство("shift") И ТипЗнч(СтруктураОтвета.shift) = Тип("Структура") Тогда
			СтруктураОтвета.shift.Свойство("serial", НомерСменыККМ);
		КонецЕсли;
		// Наполнение массива ВыходныеПараметры по строгому требованию РМК Розницы
		ВыходныеПараметры = Новый Массив(3);
		ВыходныеПараметры[0] = НомерСменыККМ;
		ВыходныеПараметры[1] = НомерЧекаККМ;
		// Параметры закрытия чека и флаги управления печатью на Windows-принтер
		ПараметрыЗакрытия = Новый Структура;
		ПараметрыЗакрытия.Вставить("ФискальныйНомер", ФискальныйНомерЧека);
		ПараметрыЗакрытия.Вставить("НомерЧека",        НомерЧекаККМ);
		ДанныеПротокола = Новый Структура;
		ДанныеПротокола.Вставить("URL",        строкаURLЧека);
		ДанныеПротокола.Вставить("ОтветПРРО",  ОбъектДрайвера.Ответ);
		
		
		ОтветККМ		  = ОбъектДрайвера.Ответ;
		ТекстЗаголовка	  = "";
		URL				  = "";
		
		//2024-09-03 sa Запишем фискальный номер в базу
		// Собираем аргументы для функции ЗаписатьФискальныйНомер
		АргументыМетода = Новый Массив;
		АргументыМетода.Добавить(ФискальныйНомерЧека); 	
		АргументыМетода.Добавить(Параметры.ФискальныйНомерУстройства);		
		АргументыМетода.Добавить(ОтветККМ); 			
		АргументыМетода.Добавить(УИДЧека);        		
		ИмяНашейОбработки = "ОбщийМодуль.ПодключаемоеОборудованиеФискальныйРегистраторЧекбокс"; 
		
		ОтветШлюза = ОбщегоНазначенияВызовСервера.ВыполнитьМетодНаСервере(ИмяНашейОбработки, "ЗаписатьФискальныйНомер", АргументыМетода);
		
		Если ОтветШлюза.Успешно Тогда
			// Читаем то, что вернула сама функция ЗаписатьФискальныйНомер
			ОтветЧека = ОтветШлюза.РезультатМетода; 
			
			Если ОтветЧека = Неопределено Или Не ОтветЧека.Успешно Тогда
				ТекстОшибки = ?(ОтветЧека = Неопределено, "Невідома помилка бази.", ОтветЧека.ОписаниеОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Помилка запису фіскальних даних: " + ТекстОшибки);
			КонецЕсли;
		Иначе
			// Сюда попадаем, если произошла ошибка самого кода (например, синтаксический сбой)
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Критична помилка сервера RPC: " + ОтветШлюза.ОписаниеОшибки);
		КонецЕсли;
		
		
		АргументыМетода = Новый Массив;
		АргументыМетода.Добавить(ВходныеПараметры); 	
		АргументыМетода.Добавить(СтруктураОтвета); 	
		ИмяНашейОбработки = "ОбщийМодуль.ПодключаемоеОборудованиеФискальныйРегистраторЧекбокс"; 
		
		ОтветШлюза = ОбщегоНазначенияВызовСервера.ВыполнитьМетодНаСервере(ИмяНашейОбработки, "ПолучитьТабличныйДокументЧек", АргументыМетода);
		//ТабличныйДокумент = Вычислить("ПолучитьТабличныйДокументЧек(ВходныеПараметры,СтруктураОтвета)");
		Если ОтветШлюза.Успешно Тогда
			ТабличныйДокумент = ОтветШлюза.РезультатМетода;	
			ВывестиТабНаПечать(ТабличныйДокумент, ОбъектДрайвера, МассивОбщих, ВыходныеПараметры, "ПечатьЧека", Ложь);
			
			ПотокБуффер = Новый ПотокВПамяти;
			ТабличныйДокумент.Записать(ПотокБуффер, ТипФайлаТабличногоДокумента.PDF);

			ДанныеПротокола = УстановитьДанныеПротокола(
				  МассивОбщих[17][2]
				, строкаURLЧека
				, ПотокБуффер.ЗакрытьИПолучитьДвоичныеДанные()
				, СтруктураОтвета
			); 
			ФлагНапечатан = Истина;
		Иначе
			ДанныеПротокола = УстановитьДанныеПротокола(
				  МассивОбщих[17][2]
				, строкаURLЧека
				, ""
				, СтруктураОтвета
			); 
			//Формируем структуру сообщения для Журнала Регистрации
			СтруктураЛога = Новый Структура;
			СтруктураЛога.Вставить("ИмяСобытия",          "ФР Checkbox");
			СтруктураЛога.Вставить("ПредставлениеУровня", "Ошибка"); // Передаем строкой, процедура сама преобразует в тип УровеньЖурналаРегистрации
			СтруктураЛога.Вставить("Комментарий",         "Помилка формування складу друкарської форми:" + Символы.ПС + ОтветШлюза.ОписаниеОшибки);
			СтруктураЛога.Вставить("ДатаСобытия",         ТекущаяДата());
			
			//Упаковываем в СписокЗначений, как требует БСП-процедура
			СобытияДляЛога = Новый СписокЗначений;
			СобытияДляЛога.Добавить(СтруктураЛога);
			
			ОбщегоНазначенияВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СтруктураЛога);
			ФлагНапечатан = Ложь;
			ПоказатьОповещениеПользователя("Помилка формування складу друкарської форми:" + Символы.ПС + ОтветШлюза.ОписаниеОшибки,,,,,СтатусОповещенияПользователя.Важное);
		КонецЕсли;
		
		// Сырой JSON ответа сервиса
		ТребованиеБумажнойКопии = Ложь;
		ОбъектДрайвера.Параметры.Свойство("ТребованиеПечати", ТребованиеБумажнойКопии);
		ФлагиПечати = Новый Структура;
		ФлагиПечати.Вставить("Напечатан",         ФлагНапечатан);
		// БСП Розницы само отправит форму на принтер при необходимости
		ФлагиПечати.Вставить("ТребованиеПечати", ТребованиеБумажнойКопии = Истина);
		ФлагиПечати.Вставить("SMS",              Ложь);
		// Финальная сборка структуры протоколирования ПРРО
		ВыходныеПараметры[2] = Новый Структура("URL, ОтветПРРО, ПараметрыЗакрытия, ФлагиПечати", 
									ДанныеПротокола.URL, ДанныеПротокола.ОтветПРРО, ПараметрыЗакрытия, ФлагиПечати);
		Возврат Истина;
КонецФункции


// Функция осуществляет локальное аннулирование/отмену текущего открытого чека в РМК.
// Поскольку весь чек отправляется на сервер ПРРО одним пакетом в ПечатьЧека(),
// здесь выполняется очистка локального состояния драйвера и возврат успешного статуса БСП.
&НаКлиенте
Функция АннулироватьЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	
	// Очищаем данные ответов прошлых операций в объекте драйвера, если они были заполнены
	Если ТипЗнч(ОбъектДрайвера) = Тип("Структура") Тогда
		Если ОбъектДрайвера.Свойство("Ответ") Тогда
			ОбъектДрайвера.Вставить("Ответ", "");
		КонецЕсли;
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") Тогда
			ОбъектДрайвера.Вставить("СтруктураОтвета", Новый Структура);
		КонецЕсли;
	КонецЕсли;
	
	// Формируем успешный ответ для БСП Розницы 2.0
	ВыходныеПараметры.Добавить(0);
	ВыходныеПараметры.Добавить("Чек успішно анульовано локально.");
	
	Возврат Истина;
	
КонецФункции

// Дублирующий вызов для старых/альтернативных конфигураций, использующих команду "ОтменитьЧек"
&НаКлиенте
Функция ОтменитьЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	Возврат АннулироватьЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ОПЕРАЦИИ (ИНКАССАЦИЯ И НУЛЕВОЙ ЧЕК)

// Функция осуществляет служебное внесение или изъятие наличных денежных средств.
// В ПРРО Checkbox обе операции выполняются через роут /api/v1/receipt/service.
// Направление (внесение/выемка) определяется знаком переданной суммы.
&НаКлиенте
Функция Инкассация(ОбъектДрайвера, Параметры, ПараметрыПодключения, ТипИнкассации, Сумма, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	АдресРесурса = "receipt/service";
	
	// Анализируем тип операции из БСП:
	// Обычно ТипИнкассации: 0 - Выемка (изъятие), 1 - Внесение.
	// Сервер Checkbox принимает сумму CASH.value ВСЕГДА положительной, а тип операции
	// (внесение/выемка) ПРРО Kassa Manager автоматически определяет по знаку переданного числа.
	// Чтобы утилита Kassa Manager правильно считала выемку, число должно уйти отрицательным,
	// либо если КМ принимает по модулю, мы ориентируемся на логику знака старого драйвера:
	// Положительное число - внесение, отрицательное - изъятие.
	ЧистаяСумма = Сумма;
	Если ТипИнкассации = 0 Тогда // Выемка денежных средств
		ЧистаяСумма = -Abs(Сумма);
	Иначе // Внесение денежных средств
		ЧистаяСумма = Abs(Сумма);
	КонецЕсли;
	
	// Формируем структуру тела запроса (ServiceReceiptPayload)
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("payment", Новый Структура("type, value", "CASH", КопейкиИзСуммы(ЧистаяСумма)));
	
	СтрокаJSON = СтруктуруВТекстДЖСОН(ТелоЗапроса);
	Результат = ОтправитьДанные(ОбъектДрайвера, АдресРесурса, СтрокаJSON);
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		// Логическая ошибка от сервера Checkbox
		Если  СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка виконання службового чеку: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка виконання службового чеку: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		Если СтруктураОтвета.Свойство("files") И ТипЗнч(СтруктураОтвета.files)=Тип("Массив") И СтруктураОтвета.files.Количество()>0 Тогда
			ИмяФайлаСлужебнойВыемки = СтруктураОтвета.files[0].path;   
			ДанныеКартинки = Новый ДвоичныеДанные(ИмяФайлаСлужебнойВыемки);
			ТабДок = ОтобразитьКартинкуВТабДок(ДанныеКартинки, "інкасація/внесення ПРРО Checkbox"); 
			ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"інкасація/внесення ПРРО Checkbox",Ложь);
			
		Иначе
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка виконання службового чеку: повернуто структуру в невірному форматі");
			ПоказатьОповещениеПользователя("Помилка виконання службового чеку: повернуто структуру в невірному форматі",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Службовий чек виконано успішно.");
		ПоказатьОповещениеПользователя("Службовий чек виконано успішно",,,,СтатусОповещенияПользователя.Важное);
		Возврат Истина;
	Иначе
		ТекстОшибки = "Помилка зв'язку з касовим менеджером.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка інкасації/внесення: " + ТекстОшибки);
		ПоказатьОповещениеПользователя("Помилка інкасації/внесення: " + ТекстОшибки,,,,СтатусОповещенияПользователя.Важное);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Функция осуществляет печать нулевого (тестового) чека на ПРРО
&НаКлиенте
Функция НапечататьНулевойЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	АдресРесурса = "receipt/null/png";
	
	Результат = ОтправитьДанные(ОбъектДрайвера, АдресРесурса, "");
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		// Проверка бизнес-ошибки ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка друку нульового чека: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка друку нульового чека: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И НЕ ОбъектДрайвера.ЭтоДвоичныеДанные Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка друку нульового чека: немає даних для друку чека!");
			ПоказатьОповещениеПользователя("Помилка друку нульового чека: немає даних для друку чека!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ТабДок = ОтобразитьКартинкуВТабДок(ОбъектДрайвера.Ответ, "Нульовий чек ПРРО Checkbox"); 
		ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"Нульовий чек ПРРО Checkbox",Ложь);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Нульовий чек успішно надруковано."); 
		ПоказатьОповещениеПользователя("Нульовий чек успішно надруковано",,,,СтатусОповещенияПользователя.Информация);
		ОбъектДрайвера.Ответ = "";

		Возврат Истина;
	Иначе
		ТекстОшибки = "Помилка зв'язку з CheckBox.Manager.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка друку нульового чека: " + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

