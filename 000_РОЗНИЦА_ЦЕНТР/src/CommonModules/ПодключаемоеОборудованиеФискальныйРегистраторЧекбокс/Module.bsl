// СБОРКА ПЕЧАТНОЙ ФОРМЫ ЧЕКА

// Главная вызываемая функция оркестрации.
// Вызывается из ПечатьЧека(): ТабДок = ПолучитьTabличныйДокументЧек(ВходныеПараметры, СтруктураОтвета);
&НаСервере
Функция ПолучитьТабличныйДокументЧек(ВходныеПараметры, ОтветККМ) Экспорт
	
	// 1. Формируем стандартизированный массив шаблона на основе входных данных 1С
	ШаблонЧека = СформироватьШаблонЧека(ВходныеПараметры);
	
	// 2. Схлопываем данные 1С и плоский JSON-ответ Checkbox в единую структуру на русском языке
	СтруктураПараметров = СформироватьСтруктуруПараметровПечатнойФормы(ШаблонЧека, ОтветККМ); 
	
	// 3. Передаем готовую структуру в макет и получаем ТабличныйДокумент
	Возврат СформироватьПечатнуюФормуЧека(СтруктураПараметров);
	
КонецФункции

// Функция производит слияние данных 1С (из Шаблона) и фискального ответа Checkbox 
&НаСервере
Функция СформироватьСтруктуруПараметровПечатнойФормы(ШаблонЧека, ОтветККМ)
	
	Параметры1С = ШаблонЧека[0];
	Товары1С    = ШаблонЧека[1];
	Оплаты1С    = ШаблонЧека[2];
	СведенияОФР = ШаблонЧека[3];
	
	СтруктураПараметровПечатнойФормы = Новый Структура();
	
	// Базовые флаги и реквизиты операции
	ЭтоВозврат = (Параметры1С.ТипЧека = "ВОЗВРАТ");
	СтруктураПараметровПечатнойФормы.Вставить("ЭтоВозврат", ЭтоВозврат);
	
	ФискальныйКодЧека = "";
	ОтветККМ.Свойство("fiscal_code", ФискальныйКодЧека);
	СтруктураПараметровПечатнойФормы.Вставить("ФискальныйКодЧека", ФискальныйКодЧека);
	
	строкаURLЧека = "";
	ОтветККМ.Свойство("qr_tax_url", строкаURLЧека);
	СтруктураПараметровПечатнойФормы.Вставить("СсылкаНаСайтГНС", строкаURLЧека);
	
	СтруктураПараметровПечатнойФормы.Вставить("НомерКассира",                Параметры1С.НомерКассы);
	СтруктураПараметровПечатнойФормы.Вставить("ИмяКассира",                  Параметры1С.ИмяКассира);
	СтруктураПараметровПечатнойФормы.Вставить("ТекстПодвала",                Параметры1С.ТекстПодвала);
	СтруктураПараметровПечатнойФормы.Вставить("ПечатьПодвала",               ЗначениеЗаполнено(Параметры1С.ТекстПодвала));
	
	// Извлечение фискального номера ПРРО (fn) путем парсинга tax_url
	НомерФР = СведенияОФР.ФискальныйНомерУстройства;
	//Если ЗначениеЗаполнено(строкаURLЧека) Тогда
	//	НомерФР = Вычислить("ИзвлечьНомерФРИзСсылки(строкаURLЧека)");
	//КонецЕсли;
	СтруктураПараметровПечатнойФормы.Вставить("ФискальныйНомерПРРО",         НомерФР);
	СтруктураПараметровПечатнойФормы.Вставить("ДатаВремяФискализации",       ТекущаяДата());
	
	// Статические свойства ПРРО
	СтруктураПараметровПечатнойФормы.Вставить("НаименованиеОрганизации",     СведенияОФР.Организация);
	СтруктураПараметровПечатнойФормы.Вставить("АдресМагазина",               СведенияОФР.АдресМагазина); 
	СтруктураПараметровПечатнойФормы.Вставить("НаименованиеМагазина",        СведенияОФР.Магазин); 
	СтруктураПараметровПечатнойФормы.Вставить("КодЕГРПОУ",                   СведенияОФР.ЕДРПОУ);
	СтруктураПараметровПечатнойФормы.Вставить("ЦифроваяПодписьMAC",          ""); 
	СтруктураПараметровПечатнойФормы.Вставить("ПризнакОфлайн",               Не ОтветККМ.is_online); 
	СтруктураПараметровПечатнойФормы.Вставить("ПроизводительПРРО",           "Checkbox");

	// Итоги и Округления по фискальным данным Checkbox
	СуммаДокументаБезСкидок = ?(ОтветККМ.Свойство("total_sum"),     ОтветККМ.total_sum / 100,     Параметры1С.СуммаДокумента);
	СуммаДокументаКОплате   = ?(ОтветККМ.Свойство("total_payment"), ОтветККМ.total_payment / 100, Параметры1С.СуммаДокумента);
	СуммаОкругленияППРРО    = ?(ОтветККМ.Свойство("round_sum"),     ОтветККМ.round_sum / 100,     0);
	
	СтруктураПараметровПечатнойФормы.Вставить("СуммаДокументаБезСкидок", СуммаДокументаБезСкидок);
	СтруктураПараметровПечатнойФормы.Вставить("СуммаДокументаКОплате",   СуммаДокументаКОплате);
	СтруктураПараметровПечатнойФормы.Вставить("СуммаОкругления",         СуммаОкругленияППРРО);
	СтруктураПараметровПечатнойФормы.Вставить("ОбщаяСуммаСкидки",        Параметры1С.СуммаДокумента - СуммаДокументаКОплате);

	// 1. Формирование таблицы ТОВАРОВ
	ТаблицаТоваровПечать = Новый ТаблицаЗначений;
	ТаблицаТоваровПечать.Колонки.Добавить("Наименование");
	ТаблицаТоваровПечать.Колонки.Добавить("Количество");
	ТаблицаТоваровПечать.Колонки.Добавить("Цена");
	ТаблицаТоваровПечать.Колонки.Добавить("Сумма");
	ТаблицаТоваровПечать.Колонки.Добавить("КодУКТЗЕД");
	ТаблицаТоваровПечать.Колонки.Добавить("НалоговаяЛитера");
	ТаблицаТоваровПечать.Колонки.Добавить("СуммаСкидки");
	ТаблицаТоваровПечать.Колонки.Добавить("Комментарий");

	Если Товары1С <> Неопределено Тогда
		Для Каждого Товар1С Из Товары1С Цикл
			НоваяСтрока = ТаблицаТоваровПечать.Добавить();
			НоваяСтрока.Наименование    = Товар1С.Наименование;
			НоваяСтрока.Количество      = Товар1С.Количество;
			НоваяСтрока.Цена            = Товар1С.Цена;
			НоваяСтрока.Сумма           = Товар1С.Сумма;
			НоваяСтрока.КодУКТЗЕД       = Товар1С.КодПоУКТВЭД;
			НоваяСтрока.НалоговаяЛитера = Товар1С.СтавкаНДССтрокой;
			НоваяСтрока.СуммаСкидки     = Товар1С.СуммаСкидок;
			НоваяСтрока.Комментарий     = "";
		КонецЦикла;
	КонецЕсли;
	СтруктураПараметровПечатнойФормы.Вставить("Товары", ТаблицаТоваровПечать);

	// 2. Формирование таблицы ОПЛАТ
	ТаблицаОплатПечать = Новый ТаблицаЗначений;
	ТаблицаОплатПечать.Колонки.Добавить("ТипОплаты");
	ТаблицаОплатПечать.Колонки.Добавить("Сумма");
	ТаблицаОплатПечать.Колонки.Добавить("Сдача");
	ТаблицаОплатПечать.Колонки.Добавить("ПлатежнаяСистема");
	ТаблицаОплатПечать.Колонки.Добавить("ИдентификаторЭквайера");
	ТаблицаОплатПечать.Колонки.Добавить("ИдентификаторТерминала");
	ТаблицаОплатПечать.Колонки.Добавить("МаскаКарты");
	ТаблицаОплатПечать.Колонки.Добавить("НомерТранзакцииRRN");
	ТаблицаОплатПечать.Колонки.Добавить("КодАвторизации");
	ТаблицаОплатПечать.Колонки.Добавить("ДополнительнаяИнформация");

	СдачаОбщая = ?(ОтветККМ.Свойство("total_rest"), ОтветККМ.total_rest / 100, 0);

	Если Оплаты1С <> Неопределено Тогда
		Для Каждого Оплата1С Из Оплаты1С Цикл
			НоваяОплата = ТаблицаОплатПечать.Добавить();
			
			// Сопоставляем типы оплат из ШаблонаЧека
			ИмяТипа = ВРег(Оплата1С.Наименование);
			Если Найти(ИмяТипа, "НАЛИЧ") > 0 ИЛИ Найти(ИмяТипа, "ГОТІВК") > 0 Тогда
				НоваяОплата.ТипОплаты = 0;
				НоваяОплата.Сдача     = СдачаОбщая;
			ИначеЕсли Найти(ИмяТипа, "СЕРТИФИКАТ") > 0 Тогда
				НоваяОплата.ТипОплаты = 6;
			Иначе
				НоваяОплата.ТипОплаты = 1; // Карта/Безнал
			КонецЕсли;
			
			НоваяОплата.Сумма                  = Оплата1С.Сумма;
			НоваяОплата.ДополнительнаяИнформация = Оплата1С.Инфо;
			НоваяОплата.НомерТранзакцииRRN     = Оплата1С.НомерТранзакции;
			
			// Пытаемся распарсить Инфо на свойства эквайринга, если 1С хранит их склеенной строкой
			НоваяОплата.ПлатежнаяСистема       = ""; 
			НоваяОплата.ИдентификаторЭквайера  = ""; 
			НоваяОплата.ИдентификаторТерминала = ""; 
			НоваяОплата.МаскаКарты             = ""; 
			НоваяОплата.КодАвторизации         = "";
		КонецЦикла;
	КонецЕсли;
	СтруктураПараметровПечатнойФормы.Вставить("Оплаты", ТаблицаОплатПечать);

	// 3. Формирование таблицы НАЛОГОВ (из фискального JSON-ответа Local API Checkbox)
	ТаблицаНалоговПечать = Новый ТаблицаЗначений;
	ТаблицаНалоговПечать.Колонки.Добавить("НаименованиеНалога");
	ТаблицаНалоговПечать.Колонки.Добавить("ПроцентНалога");
	ТаблицаНалоговПечать.Колонки.Добавить("СуммаНалога");
	ТаблицаНалоговПечать.Колонки.Добавить("НаименованиеАкциза");
	ТаблицаНалоговПечать.Колонки.Добавить("ПроцентАкциза");
	ТаблицаНалоговПечать.Колонки.Добавить("СуммаАкциза");

	Если ОтветККМ.Свойство("taxes") И ТипЗнч(ОтветККМ.taxes) = Тип("Массив") Тогда
		Для Каждого НалогОтвета Из ОтветККМ.taxes Цикл
			НовыйНалог = ТаблицаНалоговПечать.Добавить();
			НовыйНалог.НаименованиеНалога = НалогОтвета.label;
			НовыйНалог.ПроцентНалога      = НалогОтвета.rate;
			НовыйНалог.СуммаНалога        = НалогОтвета.value / 100;
			
			Если НалогОтвета.Свойство("extra_value") И НалогОтвета.extra_value > 0 Тогда
				НовыйНалог.НаименованиеАкциза = "Акцизний податок";
				НовыйНалог.ПроцентАкциза      = НалогОтвета.extra_rate;
				НовыйНалог.СуммаАкциза        = НалогОтвета.extra_value / 100;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СтруктураПараметровПечатнойФормы.Вставить("Налоги", ТаблицаНалоговПечать);

	Возврат СтруктураПараметровПечатнойФормы;	
	
КонецФункции

// Функция генерирует ТабличныйДокумент на основе готового макета и СтруктурыПараметров.
// Содержимое полностью адаптировано под плоскую структуру параметров.
&НаСервере
Функция СформироватьПечатнуюФормуЧека(СтруктураПараметров)
	
	Макет = ПолучитьОбщийМакет("ПРРО_ШаблонЧекаDeviceManagerФискальныйРегистратор");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывод = ИспользованиеВывода.Разрешить;
	ТабличныйДокумент.ИмяПараметровПечати = "ПРРО_ПАРАМЕТРЫ_ПЕЧАТИ_ЧЕК_ПРИНТЕР";

	URL        = СтруктураПараметров.СсылкаНаСайтГНС;
	КодЧекаККМ = СтруктураПараметров.ФискальныйКодЧека;
	ЭтоВозврат = СтруктураПараметров.ЭтоВозврат;
	
	goods      = СтруктураПараметров.Товары;
	pays       = СтруктураПараметров.Оплаты;
	taxes      = СтруктураПараметров.Налоги;
	
	// Вывод Области Шапки чека
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.name       = СтруктураПараметров.НаименованиеОрганизации; 
	ОбластьМакета.Параметры.shopad     = СтруктураПараметров.АдресМагазина; 
	ОбластьМакета.Параметры.shopname   = СтруктураПараметров.НаименованиеМагазина; 
	ОбластьМакета.Параметры.vat_code   = СтруктураПараметров.КодЕГРПОУ; 
	ОбластьМакета.Параметры.fisid      = "";
	ОбластьМакета.Параметры.copy       = "";

	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Пробел");
	ТабличныйДокумент.Вывести(ОбластьМакета);		

	// Вывод Позиций Товаров (goods)
	Для каждого СтрокаТоваров Из goods Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Товар");
		ОбластьМакета.Параметры.cnt   = Формат(СтрокаТоваров.Количество, "ЧДЦ=3; ЧГ="); 
		ОбластьМакета.Параметры.price = Формат(СтрокаТоваров.Цена, "ЧДЦ=2; ЧГ=");  			
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		Если ЗначениеЗаполнено(СтрокаТоваров.КодУКТЗЕД) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("УКТЗЕД");
			ОбластьМакета.Параметры.code2 = СокрЛП(СтрокаТоваров.КодУКТЗЕД);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;

		ОбластьМакета = Макет.ПолучитьОбласть("ТоварИмя");
		ОбластьМакета.Параметры.name   = СтрокаТоваров.Наименование; 
		ОбластьМакета.Параметры.cost   = Формат(СтрокаТоваров.Сумма, "ЧДЦ=2; ЧГ=");  
		ОбластьМакета.Параметры.taxlit = СтрокаТоваров.НалоговаяЛитера; 
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		Если ЗначениеЗаполнено(СтрокаТоваров.СуммаСкидки) И СтрокаТоваров.СуммаСкидки <> 0 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Скидка");
			ОбластьМакета.Параметры.disc   = Формат(СтрокаТоваров.СуммаСкидки, "ЧДЦ=2; ЧГ="); 
			ОбластьМакета.Параметры.taxlit = СтрокаТоваров.НалоговаяЛитера; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.Комментарий) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Комментарий");
			ОбластьМакета.Параметры.comment = СтрокаТоваров.Комментарий; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
	КонецЦикла;

	// Вывод Способов Оплаты (pays)
	ВидОплатыУжеВыводилсяНаПечать = Ложь;
	СдачаПоЧеку = 0;
	
	Для каждого СтрокаОплат Из pays Цикл
		
		ТипОплаты = СтрокаОплат.ТипОплаты;
		
		// Информация о платежном средстве эквайринга (для безналичного расчета)
		Если ТипОплаты = 1 Тогда 
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, СтрокаОплат.ДополнительнаяИнформация, "", Истина);
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ІДЕНТ. ЕКВАЙРА",     СтрокаОплат.ИдентификаторЭквайера);
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ТЕРМІНАЛ",            СтрокаОплат.ИдентификаторТерминала);
		КонецЕсли;
		
		Если ВидОплатыУжеВыводилсяНаПечать = Ложь Тогда
			Если ЭтоВозврат Тогда
				ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ПОВЕРНЕННЯ", "", Истина);
			Else
				ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ПРОДАЖ", "", Истина);
			КонецЕсли;
			ВидОплатыУжеВыводилсяНаПечать = Истина;
		КонецЕсли;
		
		Если ТипОплаты = 1 Тогда
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ЕПЗ",              СтрокаОплат.МаскаКарты);
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "ПЛАТІЖНА СИСТЕМА", СтрокаОплат.ПлатежнаяСистема);
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "КОД АВТ.",         СтрокаОплат.КодАвторизации);
			ВывестиПараметрЧека(ТабличныйДокумент, Макет, "RRN",              СтрокаОплат.НомерТранзакцииRRN);
		КонецЕсли;
			
		Если ТипОплаты = 0 Тогда // Наличные
			ОбластьМакета = Макет.ПолучитьОбласть("Оплата");
			ОбластьМакета.Параметры.sum  = Формат(СтрокаОплат.Сумма, "ЧДЦ=2; ЧГ=") + " грн.";
			ОбластьМакета.Параметры.type = "ГОТІВКА"; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			СдачаПоЧеку = СдачаПоЧеку + СтрокаОплат.Сдача;
			
		ИначеЕсли ТипОплаты = 6 Тогда // Сертификат
			ОбластьМакета = Макет.ПолучитьОбласть("Оплата");
			ОбластьМакета.Параметры.sum  = Формат(СтрокаОплат.Сумма, "ЧДЦ=2; ЧГ=") + " грн.";
			ОбластьМакета.Параметры.type = "БЕЗГОТІВКОВА"; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ФормаОплаты");
			ОбластьМакета.Параметры.typen = "СЕРТИФІКАТ " + СтрокаОплат.ДополнительнаяИнформация; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Else // Карта / Безнал
			ОбластьМакета = Макет.ПолучитьОбласть("Оплата");
			ОбластьМакета.Параметры.sum  = Формат(СтрокаОплат.Сумма, "ЧДЦ=2; ЧГ=") + " грн.";
			ОбластьМакета.Параметры.type = "БЕЗГОТІВКОВА"; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ФормаОплаты");
			ОбластьМакета.Параметры.typen = "КАРТКА"; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
	КонецЦикла;
	
	// Вывод Итогов и Округления
	round = СтруктураПараметров.СуммаОкругления;
	Если НЕ round = 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Округления");
		ОбластьМакета.Параметры.round = Формат(round, "ЧДЦ=2; ЧГ=");  
		ТабличныйДокумент.Вывести(ОбластьМакета);	
	КонецЕсли;

	ОбластьМакета = Макет.ПолучитьОбласть("Итог");
	ОбластьМакета.Параметры.sum_topay = Формат(СтруктураПараметров.СуммаДокументаБезСкидок - СтруктураПараметров.ОбщаяСуммаСкидки, "ЧДЦ=2; ЧН=0,00; ЧГ=") + " грн.";  
	ТабличныйДокумент.Вывести(ОбластьМакета);	

	// Блок Налогов (taxes)
	Для каждого СтрокаНалогов Из taxes Цикл
		
		Если ЗначениеЗаполнено(СтрокаНалогов.СуммаНалога) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Налог");
			ОбластьМакета.Параметры.tax_percent = Формат(СтрокаНалогов.ПроцентНалога, "ЧДЦ=2; ЧГ=");  
			ОбластьМакета.Параметры.tax_name    = СтрокаНалогов.НаименованиеНалога; 
			ОбластьМакета.Параметры.tax_sum     = Формат(СтрокаНалогов.СуммаНалога, "ЧДЦ=2; ЧГ=");  
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаНалогов.СуммаАкциза) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Акциз");
			ОбластьМакета.Параметры.ex_percent = Формат(СтрокаНалогов.ПроцентАкциза, "ЧДЦ=2");  
			ОбластьМакета.Параметры.ex_name    = СтрокаНалогов.НаименованиеАкциза; 
			ОбластьМакета.Параметры.ex_sum     = Формат(СтрокаНалогов.СуммаАкциза, "ЧДЦ=2; ЧН=0,00; ЧГ=");  
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
	КонецЦикла;

	// К Оплате / Сдача
	ОбластьМакета = Макет.ПолучитьОбласть("КОплате");
	Если ЭтоВозврат Тогда
		ОбластьМакета.Параметры.ДоОплаты = "До повернення";
	Else    
		ОбластьМакета.Параметры.ДоОплаты = "До сплати";
	КонецЕсли;

	ОбластьМакета.Параметры.sum_topay = Формат(СтруктураПараметров.СуммаДокументаКОплате, "ЧДЦ=2; ЧГ=") + " грн."; 
	ТабличныйДокумент.Вывести(ОбластьМакета);   

	Если Не ЭтоВозврат Тогда
		ВывестиПараметрЧека(ТабличныйДокумент, Макет, "РЕШТА", "" + Формат(СдачаПоЧеку, "ЧДЦ=2; ЧН=0.00; ЧГ=") + " грн.");
	КонецЕсли;

	// Рекламный Подвал БСП
	Если СтруктураПараметров.ПечатьПодвала = Истина Тогда   
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалИнфо|Тело");
		ОбластьМакета.Параметры.ТекстПодвала = Символы.ПС + СокрЛП(СтруктураПараметров.ТекстПодвала);
		ТабличныйДокумент.Вывести(ОбластьМакета);  
	КонецЕсли;

	// Фискальный Штамп Даты и Номера документа
	ОбластьМакета = Макет.ПолучитьОбласть("ФНомер");
	ОбластьМакета.Параметры.fn = КодЧекаККМ; 
	ОбластьМакета.Параметры.dt = Формат(СтруктураПараметров.ДатаВремяФискализации, "ДФ='dd.MM.yyyy HH:mm:ss'"); 
	ТабличныйДокумент.Вывести(ОбластьМакета);  
	
	// Отрисовка QR-кода ДПС
	Если ЗначениеЗаполнено(URL) Тогда
		РазмерQRВПикселях = 250;
		ДанныеQRКода = ПолучитьQRкод(URL, 0, РазмерQRВПикселях);
		
		Область = Макет.ПолучитьОбласть("Картинка"); 
		Рисунок = Область.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка); 
		Рисунок.Верх = 0; Рисунок.Лево = 2; Рисунок.Высота = 19; Рисунок.Ширина = 19;         
		
		Рисунок.ГраницаСверху = Ложь; Рисунок.ГраницаСнизу = Ложь;
		Рисунок.ГраницаСлева  = Ложь; Рисунок.ГраницаСправа = Ложь;
		Рисунок.Картинка = Новый Картинка(ДанныеQRКода);
		
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ОтображатьСетку = Ложь;
		ТабличныйДокумент.Вывести(Область);
	Else
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Пробел"));     
	КонецЕсли;

	// Финальный фискальный подвал ПРРО
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал2");
	ОбластьМакета.Параметры.mac    = СтруктураПараметров.ЦифроваяПодписьMAC; 
	ОбластьМакета.Параметры.Онлайн = ?(НЕ СтруктураПараметров.ПризнакОфлайн, "Онлайн", "Офлайн");       
	ОбластьМакета.Параметры.fisid  = СтруктураПараметров.ФискальныйНомерПРРО;
	
	Если ЭтоВозврат Тогда
		ОбластьМакета.Параметры.Чек = "ВИДАТКОВИЙ ЧЕК";
	Else    
		ОбластьМакета.Параметры.Чек = "ФІСКАЛЬНИЙ ЧЕК";
	КонецЕсли;

	ОбластьМакета.Параметры.manuf = СтруктураПараметров.ПроизводительПРРО; 
	ТабличныйДокумент.Вывести(ОбластьМакета);   
	
	Возврат ТабличныйДокумент;

КонецФункции

&НаСервере
Процедура ВывестиПараметрЧека(ТабличныйДокумент,Макет,ИмяПараметра,ЗначениеПараметра = "",ПроверятьПараметр=Ложь)
	
	Если ПроверятьПараметр Тогда
		Если ЗначениеЗаполнено(ИмяПараметра) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Параметр");
			ОбластьМакета.Параметры.Параметр = ИмяПараметра;
			ОбластьМакета.Параметры.Значение = ЗначениеПараметра; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Параметр");
			ОбластьМакета.Параметры.Параметр = ИмяПараметра;
			ОбластьМакета.Параметры.Значение = ЗначениеПараметра; 
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьQRкод(QRСтрока, УровеньКоррекции, Размер) Экспорт

	ГенераторQRКода = ПолучитьГенераторQRкода();

	Если ГенераторQRКода = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		ДвоичныеДанныеКартинки = ГенераторQRКода.GenerateQRCode(QRСтрока, УровеньКоррекции, Размер);

	Исключение

		Сообщить(ОписаниеОшибки());

	КонецПопытки;

	Возврат ДвоичныеДанныеКартинки;
	
КонецФункции	


&НаСервере	
Функция ПолучитьГенераторQRкода() Экспорт

	ГенераторQRкода	= Неопределено;
	ИмяКомпоненты	= "QR" + СтрЗаменить(СокрЛП(Новый УникальныйИдентификатор), "-", "");	//	LNK 02.03.2024 15:35:22

	Попытка

		Если ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиQRКода", ИмяКомпоненты) Тогда	//	LNK 02.03.2024 15:35:32

				ГенераторQRкода = Новый("AddIn." + ИмяКомпоненты + ".QRCodeExtension");

		Иначе	Сообщить("Не вдалося підключити компонент генерації QR коду");		

		КонецЕсли;

	Исключение

		ТекстОшибки = ОписаниеОшибки();

	КонецПопытки;

	Возврат ГенераторQRкода;

КонецФункции	

