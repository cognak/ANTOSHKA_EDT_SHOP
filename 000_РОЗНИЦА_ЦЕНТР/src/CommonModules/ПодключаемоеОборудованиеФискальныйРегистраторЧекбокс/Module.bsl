// ФУНКЦИИ ПЕРИОДИЧЕСКИХ ОТЧЕТОВ И ОТЧЕТОВ ПО ТОВАРАМ

// Функция формирует и запрашивает периодический отчет из фискальной памяти по диапазону дат.
// Маршрут API: GET /api/v1/reports/periodical
&НаКлиенте
Функция НапечататьПериодическийОтчетПоДатам(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВходныеПараметры, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	
	// Извлекаем параметры БСП из входящего массива:
	// ВходныеПараметры[0] - НачалоПериода (Дата)
	// ВходныеПараметры[1] - КонецПериода (Дата)
	// ВходныеПараметры[2] - ВКраткомВиде (Булево)
	НачалоПериода = ВходныеПараметры[0];
	КонецПериода  = ВходныеПараметры[1];
	ВКраткомВиде  = ВходныеПараметры[2];
	
	// Форматируем даты под требования OpenAPI Checkbox: yyyy-MM-dd
	СтрокаНачало = Формат(НачалоПериода, "ДФ=yyyy-MM-dd");
	СтрокаКонец  = Формат(КонецПериода,  "ДФ=yyyy-MM-dd");
	//СтрокаКратко = ?(ВКраткомВиде, "true", "false");
	СтрокаКратко = "true";
	
	// Собираем эндпоинт с GET-параметрами
	АдресРесурса = "reports/periodical/png?from_date=" + СтрокаНачало + "T00:00:00&to_date=" + СтрокаКонец + "T23:59:59&is_short=" + СтрокаКратко;
	
	// Внимание: поскольку метод GET, вызываем встроенную функцию ПолучитьДанные()
	Результат = ПолучитьДанные(ОбъектДрайвера, АдресРесурса);
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		// Проверка бизнес-ошибки ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка періодичного звіту: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка періодичного звіту: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И НЕ ОбъектДрайвера.ЭтоДвоичныеДанные Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка періодичного звіту: немає даних для друку звіта!");
			ПоказатьОповещениеПользователя("Помилка періодичного звіту: немає даних для друку звіта!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ТабДок = ОтобразитьКартинкуВТабДок(ОбъектДрайвера.Ответ, "Періодичний звіт ПРРО Checkbox за "+СтрокаНачало+" по "+СтрокаКонец); 
		ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"Періодичний звіт ПРРО Checkbox за "+СтрокаНачало+" по "+СтрокаКонец,Ложь);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Періодичний звіт за датами успішно сформовано."); 
		ПоказатьОповещениеПользователя("Періодичний звіт за датами успішно сформовано",,,,СтатусОповещенияПользователя.Информация);
		ОбъектДрайвера.Ответ = "";
		Возврат Истина;
	Иначе
		ТекстОшибки = "Помилка зв'язку з касовим сервером.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка періодичного звіту: " + ТекстОшибки);
		ПоказатьОповещениеПользователя("Помилка періодичного звіту: " + ТекстОшибки,,,,СтатусОповещенияПользователя.Важное);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Функция запрашивает отчет по номерам Z-отчетов смен.
// Примечание: В REST API Checkbox нет прямого группового эндпоинта "за период номеров смен".
// Штатно диапазон транслируется в последовательный запрос конкретных Z-отчетов (GET /api/v1/reports/z_report/{id})
&НаКлиенте
Функция НапечататьПериодическийОтчетПоНомерам(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВходныеПараметры, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	
	// ВходныеПараметры[0] - НачальныйНомер (Число)
	// ВходныеПараметры[1] - КонечныйНомер (Число)
	// ВходныеПараметры[2] - ВКраткомВиде (Булево)
	НачальныйНомер = ВходныеПараметры[0];
	КонечныйНомер  = ВходныеПараметры[1];
	
	// Запрашиваем начальный Z-отчет из диапазона
	АдресРесурса = "reports/z_report/" + СокрЛП(Строка(НачальныйНомер)+"/png");
	Результат = ПолучитьДанные(ОбъектДрайвера, АдресРесурса);
	
	// Если номеров несколько, запрашиваем также и конечный отчет
	Если Результат И КонечныйНомер <> НачальныйНомер Тогда
		АдресРесурсаКонечный = "reports/z_report/" + СокрЛП(Строка(КонечныйНомер)+"/png");
		Результат = ПолучитьДанные(ОбъектДрайвера, АдресРесурсаКонечный);
	КонецЕсли;
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка звіту за номерами: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка періодичного звіту: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		Если Не ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И НЕ ОбъектДрайвера.ЭтоДвоичныеДанные Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка періодичного звіту: немає даних для друку звіта!");
			ПоказатьОповещениеПользователя("Помилка періодичного звіту: немає даних для друку звіта!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ТабДок = ОтобразитьКартинкуВТабДок(ОбъектДрайвера.Ответ, "Періодичний звіт ПРРО Checkbox по номеру зміни "+НачальныйНомер+" по "+КонечныйНомер); 
		ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"Періодичний звіт ПРРО Checkbox за "+НачальныйНомер+" по "+КонечныйНомер,Ложь);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Періодичний звіт за номерами смен успішно сформовано."); 
		ПоказатьОповещениеПользователя("Періодичний звіт за номерами смен успішно сформовано",,,,СтатусОповещенияПользователя.Информация);
		ОбъектДрайвера.Ответ = "";
		
		Возврат Истина;
	Иначе
		ТекстОшибки = "Помилка зв'язку з ПРРО.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка звіту за номерами: " + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Функция формирует аналитический отчет о проданных товарах за текущую смену.
// Маршрут API: GET /api/v1/reports/goods
&НаКлиенте
Функция НапечататьОтчетОПроданныхТоварах(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	
	// Эндпоинт Checkbox для получения оперативного отчета по товарам в рамках текущей сессии смены
	//АдресРесурса = "reports/goods";
	АдресРесурса = "shift/article-report/png";
	
	Результат = ОтправитьДанные(ОбъектДрайвера, АдресРесурса,"");
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		// Проверка бизнес-ошибки ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка звіту по товарах: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка звіту по товарах: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И НЕ ОбъектДрайвера.ЭтоДвоичныеДанные Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка звіту по товарах: немає даних для друку звіта!");
			ПоказатьОповещениеПользователя("Помилка звіту по товарах: немає даних для друку звіта!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ТабДок = ОтобразитьКартинкуВТабДок(ОбъектДрайвера.Ответ, "Звіт про продані товари"); 
		ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"Звіт про продані товари",Ложь);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Звіт про продані товари успішно сформовано."); 
		ПоказатьОповещениеПользователя("Звіт про продані товари успішно сформовано",,,,СтатусОповещенияПользователя.Информация);
		ОбъектДрайвера.Ответ = "";
		Возврат Истина;
	Иначе
		ТекстОшибки = "Не вдалося отримати звіт про продані товари.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка звіту по товарах: " + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТаблицуНалоговыхСтавок(ОбъектДрайвера,Параметры,ПараметрыПодключения,ВыходныеПараметры) Экспорт
	ВыходныеПараметры = Новый Массив;
	
	АдресРесурса = "kasa/taxes";
	
	Результат = ПолучитьДанные(ОбъектДрайвера, АдресРесурса);
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		// Проверка бизнес-ошибки ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка отримання налогових ставок: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка отримання налогових ставок: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		Если ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И ОбъектДрайвера.ЭтоДвоичныеДанные ИЛИ Не СтруктураОтвета.Свойство("taxes") Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка отримання налогових ставок: немає даних по налоговим ставкам!");
			ПоказатьОповещениеПользователя("Помилка отримання налогових ставок: немає даних по налоговим ставкам!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		МассивСтавок = Новый Массив;
		Для Каждого СтрокаСтавки Из СтруктураОтвета.taxes Цикл
			СтруктураСтавки = Новый Структура;
			СтруктураСтавки.Вставить("КодНалога"	,СтрокаСтавки.code);
			СтруктураСтавки.Вставить("Наименование"	,СтрокаСтавки.label);
			СтруктураСтавки.Вставить("Ставка"		,СтрокаСтавки.rate);
			СтруктураСтавки.Вставить("Акциз"		,СтрокаСтавки.extra_rate);

			МассивСтавок.Добавить(СтруктураСтавки);
		КонецЦикла;
		
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("");
		ВыходныеПараметры.Добавить(МассивСтавок);
		
		Возврат Истина;
	Иначе
		ТекстОшибки = "Не вдалося отримати звіт про продані товари.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка звіту по товарах: " + ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

