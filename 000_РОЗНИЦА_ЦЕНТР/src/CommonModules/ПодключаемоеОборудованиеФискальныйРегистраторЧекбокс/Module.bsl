Функция СтруктураВМассив(struct)

	Коллекция = Новый Соответствие;

	Для каждого kv Из struct Цикл

		Коллекция.Вставить(kv.key, kv.value);

	КонецЦикла;

	Возврат Коллекция;

КонецФункции

//2023-01-05 sa преобразование текста JSON в структуру 
Функция ТекстДЖСОНвСтруктуру(ТекстДЖСОН) 
	СтруктураОтвета = Новый Структура;
	Если ТекстДЖСОН = "" Тогда
		СтруктураОтвета.Вставить("Success",Ложь);
		СтруктураОтвета.Вставить("Description","Текст не в формате JSON (пустой)!");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	ФайлJSON = Новый ЧтениеJSON;
	ФайлJSON.УстановитьСтроку(ТекстДЖСОН);
	
	Попытка
		СтруктураОтвета = ПрочитатьJSON(ФайлJSON);
		ФайлJSON.Закрыть();
	Исключение
		СтруктураОтвета.Вставить("Success",Ложь);
		СтруктураОтвета.Вставить("Description","Текст не в формате JSON!"+Символы.ПС+ТекстДЖСОН);
	КонецПопытки;
	
	Возврат СтруктураОтвета;
КонецФункции

Функция СтруктуруВТекстДЖСОН(СтруктураПараметров) 
	
	ЗаписьДЖСОН = Новый ЗаписьJSON;
	ЗаписьДЖСОН.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьДЖСОН,СтруктураПараметров);
	ТекстДЖСОН = ЗаписьДЖСОН.Закрыть();
	
	Возврат ТекстДЖСОН;
КонецФункции

Функция ИнициализироватьУстройство(Параметры) Экспорт
	ОбъектДрайвера = Новый Структура(
		"Параметры, Драйвер, ОписаниеОшибки, ТекущееЗадание,Организация,ФискальныйНомерУстройства,Кассир,ЕДРПОУ"
		, Параметры
		, Неопределено
		, Новый ОписаниеТипов("Строка")
		, Неопределено
	);
	ОбъектДрайвера.Параметры = Параметры;
	
	Возврат ОбъектДрайвера;
КонецФункции     

// Функция осуществляет подключение устройства.
//
// Параметры:
//  ОбъектДрайвера   - <*>
//           - ОбъектДрайвера драйвера торгового оборудования.
//
// Возвращаемое значение:
//  <Булево> - Результат работы функции.
//
Функция ПодключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт

	Перем IP, ПортIP;

	Если НЕ ЗначениеЗаполнено(ОбъектДрайвера) ИЛИ ОбъектДрайвера.Параметры = Неопределено Тогда

		ОбъектДрайвера = ИнициализироватьУстройство(Параметры);	

	КонецЕсли;

	Результат = Истина;

	ОбъектДрайвера.Параметры.Свойство("АдресУстройства", IP);
	ОбъектДрайвера.Параметры.Свойство("ПортУстройства", ПортIP);

	Если ВыходныеПараметры = Неопределено Тогда
		ВыходныеПараметры = Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Функция осуществляет подключение устройства.
//
// Параметры:
//  ОбъектДрайвера   - <*>
//           - ОбъектДрайвера драйвера торгового оборудования.
//
// Возвращаемое значение:
//  <Булево> - Результат работы функции.
//
Функция ОтключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт


	Результат = Истина;


	Если ВыходныеПараметры = Неопределено Тогда
		ВыходныеПараметры = Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции


&НаКлиенте
Функция ОтправитьДанные(ОбъектДрайвера, АдресРесурса, ТекстЗапроса) Экспорт

  	Перем IP, ПортIP, resJsonString;
	  
	Если ОбъектДрайвера.Параметры = Неопределено Тогда
		СтруктураОтвета = Новый Структура("success, message", Ложь, nStr("ru = 'Не удалось установить соединение с CheckBox.Manager: не заданы параметры подключения'; en = 'Не вдалося встановити з''єднання з CheckBox.Manager: не встановлени параметри з''єднання'; uk = 'Cannot connect with CheckBox.Manager: parameters not found'"));
		connection = Неопределено;
		
		ОбъектДрайвера.Вставить("ОтветСервиса", ""); 
		ОбъектДрайвера.Вставить("СтруктураОтвета",СтруктураОтвета);
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		Возврат Ложь; 
	Иначе
		ОбъектДрайвера.Параметры.Свойство("АдресУстройства", IP);
		ОбъектДрайвера.Параметры.Свойство("ПортУстройства", ПортIP);
	КонецЕсли; 
	
	
	Если Лев(АдресРесурса,8) <> "/api/v1/" Тогда
		АдресРесурса = "/api/v1/"+АдресРесурса;	
	КонецЕсли;
	
	Попытка
		connection = new HTTPConnection(IP, ПортIP);
	Исключение
		СтруктураОтвета = Новый Структура("success, message", Ложь, "Не вдалося встановити з'єднання з CheckBox.Manager:"
			+ " " + ОписаниеОшибки());
		connection = Неопределено;

		ОбъектДрайвера.Вставить("ОтветСервиса", "");
		ОбъектДрайвера.Вставить("СтруктураОтвета",СтруктураОтвета);
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		
		Возврат Ложь;
	КонецПопытки;

	request = new HTTPRequest(АдресРесурса);
	request.headers.insert("Content-Type", "application/json");
	request.setBodyFromString(ТекстЗапроса); //, TextEncoding.UTF8, ByteOrderMarkUsage.DontUse);

	Попытка
		response = connection.POST(request);
		resJsonString = response.getBodyAsString();
		Если ЛЕВ(resJsonString,4)= "�PNG" Тогда
			//это бинарные данные
			ОбъектДрайвера.Вставить("ОтветСервиса", response.КодСостояния);
			ОбъектДрайвера.Вставить("Ответ", Base64Строка(response.ПолучитьТелоКакДвоичныеДанные()));
			ОбъектДрайвера.Вставить("СтруктураОтвета", Новый Структура);
			ОбъектДрайвера.Вставить("ЭтоДвоичныеДанные", Истина);
		Иначе
			ОбъектДрайвера.Вставить("ОтветСервиса", response.КодСостояния);
			ОбъектДрайвера.Вставить("Ответ", resJsonString);
			ОбъектДрайвера.Вставить("СтруктураОтвета", ТекстДЖСОНвСтруктуру(resJsonString));
			ОбъектДрайвера.Вставить("ЭтоДвоичныеДанные", Ложь);	
		КонецЕсли;
		Возврат Истина;
	Исключение
		СтруктураОтвета = Новый Структура("success, message", Ложь, "Помилка отримання відповіді від CheckBox.Manager:"
		+ " " + ОписаниеОшибки());

		connection = Неопределено;
		ОбъектДрайвера.Вставить("ОтветСервиса", "");
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		ОбъектДрайвера.Вставить("СтруктураОтвета",СтруктураОтвета);
		
		Возврат Ложь;
	КонецПопытки;
	Если ОбъектДрайвера.СтруктураОтвета = Неопределено Тогда
		ОбъектДрайвера.СтруктураОтвета = Новый Структура;
	КонецЕсли;

	
	Возврат Истина;

КонецФункции

Функция ПолучитьДанные(ОбъектДрайвера,АдресРесурса) Экспорт 

	Перем IP, ПортIP;
	
	Если ОбъектДрайвера.Параметры = Неопределено Тогда
		СтруктураОтвета = Новый Структура("success,messsage", Ложь, nStr("ru = 'Не удалось установить соединение с CheckBox.Manager: не заданы параметры подключения'; en = 'Не вдалося встановити з''єднання з CheckBox.Manager: не встановлени параметри з''єднання'; uk = 'Cannot connect with CheckBox.Manager: parameters not found'"));
		connection = Неопределено;
		
		ОбъектДрайвера.Вставить("ОтветСервиса", "");
		ОбъектДрайвера.Вставить("СтруктураОтвета", СтруктураОтвета);
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		Возврат Ложь; 
		
	КонецЕсли;
	ОбъектДрайвера.Параметры.Свойство("АдресУстройства", IP);
	ОбъектДрайвера.Параметры.Свойство("ПортУстройства", ПортIP);
	
	
	resData = Неопределено;
	reqJsonString = "";

	Если Лев(АдресРесурса,8) <> "/api/v1/" Тогда
		АдресРесурса = "/api/v1/"+АдресРесурса;	
	КонецЕсли;
	
	Попытка
		connection = new HTTPConnection(IP, ПортIP);
	Исключение
		СтруктураОтвета = Новый Структура("success,messsage", Ложь, nStr("ru = 'Не удалось установить соединение с CheckBox.Manager:'; en = 'Не вдалося встановити з''єднання з CheckBox.Manager:'; uk = 'Cannot connect with CheckBox.Manager:'")
		+ " " + ОписаниеОшибки());
		connection = Неопределено;
		
		ОбъектДрайвера.Вставить("ОтветСервиса", "");
		ОбъектДрайвера.Вставить("СтруктураОтвета", СтруктураОтвета);
		
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		Возврат Ложь; 
	КонецПопытки;
	
	request = new HTTPRequest(АдресРесурса);
	request.headers.insert("Content-Type", "application/json");
	
	Попытка
		//Сообщить(reqJsonString);
		response = connection.GET(request);
		resJsonString = response.getBodyAsString();
		Если ЛЕВ(resJsonString,4)= "�PNG" Тогда
			//это бинарные данные
			ОбъектДрайвера.Вставить("ОтветСервиса", resData);
			ОбъектДрайвера.Вставить("Ответ", Base64Строка(response.ПолучитьТелоКакДвоичныеДанные()));
			ОбъектДрайвера.Вставить("СтруктураОтвета", Новый Структура);
			ОбъектДрайвера.Вставить("ЭтоДвоичныеДанные", Истина);
		Иначе
			ОбъектДрайвера.Вставить("ОтветСервиса", resData);
			ОбъектДрайвера.Вставить("Ответ", resJsonString);
			ОбъектДрайвера.Вставить("СтруктураОтвета", ТекстДЖСОНвСтруктуру(resJsonString));
			ОбъектДрайвера.Вставить("ЭтоДвоичныеДанные", Ложь);	
		КонецЕсли;
		
		Результат =  Истина; 
	Исключение
		СтруктураОтвета = Новый Структура("success, message", Ложь, nStr("ru = 'Ошибка получения ответа от CheckBox.Manager:'; en = 'Помилка отримання відповіді від CheckBox.Manager:'; uk = 'Error getting response from CheckBox.Manager:'")
			+ " " + ОписаниеОшибки());
			connection = Неопределено;
		ОбъектДрайвера.Вставить("ОтветСервиса", "");
		ОбъектДрайвера.Вставить("СтруктураОтвета", СтруктураОтвета);
		ОбъектДрайвера.Вставить("Ответ", ОписаниеОшибки());
		Результат =  Ложь; 
	КонецПопытки;
	Если ОбъектДрайвера.СтруктураОтвета = Неопределено Тогда
		ОбъектДрайвера.СтруктураОтвета = Новый Структура;
	КонецЕсли;
	
	
	
	Возврат Результат;
КонецФункции

// Функция осуществляет тестирование устройства.
//
&НаКлиенте
Функция ТестУстройства(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	Если ОбъектДрайвера = Неопределено ИЛИ ОбъектДрайвера.Параметры = Неопределено Тогда
		ОбъектДрайвера = ИнициализироватьУстройство(Параметры);
	КонецЕсли;                                      
	
	АдресРесурса = "receipt/null";

	Результат  = ОтправитьДанные(ОбъектДрайвера,АдресРесурса,"");
	
	Если Результат Тогда
		ВыходныеПараметры = Новый Массив;
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Тест пристрою успішно");
	Иначе
		ВыходныеПараметры = Новый Массив;
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Помилка: Тест пристрою не успішно");
		ВыходныеПараметры.Добавить(ОбъектДрайвера.ОтветСервиса);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции 

Функция ПолучитьОписаниеДрайвера(ОбъектДрайвера,Параметры,ПараметрыПодключения,ВыходныеПараметры) Экспорт
	Если ОбъектДрайвера = Неопределено ИЛИ ОбъектДрайвера.Параметры = Неопределено Тогда
		ОбъектДрайвера = ИнициализироватьУстройство(Параметры);
	КонецЕсли;                                      
	
	АдресРесурса = "kasa/info";
	
	Результат = ПолучитьДанные(ОбъектДрайвера,АдресРесурса);
	
	ОписаниеДрайвера = Новый Структура;
	ОписаниеДрайвера.Вставить("Версия","");
	ОписаниеДрайвера.Вставить("Драйвер","не установлен");
	ОписаниеДрайвера.Вставить("Наименование","Checkbox");
	ОписаниеДрайвера.Вставить("Кассир","");
	ОписаниеДрайвера.Вставить("ДействителенДо","");
	ОписаниеДрайвера.Вставить("ФискальныйНомерУстройства","");
	ОписаниеДрайвера.Вставить("Налоговая","");
	ОписаниеДрайвера.Вставить("АдресНалоговой","");
	ОписаниеДрайвера.Вставить("Организация","");
	ОписаниеДрайвера.Вставить("ЕДРПОУ","");
	ОписаниеДрайвера.Вставить("НалоговыйНомер","");
	ОписаниеДрайвера.Вставить("ОписаниеОшибки","");
	
	ВыходныеПараметры = Новый Массив;
	Если Результат Тогда
		Попытка
			СтруктураОтвета = ОбъектДрайвера.СтруктураОтвета;
			//проверим, может есть какая-то ошибка, которую касса вернула в корректном виде
			Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
				ВыходныеПараметры.Добавить(999);
				ОписаниеДрайвера.Вставить("ОписаниеОшибки",СтруктураОтвета.message);
				//ВыходныеПараметры.Добавить(СтруктураОтвета.message);
				ОписаниеДрайвера.Вставить("Драйвер","Установлен");   //ответ же получен, значит все ок.
				ВыходныеПараметры.Добавить(ОписаниеДрайвера);
				Возврат Ложь;
			КонецЕсли;
			
			ОписаниеДрайвера.Вставить("Версия",			СтруктураОтвета.app_version);
			ОписаниеДрайвера.Вставить("Драйвер","установлен");
			ОписаниеДрайвера.Вставить("Наименование","ПРРО: Checkbox");
			ОписаниеДрайвера.Вставить("Кассир",			СтруктураОтвета.cashier.full_name);
			ОписаниеДрайвера.Вставить("ДействителенДо",	СтруктураОтвета.cashier.certificate_end);
			ОписаниеДрайвера.Вставить("ФискальныйНомерУстройства",СтруктураОтвета.cash_register.fiscal_number);
			ОписаниеДрайвера.Вставить("Налоговая",		СтруктураОтвета.branch.title);
			ОписаниеДрайвера.Вставить("АдресНалоговой",	СтруктураОтвета.branch.address);
			ОписаниеДрайвера.Вставить("Организация",	СтруктураОтвета.organization.title);
			ОписаниеДрайвера.Вставить("ЕДРПОУ",			СтруктураОтвета.organization.edrpou);
			ОписаниеДрайвера.Вставить("НалоговыйНомер",	СтруктураОтвета.organization.tax_number);
			ОписаниеДрайвера.Вставить("ПодпискаДо",		СтруктураОтвета.organization.subscription_exp);

			ВыходныеПараметры.Добавить(0);
			ВыходныеПараметры.Добавить(ОписаниеДрайвера);
		Исключение
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	Иначе
		ВыходныеПараметры.Добавить(999);
		Если ОбъектДрайвера.ОтветСервиса.Свойство("errortxt") Тогда
			ВыходныеПараметры.Добавить(ОбъектДрайвера.ОтветСервиса.errortxt);
		Иначе
			ВыходныеПараметры.Добавить("Неизвестная ошибка в модуле ПодключаемоеОборудованиеФискальныйРегистраторЧекбокс");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПолучитьВерсиюДрайвера(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры)
	Возврат ПолучитьОписаниеДрайвера(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры); 

