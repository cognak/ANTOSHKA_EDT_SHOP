// Принимает строку PNG в формате Base64 и формирует ТабличныйДокумент с картинкой.
// Подходит для отображения графических отчетов (X/Z-отчеты) и нулевых чеков Checkbox.
//
// Параметры:
//  ДанныеBase64   - Строка. Картинка PNG, закодированная в Base64 (возвращается API Checkbox).
//  ЗаголовокЧека  - Строка. Текст, который будет отображаться в заголовке окна (например, "Х-Звіт ПРРО").
//
// Возвращаемое значение:
//  ТабличныйДокумент - Готовый объект для вывода на экран (.Показать()) или печати (.Напечатать()).
//
&НаКлиенте
Функция ОтобразитьКартинкуВТабДок(Знач ДанныеBase64, Знач ЗаголовокЧека = "Звіт ПРРО Checkbox") Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПРРО_ПАРАМЕТРЫ_ПЕЧАТИ_ГРАФИКА";
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	
	// Автомасштаб под ширину страницы чекового принтера
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Попытка
		Если ТипЗнч(ДанныеBase64) = Тип("Строка") Тогда
			// Декодируем Base64-строку в бинарные данные картинки 1С напрямую на клиенте
			КартинкаДанные = Base64Значение(ДанныеBase64); 
		Иначе //считаем что это двоичные данные
			КартинкаДанные = ДанныеBase64;
		КонецЕсли;
		
		ОбъектКартинка = Новый Картинка(КартинкаДанные);
		
		// Задаем базовые геометрические параметры сетки для чековой ленты
		ШиринаКолонки = 9;
		ВысотаСтроки  = 12;
		
		// Коэффициенты пересчета пикселей PNG в единицы сетки 1С
		ПиксельНаЕдиницуШирины = 6.9;
		ПиксельНаЕдиницуВысоты = 1.25;
		
		// Размеры по умолчанию (на случай, если не удастся прочитать размеры картинки)
		КолонокНужно = 14;
		СтрокНужно   = 120;
		
		Попытка
			// Динамически рассчитываем, сколько строк и колонок займет чековая лента-картинка
			КолонокНужно = Цел(ОбъектКартинка.Ширина() / (ПиксельНаЕдиницуШирины * ШиринаКолонки)) + 1;
			СтрокНужно   = Цел(ОбъектКартинка.Высота() / (ПиксельНаЕдиницуВысоты * ВысотаСтроки))  + 1;
		Исключение
			// Оставляем дефолтные размеры, если у платформы нет доступа к свойствам файла
		КонецПопытки;
		
		// Выделяем область в табдоке под картинку (отступаем по 2 ячейки сверху и слева для красоты)
		ОбластьДляРисунка = ТабличныйДокумент.Область(1, 1, 1 + СтрокНужно, 1 + КолонокНужно);
		ОбластьДляРисунка.ШиринаКолонки = ШиринаКолонки;
		ОбластьДляРисунка.ВысотаСтроки  = ВысотаСтроки;
		
		ОбластьДляРисунка.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Лево;
		ОбластьДляРисунка.ВертикальноеПоложениеКартинки   = ВертикальноеПоложение.Верх;
		
		// Добавляем графический объект на созданную область табличного документа
		Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		Рисунок.Картинка      = ОбъектКартинка;
		Рисунок.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
		Рисунок.Линия          = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		
		// Позиционируем картинку внутри области
		Рисунок.Расположить(ОбластьДляРисунка);
		
	Исключение
		// Обработка ситуации, когда Checkbox вернул некорректные бинарные данные
		ОбластьТекста = ТабличныйДокумент.Область(2, 2, 4, 15);
		ОбластьТекста.Текст = "Помилка завантаження графічного представлення чека/звіту ПРРО!" 
			+ Символы.ПС + ОписаниеОшибки();
		ОбластьТекста.ЦветТекста = WebЦвета.Красный;
	КонецПопытки;
	
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти
