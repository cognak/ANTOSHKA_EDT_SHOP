// ОСНОВНЫЕ ФУНКЦИИ УПРАВЛЕНИЯ ПРРО (СМЕНЫ И ОТЧЕТЫ)

// Функция осуществляет открытие смены на ПРРО
&НаКлиенте
Функция ОткрытьСмену(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	АдресРесурса = "shift/open";
	
	Результат = ОтправитьДанные(ОбъектДрайвера, АдресРесурса, "");
	
	Если Результат Тогда
		// Проверяем код ответа сервиса (200/201 - успешный HTTP-статус)
		КодСостояния = 0;
		ОбъектДрайвера.Параметры.Свойство("ОтветСервиса", КодСостояния);
		
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		
		// Обработка логических ошибок, возвращенных в теле ответа ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка відкриття зміни ПРРО: " + СтруктураОтвета.message);
			Возврат Ложь;
		КонецЕсли;
		
		НомерСмены = 0;
		Если СтруктураОтвета.Свойство("shift") И ТипЗнч(СтруктураОтвета.shift) = Тип("Структура") Тогда
			СтруктураОтвета.shift.Свойство("z_report_id", НомерСмены);
		КонецЕсли;
		
		ВыходныеПараметры.Добавить(НомерСмены);
		ВыходныеПараметры.Добавить("Зміна успішно відкрита.");
		ПоказатьОповещениеПользователя("Касову зміну відкрито",,,,СтатусОповещенияПользователя.Информация);
		Возврат Истина;
	Иначе
		 ТекстОшибки = "Невідома помилка при зверненні до сервісу.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		 
		 ВыходныеПараметры.Добавить(999);
		 ВыходныеПараметры.Добавить("Помилка при відкритті зміни: " + ТекстОшибки);
		 Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Функция осуществляет получение X-отчета (без гашения)

&НаКлиенте
Функция НапечататьОтчетБезГашения(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Массив;
	АдресРесурса = "shift/xreport/png";
	
	Результат = ОтправитьДанные(ОбъектДрайвера, АдресРесурса, "");
	
	Если Результат Тогда
		СтруктураОтвета = ?(ОбъектДрайвера.Свойство("СтруктураОтвета"), ОбъектДрайвера.СтруктураОтвета, Новый Структура);
		// Проверка бизнес-ошибки ПРРО
		Если СтруктураОтвета.Свойство("message") И ЗначениеЗаполнено(СтруктураОтвета.message) Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка виконання Х-звіту: " + СтруктураОтвета.message);
			ПоказатьОповещениеПользователя("Помилка виконання Х-звіту: " + СтруктураОтвета.message,,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ОбъектДрайвера.Свойство("ЭтоДвоичныеДанные") И НЕ ОбъектДрайвера.ЭтоДвоичныеДанные Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Помилка виконання Х-звіту: немає даних для друку звіта!");
			ПоказатьОповещениеПользователя("Помилка виконання Х-звіту: немає даних для друку звіта!",,,,СтатусОповещенияПользователя.Важное);
			Возврат Ложь;
		КонецЕсли;
		
		ТабДок = ОтобразитьКартинкуВТабДок(ОбъектДрайвера.Ответ, "Х-звіт ПРРО Checkbox"); 
		ВывестиТабНаПечать(ТабДок,ОбъектДрайвера,,,"Х-звіт ПРРО Checkbox",Ложь);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить("Х-звіт успішно виконано"); 
		ПоказатьОповещениеПользователя("Х-звіт успішно виконано",,,,СтатусОповещенияПользователя.Информация);
		ОбъектДрайвера.Ответ = "";

		Возврат Истина;
	Иначе
		 ТекстОшибки = "Невідома помилка.";
		Если ОбъектДрайвера.Свойство("СтруктураОтвета") И ТипЗнч(ОбъектДрайвера.СтруктураОтвета) = Тип("Структура") Тогда
			ОбъектДрайвера.СтруктураОтвета.Свойство("message", ТекстОшибки);
		КонецЕсли;
		 
		 ВыходныеПараметры.Добавить(999);
		 ВыходныеПараметры.Добавить("Помилка виконання Х-звіту: " + ТекстОшибки);
		 Возврат Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция осуществляет получение Z-отчета (с закрытием смены)
&НаКлиенте
Функция НапечататьОтчетСГашением(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
