
Функция ПолучитьТочкуВхода() Экспорт

	WSURLВебСервиса = "https://api.novaposhta.ua/v2.0/xml/";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыСоединения.ServerAddress
		|ИЗ
		|	РегистрСведений.ПараметрыСоединения КАК ПараметрыСоединения
		|ГДЕ
		|	ПараметрыСоединения.Источник = ЗНАЧЕНИЕ(Перечисление.ВнешниеИсточники.НоваяПочта)
		|	И ПараметрыСоединения.Активен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ServerAddress) Тогда
			WSURLВебСервиса = Выборка.ServerAddress;
		КонецЕсли;
	КонецЦикла;
	
	Возврат  WSURLВебСервиса;
	
КонецФункции


Функция ПолучитьКлючAPI() Экспорт
	
	APIКлюч = "";

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыСоединения.Токен
		|ИЗ
		|	РегистрСведений.ПараметрыСоединения КАК ПараметрыСоединения
		|ГДЕ
		|	ПараметрыСоединения.Источник = ЗНАЧЕНИЕ(Перечисление.ВнешниеИсточники.НоваяПочта)
		|	И ПараметрыСоединения.Активен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Токен) Тогда
			APIКлюч = ВыборкаДетальныеЗаписи.Токен;
		КонецЕсли;
	КонецЦикла;

	Возврат  APIКлюч;
	
КонецФункции



//2026-11-16 sa Маркетинг просит чтобы по ЗД у которых существует удаленная ЭН и не существует другой ЭН, приходило оповещение на почту
Процедура ПоискУдаленныхЭлектронныхНакладных(НачПериода=Неопределено,КонПериода=Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(НачПериода) Тогда
		НачПериода = ДобавитьМесяц(ТекущаяДата(),-1);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КонПериода) Тогда
		КонПериода = КонецДня(ТекущаяДата())-86400; //на вчерашний день. чтобы не попадали в отчет сегодняшние удаления по которым не успели  отработать менеджеры
	КонецЕсли;                                                                                                                                                   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектроннаяНакладная.ДокументОснование КАК ДокументОснование,
	               |	ЭлектроннаяНакладная.Ссылка КАК Ссылка,
	               |	ЭлектроннаяНакладная.Номер КАК Номер,
	               |	ЭлектроннаяНакладная.ДатаДоставки КАК ДатаДоставки,
	               |	ЭлектроннаяНакладная.ЗаказПокупателя КАК ЗаказПокупателя,
	               |	ЭлектроннаяНакладная.ИмяПолучатель КАК ИмяПолучатель,
	               |	ЭлектроннаяНакладная.ДокументОснование.СтатусЗапроса КАК СтатусЗапроса,
	               |	ЭлектроннаяНакладная.ДокументОснование.СтатусОплаты КАК СтатусОплаты,
	               |	СтатусыЭНСрезПоследних.СтатусЭН КАК СтатусЭН,
	               |	СтатусыЭНСрезПоследних.Период КАК ДатаСтатусаЭН
	               |ПОМЕСТИТЬ ПравильныеЭН
	               |ИЗ
	               |	РегистрСведений.СтатусыЭН.СрезПоследних КАК СтатусыЭНСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяНакладная КАК ЭлектроннаяНакладная
	               |		ПО СтатусыЭНСрезПоследних.ДокументРегистратор = ЭлектроннаяНакладная.Ссылка
	               |ГДЕ
	               |	ЭлектроннаяНакладная.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ЭлектроннаяНакладная.ДокументОснование.СтатусЗапроса = ЗНАЧЕНИЕ(Перечисление.СтатусыЗапросовДоступностиТоваровШапка.Отправлен)
	               |	И СтатусыЭНСрезПоследних.СтатусЭН.Код <> ""2""
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭлектроннаяНакладная.ДокументОснование КАК ДокументОснование,
	               |	ЭлектроннаяНакладная.Ссылка КАК Ссылка,
	               |	ЭлектроннаяНакладная.Номер КАК Номер,
	               |	ЭлектроннаяНакладная.ДатаДоставки КАК ДатаДоставки,
	               |	ЭлектроннаяНакладная.ЗаказПокупателя КАК ЗаказПокупателя,
	               |	ЭлектроннаяНакладная.ИмяПолучатель КАК ИмяПолучатель,
	               |	ЭлектроннаяНакладная.ДокументОснование.СтатусЗапроса КАК СтатусЗапроса,
	               |	ЭлектроннаяНакладная.ДокументОснование.СтатусОплаты КАК СтатусОплаты,
	               |	СтатусыЭНСрезПоследних.СтатусЭН КАК СтатусЭН,
	               |	СтатусыЭНСрезПоследних.Период КАК ДатаСтатусаЭН
	               |ИЗ
	               |	РегистрСведений.СтатусыЭН.СрезПоследних КАК СтатусыЭНСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяНакладная КАК ЭлектроннаяНакладная
	               |		ПО СтатусыЭНСрезПоследних.ДокументРегистратор = ЭлектроннаяНакладная.Ссылка
	               |ГДЕ
	               |	ЭлектроннаяНакладная.Дата МЕЖДУ &НачалоПериода И &КонецПериода
				   |	И ЭлектроннаяНакладная.ДокументОснование.СтатусЗапроса = ЗНАЧЕНИЕ(Перечисление.СтатусыЗапросовДоступностиТоваровШапка.Отправлен)
	               |	И СтатусыЭНСрезПоследних.СтатусЭН.Код = ""2""
	               |	И НЕ ЭлектроннаяНакладная.ДокументОснование В
	               |				(ВЫБРАТЬ
	               |					Т.ДокументОснование
	               |				ИЗ
	               |					ПравильныеЭН КАК Т)";

	Запрос.УстановитьПараметр("НачалоПериода", НачПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонПериода);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПараметров = Новый Структура("ДокументОснование,Ссылка,Номер,ДатаДоставки,ЗаказПокупателя,ИмяПолучатель,СтатусЭН,ДатаСтатусаЭН");
		ЗаполнитьЗначенияСвойств(СтруктураПараметров,Выборка);
		ОтправитьУведомлениеПоУдаленнымЭН(СтруктураПараметров);
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьУведомлениеПоУдаленнымЭН(СтруктураПараметров)
	УчетныеДанныеОтправителя = РаботаСПочтовымиСообщениями.ПолучитьСистемнуюУчетнуюЗапись();
	
	Если УчетныеДанныеОтправителя.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация") Тогда
    	Возврат;
	КонецЕсли;
	Если Не СтруктураПараметров.Свойство("Адрес") Тогда
		СтруктураПараметров.Вставить("Адрес", "kateryna.khomenko@antoshka.ua");
	КонецЕсли;
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", СтруктураПараметров.Адрес);
	ПараметрыПисьма.Вставить("Тема", "Видалена ЕН по запиту доступності: "+СтруктураПараметров.ДокументОснование);
	ТелоПисьма = "Шановний панове(пані)!"+Символы.ПС+"Це автоматичний лист. Прохання не відповідати на нього."+Символы.ПС
		+Символы.ПС+Символы.ПС
		+"Додаткова інформація:"+Символы.ПС
		+"Інтернет замовлення №: "+СтруктураПараметров.ЗаказПокупателя+Символы.ПС
		+"Електронна накладна №: "+СтруктураПараметров.Ссылка+Символы.ПС
		+"Отримувач: "+СтруктураПараметров.ИмяПолучатель+Символы.ПС
		+"Статус ЕН: "+СтруктураПараметров.СтатусЭН+Символы.ПС
		+"Дата статуса ЕН: "+СтруктураПараметров.ДатаСтатусаЭН+Символы.ПС
		+"Посилання на інтернет замовлення: e1c://server/192.168.9.67/retail_work_00#"+ПолучитьНавигационнуюСсылку(СтруктураПараметров.ЗаказПокупателя)+Символы.ПС		
		;
	ПараметрыПисьма.Вставить("Тело", ТелоПисьма);

	ЭлектроннаяПочта.ОтправитьПочтовоеСообщение(УчетныеДанныеОтправителя, ПараметрыПисьма);
		
КонецПроцедуры

